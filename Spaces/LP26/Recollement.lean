import Spaces.LP26.NonVacuity
import Spaces.Stacks.Bridges
import WeakApprox.Recollement
import Mathlib.CategoryTheory.Triangulated.Adjunction
import Mathlib.CategoryTheory.Adjunction.Triple

/-!
# The open–closed recollement of `D_{qc,W}(X)` over an algebraic space (GL26 Lemma A.4)

Guisado Villalgordo–Lank, *Relative Fourier–Mukai theory for algebraic spaces* (GL26),
**Lemma A.4** (`lem:spacey_recollement`): for `X` a quasi-compact quasi-separated algebraic
space, `j : U ⟶ X` a quasi-compact open immersion, `Z = |X| ∖ |U|` and `W ⊆ |X|` closed with
quasi-compact complement, there is a recollement
`D_{qc,|U| ∩ W}(U) → D_{qc,W}(X) → D_{qc,W ∩ Z}(X)` in which `Rj_*` and the natural inclusion
`i_*` are the middle functors and `Lj^*` is the left adjoint of `Rj_*`.  AxiomMath has neither
this recollement nor the right adjoints `j^!_W`, `i^!`, `i^*`; they are constructed here.

## Main results

* `RecollementOfAdjoints.Data.toRecollement` (no geometry): six exact functors in two adjoint
  triples `i^* ⊣ i_* ⊣ i^!`, `j_! ⊣ j^* ⊣ j_*`, with `i_*`, `j_!` fully faithful and
  `ker i^* = ess. im. j_!`, form a recollement (`RelativeWeakApprox.Recollement`): the two gluing
  triangles are constructed, with natural connecting maps (`exists_distinguished`,
  `exists_natural_connecting`), and `j_*` is fully faithful by `Adjunction.Triple`.
* `lemma_A_4`: **GL26 Lemma A.4**, the recollement with supports (the first claim of the lemma is
  the case `W = |X|`).
* `pushFullyFaithful`: `Rj_*` is fully faithful on `D(𝒪_U)` for an open immersion `j`.
* `lemma_A_4_nonVacuity`: every hypothesis of `lemma_A_4` holds for `X` affine, `j = 𝟙_X`,
  `W = |X|`.

## Rendering

* `D_{qc,T}(X)` is `Supported.DqcZ X T` (AxiomMath's `D_{QCoh,T}(𝒪_X)`); `|U| ∩ W` is
  `|j|⁻¹ W ⊆ |U|`, `Z` is `(Set.range |j|)ᶜ`; `Rj_*`, `Lj^*` are `Spaces.push j`, `Spaces.pull j`
  restricted (`pushZ`, `pullZ`), and `i_*` is the inclusion `inclZ`.
* A recollement is `RelativeWeakApprox.Recollement` (LP26 Setup 4.1).  Its `D_Z` is the
  `D_{qc,|j|⁻¹ W}(U)` of GL26's diagram and its `D_U` is `D_{qc,W ∩ Z}(X)`: GL26 draws the
  recollement with `Rj_*` and `i_*` in the opposite positions, and LP26's proof of Proposition 5.8
  uses exactly this assignment (`i^* = Lj^*`, `i_* = Rj_*`, `i^! = j^!_W`; `j_! = i_*`,
  `j^* = i^!`, `j_* = i^*`).
* "Compactly generated" and "preserves small coproducts" are for `Type u`-indexed direct sums,
  the sums of AxiomMath's model of `D(𝒪_X)` (morphisms in `Type (u + 1)`).

## Proof

`Lj^* ⊣ Rj_*` restricts to `D_{qc,W}(X)` and `D_{qc,|j|⁻¹ W}(U)` (Stacks 08F4, 08FA (1), 08GF,
0AFJ).  `Rj_*` is fully faithful: the counit of `(-)|_U ⊣ Rj_*` is invertible
(`OpenImmersionCounitInput`).  The kernel of `Lj^*` on `D_{qc,W}(X)` is `D_{qc,W ∩ Z}(X)`
(Stacks 08GF, 04K5, through `Lj^* ≅ (-)|_U`).  The three right adjoints `j^!_W`, `i^!`, `i^*` are
obtained from Brown representability (Stacks 0A8G), as GL26 obtains `j^!_W` (from
Balmer–Dell'Ambrogio–Sanders, Corollary 2.3): the three categories are compactly generated by a
perfect object (Stacks 0AEC, 0AED; `Supported.lemma_A_9_generator`) and locally `u`-small
(Stacks 079Q); `Rj_*` and `i^!` preserve direct sums because their left adjoints `Lj^*` and `i_*`
preserve the compactness of a generator (Stacks 08H6, 0AED; the formal step of Stacks 08DZ), and
the inclusion does because both supports are closed under direct sums.  GL26 obtains `i^!` and
`i^*` from the localization sequence instead (Gao–Psaroudakis, Lemma 2.2); right adjoints are
unique up to isomorphism.  The triangles are then those of `Data.toRecollement`.

## Assumptions

The tagged AxiomMath inputs `Spaces.Tag08FAInput`, `Spaces.Tag08F4Input`, and those of
`Spaces/LP26/Inputs.lean` and `Spaces/Supported/Inputs.lean` named in the hypotheses of
`lemma_A_4`; nothing else.  The two `Prop` instances that make the categories triangulated
(`(qcohDerived X).IsTriangulated`, `ObjectProperty.IsTriangulated (CohomologySupportedOn …)`) are
instance arguments, as in `Spaces/Supported/CompactGeneration.lean`; `lemma_A_4_nonVacuity`
produces them from 06UQ and `SupportTriangulatedInput`.
-/

noncomputable section

open CategoryTheory CategoryTheory.Limits CategoryTheory.Pretriangulated
open AlgebraicGeometry AlgebraicGeometry.Space RelativeWeakApprox

namespace RelativeFM.Spaces.LP26.RecollementOfAdjoints

section Connecting

variable {C₁ C₂ D : Type*} [Category* C₁] [Category* C₂] [Category* D]
  {F₁ : C₁ ⥤ D} {G₁ : D ⥤ C₁} (adj₁ : F₁ ⊣ G₁)
  {G₂ : D ⥤ C₂} {F₂ : C₂ ⥤ D} (adj₂ : G₂ ⊣ F₂)

include adj₂ in
/-- Maps out of `F₂ G₂ X` into the image of `F₂` are determined by their composite with the
unit. -/
lemma unit_cancel [F₂.Full] {X : D} {Z : C₂} {c c' : F₂.obj (G₂.obj X) ⟶ F₂.obj Z}
    (h : adj₂.unit.app X ≫ c = adj₂.unit.app X ≫ c') : c = c' := by
  obtain ⟨g, rfl⟩ := F₂.map_surjective c
  obtain ⟨g', rfl⟩ := F₂.map_surjective c'
  have h' : adj₂.homEquiv _ _ g = adj₂.homEquiv _ _ g' := by
    rw [Adjunction.homEquiv_unit, Adjunction.homEquiv_unit]; exact h
  rw [(adj₂.homEquiv _ _).injective h']

include adj₁ in
/-- Maps from the image of `F₁` into `F₁ G₁ Y` are determined by their composite with the
counit. -/
lemma counit_cancel [F₁.Full] {Y : D} {N : C₁} {a a' : F₁.obj N ⟶ F₁.obj (G₁.obj Y)}
    (h : a ≫ adj₁.counit.app Y = a' ≫ adj₁.counit.app Y) : a = a' := by
  obtain ⟨g, rfl⟩ := F₁.map_surjective a
  obtain ⟨g', rfl⟩ := F₁.map_surjective a'
  have h' : (adj₁.homEquiv _ _).symm g = (adj₁.homEquiv _ _).symm g' := by
    rw [Adjunction.homEquiv_counit, Adjunction.homEquiv_counit]; exact h
  rw [(adj₁.homEquiv _ _).symm.injective h']

variable [Preadditive D] [HasZeroObject D] [HasShift D ℤ]
  [∀ (n : ℤ), (shiftFunctor D n).Additive] [Pretriangulated D]

include adj₁ adj₂ in
/-- **The gluing triangle with the counit and the unit.**  If `F₁` is fully faithful, maps
from the image of `F₁` to the shifts of the image of `F₂` vanish, and the unit
`X ⟶ F₂ G₂ X` sits in a distinguished triangle `K ⟶ X ⟶ F₂ G₂ X ⟶ K[1]` with `K` in the
essential image of `F₁`, then `F₁ G₁ X ⟶ X ⟶ F₂ G₂ X ⟶ (F₁ G₁ X)[1]`, with the counit and the
unit as its first two maps, is distinguished for a suitable third map. -/
lemma exists_distinguished [F₁.Full] (horth : ∀ (N : C₁) (Z : C₂) (n : ℤ)
      (f : F₁.obj N ⟶ (F₂.obj Z)⟦n⟧), f = 0)
    (X : D) (K : D) (u : K ⟶ X) (w : F₂.obj (G₂.obj X) ⟶ K⟦(1 : ℤ)⟧)
    (hT : Triangle.mk u (adj₂.unit.app X) w ∈ distTriang D) (N : C₁) (e : K ≅ F₁.obj N) :
    ∃ δ : F₂.obj (G₂.obj X) ⟶ (F₁.obj (G₁.obj X))⟦(1 : ℤ)⟧,
      Triangle.mk (adj₁.counit.app X) (adj₂.unit.app X) δ ∈ distTriang D := by
  have horthK : ∀ (Z : C₂) (n : ℤ) (f : K ⟶ (F₂.obj Z)⟦n⟧), f = 0 := fun Z n f => by
    rw [← cancel_epi e.inv, horth N Z n (e.inv ≫ f), comp_zero]
  have hεη : adj₁.counit.app X ≫ adj₂.unit.app X = 0 := by
    have h := horth (G₁.obj X) (G₂.obj X) 0
      ((adj₁.counit.app X ≫ adj₂.unit.app X) ≫ (shiftFunctorZero D ℤ).inv.app _)
    rw [← cancel_mono ((shiftFunctorZero D ℤ).inv.app _), h, zero_comp]
  obtain ⟨φ, hφ⟩ : ∃ φ : F₁.obj (G₁.obj X) ⟶ K, adj₁.counit.app X = φ ≫ u :=
    Triangle.coyoneda_exact₂ _ hT (adj₁.counit.app X) hεη
  let ψ : K ⟶ F₁.obj (G₁.obj X) := e.hom ≫ F₁.map (adj₁.homEquiv _ _ (e.inv ≫ u))
  have hψ : ψ ≫ adj₁.counit.app X = u := by
    simp [ψ, Adjunction.homEquiv_unit]
  have h₁ : φ ≫ ψ = 𝟙 _ := by
    apply counit_cancel adj₁
    rw [Category.assoc, hψ]
    simpa using hφ.symm
  have h₂ : ψ ≫ φ = 𝟙 _ := by
    rw [← sub_eq_zero]
    have hz : (ψ ≫ φ - 𝟙 K) ≫ u = 0 := by
      rw [Preadditive.sub_comp, Category.assoc, ← hφ, hψ, Category.id_comp, sub_self]
    obtain ⟨g, hg⟩ := Triangle.coyoneda_exact₂ _ (inv_rot_of_distTriang _ hT) _ hz
    have hg0 : g = 0 := horthK _ _ g
    rw [hg, hg0, zero_comp]
    rfl
  refine ⟨w ≫ ψ⟦(1 : ℤ)⟧', isomorphic_distinguished _ hT _ ?_⟩
  refine Triangle.isoMk _ _ ⟨φ, ψ, h₁, h₂⟩ (Iso.refl _) (Iso.refl _) ?_ ?_ ?_
  · simp [hφ]
  · simp
  · dsimp
    rw [Category.id_comp, Category.assoc, ← Functor.map_comp, h₂, CategoryTheory.Functor.map_id,
      Category.comp_id]

include adj₁ adj₂ in
/-- **Natural connecting maps.**  If, for every `X`, the triangle with the counit
`F₁ G₁ X ⟶ X` and the unit `X ⟶ F₂ G₂ X` can be completed to a distinguished triangle, and
both `F₁` and `F₂` are fully faithful, then the third maps can be chosen naturally in `X`. -/
lemma exists_natural_connecting [F₂.Full]
    (h : ∀ X : D, ∃ δ : F₂.obj (G₂.obj X) ⟶ (F₁.obj (G₁.obj X))⟦(1 : ℤ)⟧,
      Triangle.mk (adj₁.counit.app X) (adj₂.unit.app X) δ ∈ distTriang D) :
    ∃ δ : G₂ ⋙ F₂ ⟶ G₁ ⋙ F₁ ⋙ shiftFunctor D (1 : ℤ), ∀ X : D,
      Triangle.mk (adj₁.counit.app X) (adj₂.unit.app X) (δ.app X) ∈ distTriang D := by
  choose δ hδ using h
  refine ⟨{ app := δ, naturality := fun X Y f => ?_ }, hδ⟩
  obtain ⟨c, hc₁, hc₂⟩ := complete_distinguished_triangle_morphism _ _ (hδ X) (hδ Y)
    (F₁.map (G₁.map f)) f (adj₁.counit.naturality f).symm
  have hc : c = F₂.map (G₂.map f) := unit_cancel adj₂ (by
    dsimp at hc₁ ⊢
    rw [hc₁]
    exact (adj₂.unit.naturality f))
  subst hc
  exact hc₂.symm

end Connecting

section Construction

universe vZ uZ vD uD vU uU

variable {DZ : Type uZ} {D : Type uD} {DU : Type uU}
  [Category.{vZ} DZ] [Category.{vD} D] [Category.{vU} DU]
  [Preadditive DZ] [Preadditive D] [Preadditive DU]
  [HasZeroObject DZ] [HasZeroObject D] [HasZeroObject DU]
  [HasShift DZ ℤ] [HasShift D ℤ] [HasShift DU ℤ]
  [∀ (n : ℤ), (shiftFunctor DZ n).Additive]
  [∀ (n : ℤ), (shiftFunctor D n).Additive]
  [∀ (n : ℤ), (shiftFunctor DU n).Additive]
  [Pretriangulated DZ] [Pretriangulated D] [Pretriangulated DU]

variable (DZ D DU) in
/-- **The data of a recollement, without its triangles.**  Six exact functors in two adjoint
triples `i^* ⊣ i_* ⊣ i^!` and `j_! ⊣ j^* ⊣ j_*`, with `i_*` and `j_!` fully faithful, such that
the kernel of `i^*` is the essential image of `j_!`.  This is the shape in which a recollement
arises from a Verdier localization sequence with adjoints on both sides
(Krause, *Localization theory for triangulated categories*, §4; Gao–Psaroudakis, Lemma 2.2;
GL26, proof of Lemma A.4).  `Data.toRecollement` constructs the two gluing triangles, their
natural connecting maps and the remaining conditions of `RelativeWeakApprox.Recollement`. -/
structure Data where
  /-- `i^*` -/
  iStar : D ⥤ DZ
  /-- `i_*` -/
  iLower : DZ ⥤ D
  /-- `i^!` -/
  iShriek : D ⥤ DZ
  /-- `j_!` -/
  jShriek : DU ⥤ D
  /-- `j^*` -/
  jStar : D ⥤ DU
  /-- `j_*` -/
  jUpper : DU ⥤ D
  [iStar_commShift : iStar.CommShift ℤ]
  [iLower_commShift : iLower.CommShift ℤ]
  [iShriek_commShift : iShriek.CommShift ℤ]
  [jShriek_commShift : jShriek.CommShift ℤ]
  [jStar_commShift : jStar.CommShift ℤ]
  [jUpper_commShift : jUpper.CommShift ℤ]
  [iStar_exact : iStar.IsTriangulated]
  [iLower_exact : iLower.IsTriangulated]
  [iShriek_exact : iShriek.IsTriangulated]
  [jShriek_exact : jShriek.IsTriangulated]
  [jStar_exact : jStar.IsTriangulated]
  [jUpper_exact : jUpper.IsTriangulated]
  /-- `i^* ⊣ i_*` -/
  iStarAdj : iStar ⊣ iLower
  /-- `i_* ⊣ i^!` -/
  iLowerAdj : iLower ⊣ iShriek
  /-- `j_! ⊣ j^*` -/
  jShriekAdj : jShriek ⊣ jStar
  /-- `j^* ⊣ j_*` -/
  jStarAdj : jStar ⊣ jUpper
  [iLower_full : iLower.Full]
  [iLower_faithful : iLower.Faithful]
  [jShriek_full : jShriek.Full]
  [jShriek_faithful : jShriek.Faithful]
  /-- The kernel of `i^*` lies in the essential image of `j_!`. -/
  mem_essImage_of_isZero (X : D) : IsZero (iStar.obj X) → ∃ Y : DU, Nonempty (X ≅ jShriek.obj Y)
  /-- `i^* j_! = 0` on objects. -/
  isZero_iStar_jShriek (Y : DU) : IsZero (iStar.obj (jShriek.obj Y))

attribute [instance] Data.iStar_commShift Data.iLower_commShift Data.iShriek_commShift
  Data.jShriek_commShift Data.jStar_commShift Data.jUpper_commShift Data.iStar_exact
  Data.iLower_exact Data.iShriek_exact Data.jShriek_exact Data.jStar_exact Data.jUpper_exact
  Data.iLower_full Data.iLower_faithful Data.jShriek_full Data.jShriek_faithful

namespace Data

variable (R : Data DZ D DU)

/-- Maps from the image of `j_!` to the image of `i_*` vanish. -/
lemma hom_jShriek_iLower {N : DU} {Z : DZ} (f : R.jShriek.obj N ⟶ R.iLower.obj Z) : f = 0 := by
  have h : (R.iStarAdj.homEquiv _ _).symm f = 0 := (R.isZero_iStar_jShriek N).eq_of_src _ _
  rw [← (R.iStarAdj.homEquiv _ _).apply_symm_apply f, h, Adjunction.homEquiv_unit,
    Functor.map_zero, comp_zero]

/-- Maps from the image of `j_!` to the shifts of the image of `i_*` vanish. -/
lemma hom_jShriek_iLower_shift (N : DU) (Z : DZ) (n : ℤ)
    (f : R.jShriek.obj N ⟶ (R.iLower.obj Z)⟦n⟧) : f = 0 := by
  rw [← cancel_mono ((R.iLower.commShiftIso n).inv.app Z), zero_comp]
  exact R.hom_jShriek_iLower _

/-- `j^* i_* = 0` on objects. -/
lemma isZero_jStar_iLower (Z : DZ) : IsZero (R.jStar.obj (R.iLower.obj Z)) := by
  rw [IsZero.iff_id_eq_zero]
  have h : (R.jShriekAdj.homEquiv _ _).symm (𝟙 (R.jStar.obj (R.iLower.obj Z))) = 0 :=
    R.hom_jShriek_iLower _
  rw [← (R.jShriekAdj.homEquiv _ _).apply_symm_apply (𝟙 _), h, Adjunction.homEquiv_unit,
    Functor.map_zero, comp_zero]

/-- `j_*` is fully faithful (adjoint triple `j_! ⊣ j^* ⊣ j_*` with `j_!` fully faithful). -/
def jUpperFullyFaithful : R.jUpper.FullyFaithful :=
  (Adjunction.Triple.mk R.jShriekAdj R.jStarAdj).fullyFaithfulEquiv
    (Functor.FullyFaithful.ofFullyFaithful R.jShriek)

instance : R.jUpper.Full := R.jUpperFullyFaithful.full

instance : R.jUpper.Faithful := R.jUpperFullyFaithful.faithful

/-- Maps from the image of `i_*` to the image of `j_*` vanish. -/
lemma hom_iLower_jUpper {Z : DZ} {M : DU} (f : R.iLower.obj Z ⟶ R.jUpper.obj M) : f = 0 := by
  have h : (R.jStarAdj.homEquiv _ _).symm f = 0 := (R.isZero_jStar_iLower Z).eq_of_src _ _
  rw [← (R.jStarAdj.homEquiv _ _).apply_symm_apply f, h, Adjunction.homEquiv_unit,
    Functor.map_zero, comp_zero]

/-- Maps from the image of `i_*` to the shifts of the image of `j_*` vanish. -/
lemma hom_iLower_jUpper_shift (Z : DZ) (M : DU) (n : ℤ)
    (f : R.iLower.obj Z ⟶ (R.jUpper.obj M)⟦n⟧) : f = 0 := by
  rw [← cancel_mono ((R.jUpper.commShiftIso n).inv.app M), zero_comp]
  exact R.hom_iLower_jUpper _

/-- `i^! j_* = 0` on objects. -/
lemma isZero_iShriek_jUpper (M : DU) : IsZero (R.iShriek.obj (R.jUpper.obj M)) := by
  rw [IsZero.iff_id_eq_zero]
  have h : (R.iLowerAdj.homEquiv _ _).symm (𝟙 (R.iShriek.obj (R.jUpper.obj M))) = 0 :=
    R.hom_iLower_jUpper _
  rw [← (R.iLowerAdj.homEquiv _ _).apply_symm_apply (𝟙 _), h, Adjunction.homEquiv_unit,
    Functor.map_zero, comp_zero]

/-- `i^*` inverts the unit of `i^* ⊣ i_*` (`i_*` fully faithful). -/
lemma isIso_iStar_map_unit (X : D) : IsIso (R.iStar.map (R.iStarAdj.unit.app X)) := by
  have h := R.iStarAdj.left_triangle_components X
  have : IsIso (R.iStar.map (R.iStarAdj.unit.app X) ≫
      R.iStarAdj.counit.app (R.iStar.obj X)) := by rw [h]; exact IsIso.id _
  exact IsIso.of_isIso_comp_right _ (R.iStarAdj.counit.app (R.iStar.obj X))

/-- `j^*` inverts the unit of `j^* ⊣ j_*` (`j_*` fully faithful). -/
lemma isIso_jStar_map_unit (X : D) : IsIso (R.jStar.map (R.jStarAdj.unit.app X)) := by
  have h := R.jStarAdj.left_triangle_components X
  have : IsIso (R.jStar.map (R.jStarAdj.unit.app X) ≫
      R.jStarAdj.counit.app (R.jStar.obj X)) := by rw [h]; exact IsIso.id _
  exact IsIso.of_isIso_comp_right _ (R.jStarAdj.counit.app (R.jStar.obj X))

/-- The first gluing triangle `j_! j^* X ⟶ X ⟶ i_* i^* X ⟶ (j_! j^* X)[1]` exists. -/
lemma exists_first (X : D) :
    ∃ δ : R.iLower.obj (R.iStar.obj X) ⟶ (R.jShriek.obj (R.jStar.obj X))⟦(1 : ℤ)⟧,
      Triangle.mk (R.jShriekAdj.counit.app X) (R.iStarAdj.unit.app X) δ ∈ distTriang D := by
  obtain ⟨K, u, w, hT⟩ := distinguished_cocone_triangle₁ (R.iStarAdj.unit.app X)
  have hK : IsZero (R.iStar.obj K) := by
    have := R.isIso_iStar_map_unit X
    exact Triangle.isZero₁_of_isIso₂ _ (R.iStar.map_distinguished _ hT) (by
      dsimp; infer_instance)
  obtain ⟨N, ⟨e⟩⟩ := R.mem_essImage_of_isZero K hK
  exact exists_distinguished R.jShriekAdj R.iStarAdj R.hom_jShriek_iLower_shift X K u w hT N e

/-- The natural connecting map of the first gluing triangle. -/
def firstConnecting : R.iStar ⋙ R.iLower ⟶ R.jStar ⋙ R.jShriek ⋙ shiftFunctor D (1 : ℤ) :=
  (exists_natural_connecting R.jShriekAdj R.iStarAdj R.exists_first).choose

lemma first_distinguished (X : D) :
    Triangle.mk (R.jShriekAdj.counit.app X) (R.iStarAdj.unit.app X)
      (R.firstConnecting.app X) ∈ distTriang D :=
  (exists_natural_connecting R.jShriekAdj R.iStarAdj R.exists_first).choose_spec X

/-- An object killed by `j^*` is in the essential image of `i_*`: the unit `X ⟶ i_* i^* X` is an
isomorphism. -/
lemma isIso_iStarAdj_unit_of_isZero {X : D} (hX : IsZero (R.jStar.obj X)) :
    IsIso (R.iStarAdj.unit.app X) :=
  (Triangle.isZero₁_iff_isIso₂ _ (R.first_distinguished X)).1 (R.jShriek.map_isZero hX)

/-- The second gluing triangle `i_* i^! X ⟶ X ⟶ j_* j^* X ⟶ (i_* i^! X)[1]` exists. -/
lemma exists_second (X : D) :
    ∃ δ : R.jUpper.obj (R.jStar.obj X) ⟶ (R.iLower.obj (R.iShriek.obj X))⟦(1 : ℤ)⟧,
      Triangle.mk (R.iLowerAdj.counit.app X) (R.jStarAdj.unit.app X) δ ∈ distTriang D := by
  obtain ⟨K, u, w, hT⟩ := distinguished_cocone_triangle₁ (R.jStarAdj.unit.app X)
  have hK : IsZero (R.jStar.obj K) := by
    have := R.isIso_jStar_map_unit X
    exact Triangle.isZero₁_of_isIso₂ _ (R.jStar.map_distinguished _ hT) (by
      dsimp; infer_instance)
  have := R.isIso_iStarAdj_unit_of_isZero hK
  exact exists_distinguished R.iLowerAdj R.jStarAdj R.hom_iLower_jUpper_shift X K u w hT _
    (asIso (R.iStarAdj.unit.app K))

/-- The natural connecting map of the second gluing triangle. -/
def secondConnecting : R.jStar ⋙ R.jUpper ⟶ R.iShriek ⋙ R.iLower ⋙ shiftFunctor D (1 : ℤ) :=
  (exists_natural_connecting R.iLowerAdj R.jStarAdj R.exists_second).choose

lemma second_distinguished (X : D) :
    Triangle.mk (R.iLowerAdj.counit.app X) (R.jStarAdj.unit.app X)
      (R.secondConnecting.app X) ∈ distTriang D :=
  (exists_natural_connecting R.iLowerAdj R.jStarAdj R.exists_second).choose_spec X

/-- **The recollement** of `Data`: the six functors and four adjunctions of `R`, the two gluing
triangles with natural connecting maps, the kernel condition and the three vanishing composites,
all constructed from the fields of `R`. -/
def toRecollement [CategoryTheory.IsTriangulated DZ] [CategoryTheory.IsTriangulated D]
    [CategoryTheory.IsTriangulated DU] : Recollement DZ D DU where
  iStar := R.iStar
  iLower := R.iLower
  iShriek := R.iShriek
  jShriek := R.jShriek
  jStar := R.jStar
  jUpper := R.jUpper
  iStarAdj := R.iStarAdj
  iLowerAdj := R.iLowerAdj
  jShriekAdj := R.jShriekAdj
  jStarAdj := R.jStarAdj
  kernel X := by
    constructor
    · rintro ⟨e⟩
      have := R.isIso_iStarAdj_unit_of_isZero (IsZero.of_iso (isZero_zero _) e)
      exact ⟨_, ⟨asIso (R.iStarAdj.unit.app X)⟩⟩
    · rintro ⟨Y, ⟨e⟩⟩
      exact ⟨((R.isZero_jStar_iLower Y).of_iso (R.jStar.mapIso e)).isoZero⟩
  jStar_iLower := (Functor.isZero _ fun Z => R.isZero_jStar_iLower Z).isoZero
  iShriek_jUpper := (Functor.isZero _ fun M => R.isZero_iShriek_jUpper M).isoZero
  iStar_jShriek := (Functor.isZero _ fun Y => R.isZero_iStar_jShriek Y).isoZero
  firstConnecting := R.firstConnecting
  secondConnecting := R.secondConnecting
  first_distinguished := R.first_distinguished
  second_distinguished := R.second_distinguished

end Data

end Construction

end RelativeFM.Spaces.LP26.RecollementOfAdjoints

