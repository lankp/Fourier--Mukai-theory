/-! ### Restricting functors to `D_{qc,T}` -/

section Lift

variable {Y X : AlgebraicSpaces B S hS} [(qcohDerived Y).IsTriangulated]
  [(qcohDerived X).IsTriangulated] {T₁ : Set (points B S hS Y.1)} {T₂ : Set (points B S hS X.1)}
  [ObjectProperty.IsTriangulated (CohomologySupportedOn B S hS Y.1 Y.2 T₁)]
  [ObjectProperty.IsTriangulated (CohomologySupportedOn B S hS X.1 X.2 T₂)]

/-- The restriction `D_{qc,T₁}(Y) ⥤ D_{qc,T₂}(X)` of a functor `F : D(𝒪_Y) ⥤ D(𝒪_X)` which sends
`D_{qc,T₁}(Y)` into `D_{qc,T₂}(X)`. -/
def liftZ (F : DerivedCategory (Modules.{u, u} B S hS Y.1 Y.2) ⥤
      DerivedCategory (Modules.{u, u} B S hS X.1 X.2))
    (h₁ : ∀ E : DqcZ Y T₁, qcohDerived X (F.obj ((ιZ Y T₁).obj E)))
    (h₂ : ∀ E : DqcZ Y T₁, CohomologySupportedOn B S hS X.1 X.2 T₂ (F.obj ((ιZ Y T₁).obj E))) :
    DqcZ Y T₁ ⥤ DqcZ X T₂ :=
  (qcSupportedOn X T₂).lift ((qcohDerived X).lift (ιZ Y T₁ ⋙ F) h₁) h₂

section

variable (F : DerivedCategory (Modules.{u, u} B S hS Y.1 Y.2) ⥤
      DerivedCategory (Modules.{u, u} B S hS X.1 X.2))
    (h₁ : ∀ E : DqcZ Y T₁, qcohDerived X (F.obj ((ιZ Y T₁).obj E)))
    (h₂ : ∀ E : DqcZ Y T₁, CohomologySupportedOn B S hS X.1 X.2 T₂ (F.obj ((ιZ Y T₁).obj E)))

/-- The restriction commutes with shifts (Mathlib's `ObjectProperty.commShiftLift`, twice). -/
instance liftZ_commShift [hF : F.CommShift ℤ] : (liftZ F h₁ h₂).CommShift ℤ :=
  ObjectProperty.commShiftLift _ _ _

/-- The restriction of an exact functor is exact (Mathlib's `ObjectProperty.isTriangulated_lift`,
twice). -/
instance liftZ_isTriangulated [hF : F.CommShift ℤ] [hF' : F.IsTriangulated] :
    (liftZ F h₁ h₂).IsTriangulated :=
  letI : ((qcohDerived X).lift (ιZ Y T₁ ⋙ F) h₁).IsTriangulated :=
    ObjectProperty.isTriangulated_lift _ _ _
  ObjectProperty.isTriangulated_lift _ _ _

end

/-- The restriction followed by the inclusion is `F` on `D_{qc,T₁}(Y)`. -/
def liftZCompιZ (F : DerivedCategory (Modules.{u, u} B S hS Y.1 Y.2) ⥤
      DerivedCategory (Modules.{u, u} B S hS X.1 X.2))
    (h₁ : ∀ E : DqcZ Y T₁, qcohDerived X (F.obj ((ιZ Y T₁).obj E)))
    (h₂ : ∀ E : DqcZ Y T₁, CohomologySupportedOn B S hS X.1 X.2 T₂ (F.obj ((ιZ Y T₁).obj E))) :
    liftZ F h₁ h₂ ⋙ ιZ X T₂ ≅ ιZ Y T₁ ⋙ F :=
  Iso.refl _

end Lift

/-! ### The six functors of the open–closed recollement -/

section Instances

variable {U X : AlgebraicSpaces B S hS} (j : U ⟶ X)

/-- `Lj^*` commutes with shifts (AxiomMath's instance, in the spelling `D(𝒪) = DerivedCategory
(Modules …)` of `D_{qc,T}`). -/
instance pull_commShift : (pull j : DerivedCategory (Modules.{u, u} B S hS X.1 X.2) ⥤
    DerivedCategory (Modules.{u, u} B S hS U.1 U.2)).CommShift ℤ :=
  commShift_smallEtaleDerivedModulePullback B S hS j

/-- `Lj^*` is exact (AxiomMath's instance). -/
instance pull_isTriangulated : (pull j : DerivedCategory (Modules.{u, u} B S hS X.1 X.2) ⥤
    DerivedCategory (Modules.{u, u} B S hS U.1 U.2)).IsTriangulated :=
  isTriangulated_smallEtaleDerivedModulePullback B S hS j

/-- `Rj_*` commutes with shifts (Mathlib's instance for a total right derived functor). -/
instance push_commShift : (push j : DerivedCategory (Modules.{u, u} B S hS U.1 U.2) ⥤
    DerivedCategory (Modules.{u, u} B S hS X.1 X.2)).CommShift ℤ :=
  inferInstanceAs ((push j).CommShift ℤ)

/-- `Rj_*` is exact: the right adjoint of the exact `Lj^*`, the adjunction `Lj^* ⊣ Rj_*` being
compatible with the shifts (AxiomMath's `smallEtaleDerivedModuleAdjunction_commShift`). -/
instance push_isTriangulated : (push j : DerivedCategory (Modules.{u, u} B S hS U.1 U.2) ⥤
    DerivedCategory (Modules.{u, u} B S hS X.1 X.2)).IsTriangulated :=
  (smallEtaleDerivedModuleAdjunction B S hS j).isTriangulated_rightAdjoint

end Instances

section Functors

variable (h08FA : Tag08FAInput B S hS) (h08F4 : Tag08F4Input B S hS) (h0AFJ : Tag0AFJInput B S hS)
  (hpb : PullbackSupportInput B S hS)

variable {U X : AlgebraicSpaces B S hS} [(qcohDerived U).IsTriangulated]
  [(qcohDerived X).IsTriangulated]
  [∀ T, ObjectProperty.IsTriangulated (CohomologySupportedOn B S hS U.1 U.2 T)]
  [∀ T, ObjectProperty.IsTriangulated (CohomologySupportedOn B S hS X.1 X.2 T)]
  (j : U ⟶ X) (W : Set (points B S hS X.1))

omit [(qcohDerived X).IsTriangulated]
  [∀ T, ObjectProperty.IsTriangulated (CohomologySupportedOn B S hS X.1 X.2 T)] in
include h0AFJ in
/-- `Rf_*` sends objects supported on `|f|⁻¹ W` to objects supported on `W`, for `W` closed
(Stacks 0AFJ; GL26 Lemma A.3, `lem:support_for_pushforward`, for the support). -/
theorem push_supported {Y : AlgebraicSpaces B S hS} (f : Y ⟶ X) (hW : IsClosed W)
    {E : DerivedCategory (Modules.{u, u} B S hS Y.1 Y.2)}
    (hE : CohomologySupportedOn B S hS Y.1 Y.2 (pointsMap B S hS Y.1 f.hom ⁻¹' W) E) :
    CohomologySupportedOn B S hS X.1 X.2 W ((push f).obj E) := by
  have := isGrothendieckAbelian_modules B S hS Y.1 Y.2
  have h := h0AFJ f W hW
    (Stacks.DerivedFunctor.totalRightDerived (modulePushforward B S hS f))
    ((Stacks.DerivedFunctor.homotopyMap (modulePushforward B S hS f)).totalRightDerivedUnit
      DerivedCategory.Qh (HomotopyCategory.quasiIso _ (ComplexShape.up ℤ))) E hE
  exact (isClosedUnderIsomorphisms_cohomologySupportedOn' X _).of_iso
    ((smallEtaleDerivedModulePushforwardIso B S hS f).app E).symm h

/-- `Rj_* : D_{qc,|j|⁻¹ W}(U) ⥤ D_{qc,W}(X)` for `j` quasi-compact and quasi-separated and `W`
closed (Stacks 08FA (1), 0AFJ). -/
def pushZ (hjqc : IsQuasiCompact B S hS j.hom) (hjqs : IsQuasiSeparated B S hS j.hom)
    (hW : IsClosed W) :
    DqcZ U (pointsMap B S hS U.1 j.hom ⁻¹' W) ⥤ DqcZ X W :=
  liftZ (push j) (fun E => h08FA j hjqc hjqs _ E.obj.property)
    (fun E => push_supported h0AFJ W j hW E.property)

/-- `Lj^* : D_{qc,W}(X) ⥤ D_{qc,|j|⁻¹ W}(U)` (Stacks 08F4 and 08GF; GL26 Lemma A.2,
`lem:support_for_pullback`). -/
def pullZ : DqcZ X W ⥤ DqcZ U (pointsMap B S hS U.1 j.hom ⁻¹' W) :=
  liftZ (pull j) (fun E => h08F4 j E.obj.obj E.obj.property)
    (fun E => hpb j E.obj.obj E.property)

instance pushZ_commShift (hjqc : IsQuasiCompact B S hS j.hom)
    (hjqs : IsQuasiSeparated B S hS j.hom) (hW : IsClosed W) :
    (pushZ h08FA h0AFJ j W hjqc hjqs hW).CommShift ℤ :=
  liftZ_commShift (push j) _ _ (hF := push_commShift j)

instance pushZ_isTriangulated (hjqc : IsQuasiCompact B S hS j.hom)
    (hjqs : IsQuasiSeparated B S hS j.hom) (hW : IsClosed W) :
    (pushZ h08FA h0AFJ j W hjqc hjqs hW).IsTriangulated :=
  liftZ_isTriangulated (push j) _ _ (hF := push_commShift j) (hF' := push_isTriangulated j)

instance pullZ_commShift : (pullZ h08F4 hpb j W).CommShift ℤ :=
  liftZ_commShift (pull j) _ _ (hF := pull_commShift j)

instance pullZ_isTriangulated : (pullZ h08F4 hpb j W).IsTriangulated :=
  liftZ_isTriangulated (pull j) _ _ (hF := pull_commShift j) (hF' := pull_isTriangulated j)

/-- `Lj^* ⊣ Rj_*` restricted to `D_{qc,W}(X)` and `D_{qc,|j|⁻¹ W}(U)`. -/
def pullPushZAdj (hjqc : IsQuasiCompact B S hS j.hom) (hjqs : IsQuasiSeparated B S hS j.hom)
    (hW : IsClosed W) :
    pullZ h08F4 hpb j W ⊣ pushZ h08FA h0AFJ j W hjqc hjqs hW :=
  (pullPushAdj j).restrictFullyFaithful (fullyFaithfulιZ X W) (fullyFaithfulιZ U _)
    (liftZCompιZ _ _ _).symm (liftZCompιZ _ _ _).symm

/-- The inclusion `D_{qc,W ∩ T}(X) ⥤ D_{qc,W}(X)`. -/
def inclZ (T : Set (points B S hS X.1)) : DqcZ X (W ∩ T) ⥤ DqcZ X W :=
  (qcSupportedOn X W).lift (qcSupportedOn X (W ∩ T)).ι
    (fun E i => (E.property i).trans Set.inter_subset_left)

/-- The inclusion commutes with shifts. -/
instance inclZ_commShift (T : Set (points B S hS X.1)) : (inclZ W T).CommShift ℤ :=
  ObjectProperty.commShiftLift _ _ _

/-- The inclusion is exact. -/
instance inclZ_isTriangulated (T : Set (points B S hS X.1)) : (inclZ W T).IsTriangulated :=
  ObjectProperty.isTriangulated_lift _ _ _

/-- The inclusion followed by the inclusion into `D_qc(X)` is the inclusion. -/
def inclZCompι (T : Set (points B S hS X.1)) :
    inclZ W T ⋙ (qcSupportedOn X W).ι ≅ (qcSupportedOn X (W ∩ T)).ι :=
  Iso.refl _

/-- The inclusion `D_{qc,W ∩ T}(X) ⥤ D_{qc,W}(X)` is fully faithful. -/
def inclZFullyFaithful (T : Set (points B S hS X.1)) : (inclZ W T).FullyFaithful :=
  Functor.FullyFaithful.ofCompFaithful (G := (qcSupportedOn X W).ι)
    ((qcSupportedOn X (W ∩ T)).fullyFaithfulι.ofIso (inclZCompι W T).symm)

end Functors

/-! ### Exactness, full faithfulness, vanishing -/

section Properties

attribute [local instance] etaleModulePullback_additive preservesFiniteLimits_etaleModulePullback
  preservesFiniteColimits_etaleModulePullback

variable {U X : AlgebraicSpaces B S hS}

/-- An open immersion is a monomorphism of algebraic spaces. -/
theorem mono_of_isOpenImmersion (j : U ⟶ X) (hj : IsOpenImmersion B S hS j.hom) : Mono j :=
  have : Mono j.hom := mono_of_presheaf_isOpenImmersion hj
  Functor.mono_of_mono_map (ObjectProperty.ι _) this

/-- **`Rj_*` is fully faithful on `D(𝒪_U)`** for an open immersion `j`: the counit of
`(-)|_U ⊣ Rj_*` is invertible (`OpenImmersionCounitInput`, base change along `U ×_X U = U`). -/
def pushFullyFaithful (hcounit : OpenImmersionCounitInput B S hS) (j : U ⟶ X)
    (hj : IsOpenImmersion B S hS j.hom) : (push j).FullyFaithful :=
  have := mono_of_isOpenImmersion j hj
  have := hcounit j (isEtale_of_isOpenImmersion B S hS hj)
  (etaleDerivedModuleAdjunction B S hS j (isEtale_of_isOpenImmersion B S hS hj)
    ).fullyFaithfulROfIsIsoCounit

variable (h08FA : Tag08FAInput B S hS) (h08F4 : Tag08F4Input B S hS) (h0AFJ : Tag0AFJInput B S hS)
  (hpb : PullbackSupportInput B S hS)
  [(qcohDerived U).IsTriangulated] [(qcohDerived X).IsTriangulated]
  [∀ T, ObjectProperty.IsTriangulated (CohomologySupportedOn B S hS U.1 U.2 T)]
  [∀ T, ObjectProperty.IsTriangulated (CohomologySupportedOn B S hS X.1 X.2 T)]
  (j : U ⟶ X) (W : Set (points B S hS X.1))

/-- **`Rj_* : D_{qc,|j|⁻¹ W}(U) ⥤ D_{qc,W}(X)` is fully faithful.** -/
def pushZFullyFaithful (hcounit : OpenImmersionCounitInput B S hS)
    (hj : IsOpenImmersion B S hS j.hom) (hjqc : IsQuasiCompact B S hS j.hom) (hW : IsClosed W) :
    (pushZ h08FA h0AFJ j W hjqc (isQuasiSeparated_of_isOpenImmersion j hj) hW).FullyFaithful :=
  Functor.FullyFaithful.ofCompFaithful (G := ιZ X W)
    (((fullyFaithfulιZ U _).comp (pushFullyFaithful hcounit j hj)).ofIso (liftZCompιZ _ _ _).symm)

omit [(qcohDerived U).IsTriangulated] [(qcohDerived X).IsTriangulated]
  [∀ T, ObjectProperty.IsTriangulated (CohomologySupportedOn B S hS U.1 U.2 T)]
  [∀ T, ObjectProperty.IsTriangulated (CohomologySupportedOn B S hS X.1 X.2 T)] in
/-- `Lj^*` kills the objects of `D_{qc,W}(X)` supported on `W ∖ |U|`. -/
theorem isZero_pullZ_inclZ (hdisj : PullbackDisjointInput B S hS)
    (E : DqcZ X (W ∩ (Set.range (pointsMap B S hS U.1 j.hom))ᶜ)) :
    IsZero ((pullZ h08F4 hpb j W).obj ((inclZ W _).obj E)) := by
  refine IsZero.of_full_of_faithful_of_isZero (ιZ U _) _ ?_
  exact hdisj j _ E.obj.obj E.property
    (Set.disjoint_left.2 fun x hx hx' => hx'.2 hx)

omit [(qcohDerived X).IsTriangulated]
  [∀ T, ObjectProperty.IsTriangulated (CohomologySupportedOn B S hS X.1 X.2 T)] in
/-- **The kernel of `Lj^*` on `D_{qc,W}(X)` is `D_{qc,W ∖ |U|}(X)`**: an object of `D_{qc,W}(X)`
whose restriction to `U` vanishes is supported on `W ∖ |U|` (Stacks 08GF, 04K5, through the
identification of `Lj^*` with étale restriction). -/
theorem exists_inclZ_of_isZero_pullZ (hres : EtaleRestrictionSupportInput B S hS)
    (hj : IsOpenImmersion B S hS j.hom) (E : DqcZ X W)
    (hE : IsZero ((pullZ h08F4 hpb j W).obj E)) :
    ∃ Y : DqcZ X (W ∩ (Set.range (pointsMap B S hS U.1 j.hom))ᶜ),
      Nonempty (E ≅ (inclZ W _).obj Y) := by
  have hét := isEtale_of_isOpenImmersion B S hS hj
  have h0 : IsZero ((pull j).obj E.obj.obj) := (ιZ U _).map_isZero hE
  have h1 : IsZero ((etaleModulePullback.{u, u} B S hS j hét).mapDerivedCategory.obj E.obj.obj) :=
    h0.of_iso ((smallEtaleDerivedModulePullbackIsoEtale B S hS j hét).app _).symm
  have h2 := hres j hét _ h1
  exact ⟨⟨E.obj, fun i => Set.subset_inter (E.property i) (h2 i)⟩, ⟨Iso.refl _⟩⟩

omit [(qcohDerived X).IsTriangulated]
  [∀ T, ObjectProperty.IsTriangulated (CohomologySupportedOn B S hS X.1 X.2 T)] in
/-- The inclusion `D_{qc,W ∩ T}(X) ⥤ D_{qc,W}(X)` preserves `Type u`-indexed coproducts, `W` and
`W ∩ T` closed (both are closed under direct sums in `D_qc(X)`, which has them: Stacks 08F3 and
the remark before 0AED). -/
theorem preservesCoproducts_inclZ (h08F3 : Tag08F3Input B S hS)
    (hsum : SupportedDirectSumsInput B S hS) (T : Set (points B S hS X.1)) (hW : IsClosed W)
    (hWT : IsClosed (W ∩ T)) (I : Type u) :
    PreservesColimitsOfShape (Discrete I) (inclZ W T) := by
  have := h08F3 X.1 X.2
  have := hsum X (W ∩ T) hWT I
  have := hsum X W hW I
  have : PreservesColimitsOfShape (Discrete I) (inclZ W T ⋙ (qcSupportedOn X W).ι) :=
    preservesColimitsOfShape_of_natIso (inclZCompι W T).symm
  exact preservesColimitsOfShape_of_reflects_of_preserves _ (qcSupportedOn X W).ι

end Properties

/-! ### Right adjoints by Brown representability -/

section Brown

variable {C D : Type (u + 1)} [Category.{u + 1} C] [Category.{u + 1} D]
  [HasZeroObject C] [HasZeroObject D] [Preadditive C] [Preadditive D]
  [HasShift C ℤ] [HasShift D ℤ]
  [∀ n : ℤ, (shiftFunctor C n).Additive] [∀ n : ℤ, (shiftFunctor D n).Additive]
  [Pretriangulated C] [Pretriangulated D]

/-- **Brown representability (Stacks 0A8G).**  An exact functor preserving `Type u`-indexed
coproducts out of a locally `u`-small triangulated category with `Type u`-indexed coproducts and a
compact generator, into a locally `u`-small pretriangulated category, is a left adjoint. -/
theorem isLeftAdjoint_of_brown (h0A8G : Tag0A8GInput.{u}) [IsTriangulated C]
    [LocallySmall.{u} C] [LocallySmall.{u} D] [HasCoproducts.{u} C]
    (F : C ⥤ D) [F.CommShift ℤ] [F.IsTriangulated]
    (hF : ∀ I : Type u, PreservesColimitsOfShape (Discrete I) F) (P : C)
    (hPc : IsCompactObject.{u} P) (hPg : IsPaperGenerator P) : F.IsLeftAdjoint :=
  h0A8G F inferInstance inferInstance P ((Stacks.isWeakTriangulatedGenerator_singleton_iff P).2 hPg)

/-- The right adjoint of a left adjoint exact functor, with the shift of
`Adjunction.rightAdjointCommShift`, is exact. -/
theorem isTriangulated_rightAdjoint' (F : C ⥤ D) [F.CommShift ℤ] [F.IsTriangulated]
    [F.IsLeftAdjoint] :
    let := (Adjunction.ofIsLeftAdjoint F).rightAdjointCommShift ℤ
    F.rightAdjoint.IsTriangulated :=
  let := (Adjunction.ofIsLeftAdjoint F).rightAdjointCommShift ℤ
  have := (Adjunction.ofIsLeftAdjoint F).commShift_of_leftAdjoint ℤ
  (Adjunction.ofIsLeftAdjoint F).isTriangulated_rightAdjoint

end Brown

/-! ### Local smallness -/

/-- **`D_{qc,T}(X)` is locally `u`-small** (Stacks 079Q for `D(𝒪_X)`, then full subcategories). -/
theorem locallySmall_dqcZ (h079Q : Tag079QInput.{u}) (X : AlgebraicSpaces B S hS)
    (T : Set (points B S hS X.1)) : LocallySmall.{u} (DqcZ X T) :=
  have := isGrothendieckAbelian_modules B S hS X.1 X.2
  have : LocallySmall.{u} (DerivedCategory (Modules.{u, u} B S hS X.1 X.2)) := h079Q _
  inferInstance

/-! ### GL26 Lemma A.4 -/

section LemmaA4

attribute [local instance] etaleModulePullback_additive preservesFiniteLimits_etaleModulePullback
  preservesFiniteColimits_etaleModulePullback

/-- **Lemma A.4** (`lem:spacey_recollement`), the recollement with supports, over algebraic spaces.
Let `X` be a quasi-compact quasi-separated algebraic space, `j : U ⟶ X` a quasi-compact open
immersion, `Z = |X| ∖ |U|` and `W ⊆ |X|` closed with quasi-compact complement.  There is a
recollement
`D_{qc,|U| ∩ W}(U) → D_{qc,W}(X) → D_{qc,W ∩ Z}(X)`
whose middle functors are `Rj_*` and the natural inclusion `i_*`, and in which `Lj^*` is the left
adjoint of `Rj_*` (and `j^!_W`, `i^!`, `i^*` are the remaining adjoints).

Rendering (`RelativeWeakApprox.Recollement`, LP26 Setup 4.1, with the roles of LP26's proof of
Proposition 5.8): `D_Z := D_{qc,|j|⁻¹ W}(U)` with `i^* = Lj^*`, `i_* = Rj_*`, `i^! = j^!_W`;
`D_U := D_{qc,W ∖ |U|}(X)` with `j_! = ` the inclusion, `j^* = i^!`, `j_* = i^*` of GL26's
diagram.  The statement records that `R.iLower` restricts `Rj_*`, `R.iStar` restricts `Lj^*` and
`R.jShriek` is the inclusion, as isomorphisms after the inclusions into `D(𝒪)`.  The first claim
of GL26's lemma (no support, `D_qc(U) → D_qc(X) → D_{qc,Z}(X)`) is the case `W = |X|`
(`D_{qc,|X|}(X) = D_qc(X)` and `|j|⁻¹ |X| = |U|`).

Proof.  `Lj^* ⊣ Rj_*` restricts (Stacks 08F4, 08FA (1), 08GF, 0AFJ); `Rj_*` is fully faithful
(the counit of `(-)|_U ⊣ Rj_*` is invertible); the kernel of `Lj^*` on `D_{qc,W}(X)` is
`D_{qc,W ∖ |U|}(X)` (Stacks 08GF, 04K5).  The three right adjoints are produced by Brown
representability (Stacks 0A8G), as GL26 does for `j^!_W` (Balmer–Dell'Ambrogio–Sanders,
Corollary 2.3): `D_{qc,|j|⁻¹ W}(U)`, `D_{qc,W ∖ |U|}(X)` and `D_{qc,W}(X)` are compactly generated
by a perfect object (Stacks 0AEC, 0AED), the categories are locally `u`-small (Stacks 079Q), and
the functors preserve coproducts: `Rj_*` and `i^!` because their left adjoints `Lj^*` and `i_*`
preserve the compactness of a generator (perfect objects, Stacks 08H6, 0AED), the inclusion
because both supports are closed under direct sums.  GL26 obtains `i^!` and `i^*` from the Verdier
localization sequence (Gao–Psaroudakis, Lemma 2.2) instead; any two right adjoints are isomorphic.
The two gluing triangles and their natural connecting maps are then constructed from the adjoint
triples (`RecollementOfAdjoints.Data.toRecollement`). -/
theorem lemma_A_4 (h08FA : Tag08FAInput B S hS) (h08F4 : Tag08F4Input B S hS)
    (h0AFJ : Tag0AFJInput B S hS) (hpb : PullbackSupportInput B S hS)
    (hdisj : PullbackDisjointInput B S hS) (hres : EtaleRestrictionSupportInput B S hS)
    (hcounit : OpenImmersionCounitInput B S hS) (hperf : PerfectPullbackInput B S hS)
    (h08F3 : Tag08F3Input B S hS) (hsum : SupportedDirectSumsInput B S hS)
    (h0AEC : Tag0AECInput B S hS) (h0AED : Tag0AEDInput B S hS) (h079Q : Tag079QInput.{u})
    (h0A8G : Tag0A8GInput.{u}) (hRAC : RightAdjointCoproductsInput.{u})
    (hqcs : QuasiCompactSourceInput B S hS) (hcpt : CompactComplPreimageInput B S hS)
    {U X : AlgebraicSpaces B S hS} [(qcohDerived U).IsTriangulated]
    [(qcohDerived X).IsTriangulated]
    [∀ T, ObjectProperty.IsTriangulated (CohomologySupportedOn B S hS U.1 U.2 T)]
    [∀ T, ObjectProperty.IsTriangulated (CohomologySupportedOn B S hS X.1 X.2 T)]
    (hZ : B.Contains (⊤_ Scheme.{u})) (hXqc : IsQuasiCompactSpace B S hS X.1)
    (hXqs : IsAbsolutelyQuasiSeparated B S hS hZ X.1)
    (j : U ⟶ X) (hj : IsOpenImmersion B S hS j.hom) (hjqc : IsQuasiCompact B S hS j.hom)
    (W : Set (points B S hS X.1)) (hW : IsClosed W) (hWc : _root_.IsCompact Wᶜ) :
    ∃ R : Recollement (DqcZ U (pointsMap B S hS U.1 j.hom ⁻¹' W)) (DqcZ X W)
        (DqcZ X (W ∩ (Set.range (pointsMap B S hS U.1 j.hom))ᶜ)),
      Nonempty (R.iLower ⋙ ιZ X W ≅ ιZ U _ ⋙ push j) ∧
      Nonempty (R.iStar ⋙ ιZ U _ ≅ ιZ X W ⋙ pull j) ∧
      Nonempty (R.jShriek ⋙ ιZ X W ≅ ιZ X _) := by
  have hjqs := isQuasiSeparated_of_isOpenImmersion j hj
  have hUqc : IsQuasiCompactSpace B S hS U.1 := hqcs X.2 hXqc j.hom hjqc
  have hUqs : IsAbsolutelyQuasiSeparated B S hS hZ U.1 :=
    isAbsolutelyQuasiSeparated_of_isQuasiSeparated B S hS hZ U.2 hXqs hjqs
  let WU := pointsMap B S hS U.1 j.hom ⁻¹' W
  let T := (Set.range (pointsMap B S hS U.1 j.hom))ᶜ
  have hWU : IsClosed WU := hW.preimage (continuous_pointsMap B S hS j.hom)
  have hWUc : _root_.IsCompact WUᶜ := hcpt hZ j hUqc hXqs W hW hWc
  have hT : IsClosed T :=
    (isOpenMap_pointsMap_of_isOpenImmersion B S hS j.hom hj).isOpen_range.isClosed_compl
  have hWT : IsClosed (W ∩ T) := hW.inter hT
  have hWTc : _root_.IsCompact (W ∩ T)ᶜ := by
    rw [Set.compl_inter, compl_compl]
    have := compactSpace_points_of_isQuasiCompactSpace B S hS U.2 hUqc
    exact hWc.union (isCompact_range (continuous_pointsMap B S hS j.hom))
  have gU := lemma_A_9_generator h0AEC h0AED U hUqc hZ hUqs WU hWU hWUc
  have gX := lemma_A_9_generator h0AEC h0AED X hXqc hZ hXqs W hW hWc
  have gT := lemma_A_9_generator h0AEC h0AED X hXqc hZ hXqs (W ∩ T) hWT hWTc
  let PU := gU.choose
  have hPU := gU.choose_spec
  let PX := gX.choose
  have hPX := gX.choose_spec
  let PT := gT.choose
  have hPT := gT.choose_spec
  have hPUc : IsCompactObject.{u} PU := hPU.2.1
  have hPUg : IsPaperGenerator PU := hPU.2.2
  have hPXp := hPX.1
  have hPXc : IsCompactObject.{u} PX := hPX.2.1
  have hPXg : IsPaperGenerator PX := hPX.2.2
  have hPTp := hPT.1
  have hPTc : IsCompactObject.{u} PT := hPT.2.1
  have hPTg : IsPaperGenerator PT := hPT.2.2
  have : LocallySmall.{u} (DqcZ U WU) := locallySmall_dqcZ h079Q U WU
  have : LocallySmall.{u} (DqcZ X W) := locallySmall_dqcZ h079Q X W
  have : LocallySmall.{u} (DqcZ X (W ∩ T)) := locallySmall_dqcZ h079Q X (W ∩ T)
  have : HasCoproducts.{u} (DqcZ U WU) := hasCoproducts h08F3 hsum U WU hWU
  have : HasCoproducts.{u} (DqcZ X W) := hasCoproducts h08F3 hsum X W hW
  have : HasCoproducts.{u} (DqcZ X (W ∩ T)) := hasCoproducts h08F3 hsum X (W ∩ T) hWT
  -- `i^* ⊣ i_*` is `Lj^* ⊣ Rj_*`
  let iL := pushZ h08FA h0AFJ j W hjqc hjqs hW
  let iS := pullZ h08F4 hpb j W
  let a₁ : iS ⊣ iL := pullPushZAdj h08FA h08F4 h0AFJ hpb j W hjqc hjqs hW
  have hff : iL.FullyFaithful := pushZFullyFaithful h08FA h0AFJ j W hcounit hj hjqc hW
  have := hff.full
  have := hff.faithful
  have : iS.Additive := Functor.IsTriangulated.instAdditive iS
  have : iL.Additive := Functor.IsTriangulated.instAdditive iL
  -- `i^! = j^!_W`, by Brown representability
  have hiL : ∀ I : Type u, PreservesColimitsOfShape (Discrete I) iL :=
    hRAC a₁ PX ((Stacks.isWeakTriangulatedGenerator_singleton_iff PX).2 hPXg) hPXc
      ((h0AED hZ U hUqc hUqs WU hWU hWUc _).2 (hperf j _ hPXp))
  have : iL.IsLeftAdjoint := isLeftAdjoint_of_brown h0A8G iL hiL PU hPUc hPUg
  let := (Adjunction.ofIsLeftAdjoint iL).rightAdjointCommShift ℤ
  have := isTriangulated_rightAdjoint' iL
  -- `j_!` is the inclusion; `j^* = i^!` and `j_* = i^*`, by Brown representability
  let jSh := inclZ W T
  have := (inclZFullyFaithful W T).full
  have := (inclZFullyFaithful W T).faithful
  have : jSh.Additive := Functor.IsTriangulated.instAdditive jSh
  have : jSh.IsLeftAdjoint := isLeftAdjoint_of_brown h0A8G jSh
    (preservesCoproducts_inclZ W h08F3 hsum T hW hWT) PT hPTc hPTg
  let := (Adjunction.ofIsLeftAdjoint jSh).rightAdjointCommShift ℤ
  have := isTriangulated_rightAdjoint' jSh
  let jSt := jSh.rightAdjoint
  let b₁ : jSh ⊣ jSt := Adjunction.ofIsLeftAdjoint jSh
  have : jSt.Additive := Functor.IsTriangulated.instAdditive jSt
  have hjSt : ∀ I : Type u, PreservesColimitsOfShape (Discrete I) jSt :=
    hRAC b₁ PT ((Stacks.isWeakTriangulatedGenerator_singleton_iff PT).2 hPTg) hPTc
      ((h0AED hZ X hXqc hXqs W hW hWc _).2 hPTp)
  have : jSt.IsLeftAdjoint := isLeftAdjoint_of_brown h0A8G jSt hjSt PX hPXc hPXg
  let := (Adjunction.ofIsLeftAdjoint jSt).rightAdjointCommShift ℤ
  have := isTriangulated_rightAdjoint' jSt
  let R : Data (DqcZ U WU) (DqcZ X W) (DqcZ X (W ∩ T)) :=
    { iStar := iS
      iLower := iL
      iShriek := iL.rightAdjoint
      jShriek := jSh
      jStar := jSt
      jUpper := jSt.rightAdjoint
      iStarAdj := a₁
      iLowerAdj := Adjunction.ofIsLeftAdjoint iL
      jShriekAdj := b₁
      jStarAdj := Adjunction.ofIsLeftAdjoint jSt
      mem_essImage_of_isZero := exists_inclZ_of_isZero_pullZ h08F4 hpb j W hres hj
      isZero_iStar_jShriek := isZero_pullZ_inclZ h08F4 hpb j W hdisj }
  exact ⟨R.toRecollement, ⟨liftZCompιZ _ _ _⟩, ⟨liftZCompιZ _ _ _⟩, ⟨Iso.refl _⟩⟩

end LemmaA4

/-! ### Non-vacuity -/

section NonVacuity

/-- **Non-vacuity of `lemma_A_4`**: at an affine `X = h_{T₀}` (for instance the base `S` itself
when `S` is affine, e.g. `S = Spec ℤ`, `Supported.nonVacuity_base`), with `U = X`, `j = 𝟙_X` and
`W = |X|`, every hypothesis of `lemma_A_4` holds: the two instance arguments (from 06UQ and
`SupportTriangulatedInput`), `X` quasi-compact and quasi-separated, `j` a quasi-compact open
immersion, `W` closed with quasi-compact (empty) complement.  The lemma then gives the recollement
`D_{qc}(X) → D_{qc}(X) → D_{qc,∅}(X)`. -/
theorem lemma_A_4_nonVacuity (h06 : Tag06UQInput B S hS)
    (hsuppT : SupportTriangulatedInput B S hS) (hqs : AffineQuasiSeparatedInput B S hS)
    (hterm : ContainsTerminalInput.{u})
    (T₀ : BigFppfOver B S hS) (hT₀ : IsAffine ((BigFppfOver.toScheme B S hS).obj T₀)) :
    (qcohDerived (representedSpace T₀)).IsTriangulated ∧
      (∀ T, ObjectProperty.IsTriangulated
        (CohomologySupportedOn B S hS (representedSpace T₀).1 (representedSpace T₀).2 T)) ∧
      IsQuasiCompactSpace B S hS (representedSpace T₀).1 ∧
      IsAbsolutelyQuasiSeparated B S hS (hterm B) (representedSpace T₀).1 ∧
      IsOpenImmersion B S hS
        (𝟙 (representedSpace T₀) : representedSpace T₀ ⟶ representedSpace T₀).hom ∧
      IsQuasiCompact B S hS
        (𝟙 (representedSpace T₀) : representedSpace T₀ ⟶ representedSpace T₀).hom ∧
      IsClosed (Set.univ : Set (points B S hS (representedSpace T₀).1)) ∧
      _root_.IsCompact (Set.univ : Set (points B S hS (representedSpace T₀).1))ᶜ := by
  obtain ⟨hqc, hqs', hcl, hco⟩ := nonVacuity_affine_univ hqs (hterm B) T₀ hT₀
  exact ⟨isTriangulated_qcohDerived h06 _, isTriangulated_support hsuppT _, hqc, hqs',
    isOpenImmersion_id _, isQuasiCompact_of_isIso' (𝟙 _), hcl, hco⟩

end NonVacuity

