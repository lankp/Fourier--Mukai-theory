/-- **Proposition 5.8** (`prop:A8`), standard W.A. part, over algebraic spaces.  Let
`(U ⊆ X, f : Y ⟶ X)` be an elementary distinguished square (Stacks 08GM) of quasi-compact
quasi-separated algebraic spaces.  If `U` and `Y` satisfy standard W.A. (Definition 5.3), so does
`X`: for every closed `S ⊆ |X|` with quasi-compact complement there are weak approximation data
on `D_{qc,S}(X)` whose `t`-structure is the standard one.

Hypotheses as in `proposition_5_8` (the W.A. part), and Stacks 08FA (2) (`Tag08FABoundInput`, the
bound of LP26 Lemma 5.7).  Proof: module docstring. -/
theorem proposition_5_8_standard (h08FA : Tag08FAInput B S hS) (h08F4 : Tag08F4Input B S hS)
    (h0AFJ : Tag0AFJInput B S hS) (hpb : PullbackSupportInput B S hS)
    (hdisj : PullbackDisjointInput B S hS) (hres : EtaleRestrictionSupportInput B S hS)
    (hcounit : OpenImmersionCounitInput B S hS) (hperf : PerfectPullbackInput B S hS)
    (h08F3 : Tag08F3Input B S hS) (hsum : SupportedDirectSumsInput B S hS)
    (h0AEC : Tag0AECInput B S hS) (h0AED : Tag0AEDInput B S hS) (h079Q : Tag079QInput.{u})
    (h0A8G : Tag0A8GInput.{u}) (hRAC : RightAdjointCoproductsInput.{u})
    (hqcs : QuasiCompactSourceInput B S hS) (hcpt : CompactComplPreimageInput B S hS)
    (h08GGu : Tag08GGUnitInput B S hS) (h08GGc : Tag08GGCounitInput B S hS)
    (h073B : Tag073BInput B S hS) (h073B2 : Tag073BTwoInput B S hS)
    (h09M8 : Tag09M8Input B S hS) (hbd : PerfectBoundedAboveInput B S hS)
    (h09MB : Tag09MBInput B S hS) (h08FAb : Tag08FABoundInput B S hS)
    {X : AlgebraicSpaces B S hS} {V : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u}
    {Uo : Subfunctor X.1} {fV : V ⟶ X.1}
    (hsq : IsElementaryDistinguishedSquare B S hS X.2 Uo fV)
    [(qcohDerived X).IsTriangulated] [(qcohDerived (edsOpenSpace hsq)).IsTriangulated]
    [(qcohDerived (edsEtaleSpace hsq)).IsTriangulated]
    [∀ T, ObjectProperty.IsTriangulated (CohomologySupportedOn B S hS X.1 X.2 T)]
    [∀ T, ObjectProperty.IsTriangulated
      (CohomologySupportedOn B S hS (edsOpenSpace hsq).1 (edsOpenSpace hsq).2 T)]
    [∀ T, ObjectProperty.IsTriangulated
      (CohomologySupportedOn B S hS (edsEtaleSpace hsq).1 (edsEtaleSpace hsq).2 T)]
    (hZ : B.Contains (⊤_ Scheme.{u}))
    (hXqc : IsQuasiCompactSpace B S hS X.1) (hXqs : IsAbsolutelyQuasiSeparated B S hS hZ X.1)
    (hUqc : IsQuasiCompactSpace B S hS Uo.toFunctor)
    (hVqc : IsQuasiCompactSpace B S hS V) (hVqs : IsAbsolutelyQuasiSeparated B S hS hZ V)
    (hU : SatisfiesStandardWA (edsOpenSpace hsq)) (hY : SatisfiesStandardWA (edsEtaleSpace hsq)) :
    SatisfiesStandardWA X := by
  intro W hW hWc
  let j := edsOpenMap hsq
  have hj : IsOpenImmersion B S hS j.hom := hsq.isOpenSubspace.2
  have hjqc : IsQuasiCompact B S hS j.hom := h073B hZ X.2 hXqs hUqc j.hom
  have hjqs := isQuasiSeparated_of_isOpenImmersion j hj
  let T := (Set.range (pointsMap B S hS (edsOpenSpace hsq).1 j.hom))ᶜ
  -- the recollement (GL26 Lemma A.4)
  have hR := lemma_A_4 h08FA h08F4 h0AFJ hpb hdisj hres hcounit hperf h08F3 hsum h0AEC h0AED
    h079Q h0A8G hRAC hqcs hcpt hZ hXqc hXqs j hj hjqc W hW hWc
  let R := hR.choose
  obtain ⟨⟨eL⟩, ⟨eS⟩, ⟨eJ⟩⟩ := hR.choose_spec
  -- the left term: the standard `t`-structure carries weak approximation data
  have hWU : IsClosed (pointsMap B S hS _ j.hom ⁻¹' W) :=
    hW.preimage (continuous_pointsMap B S hS j.hom)
  obtain ⟨WZ, hWZ⟩ := hU _ hWU (hcpt hZ j hUqc hXqs W hW hWc)
  -- the right term, through the `t`-exact equivalence of GL26 Lemma A.6
  have hUqc' : IsQuasiCompactSpace B S hS (edsOpenSpace hsq).1 := hUqc
  have hT : IsClosed T :=
    (isOpenMap_pointsMap_of_isOpenImmersion B S hS j.hom hj).isOpen_range.isClosed_compl
  have hWT : IsClosed (W ∩ T) := hW.inter hT
  have hWTc : _root_.IsCompact (W ∩ T)ᶜ := by
    rw [Set.compl_inter, compl_compl]
    have := compactSpace_points_of_isQuasiCompactSpace B S hS (edsOpenSpace hsq).2 hUqc'
    exact hWc.union (isCompact_range (continuous_pointsMap B S hS j.hom))
  obtain ⟨WY, hWY⟩ := hY _ (hWT.preimage (continuous_pointsMap B S hS (edsEtaleMap hsq).hom))
    (hcpt hZ (edsEtaleMap hsq) hVqc hXqs (W ∩ T) hWT hWTc)
  have hA6 := lemma_A_6_aux h08FA h08F4 h0AFJ hpb h08GGu h08GGc h073B h073B2 hsq hZ hXqs hVqc hVqs
    (W ∩ T) hWT Set.inter_subset_right
  let adj := edsAdj h08FA h08F4 h0AFJ hpb h073B h073B2 hsq hZ hXqs hVqc hVqs (W ∩ T) hWT
  have := hA6.1
  have := hA6.2.1
  let e := adj.toEquivalence
  let : e.functor.CommShift ℤ := pullZ_commShift h08F4 hpb (edsEtaleMap hsq) (W ∩ T)
  let : e.inverse.CommShift ℤ := pushZ_commShift h08FA h0AFJ (edsEtaleMap hsq) (W ∩ T)
    (isQuasiCompact_edsEtaleMap h073B hsq hZ hXqs hVqc)
    (isQuasiSeparated_edsEtaleMap h073B2 hsq hZ hVqs) hWT
  have : e.functor.IsTriangulated := pullZ_isTriangulated h08F4 hpb (edsEtaleMap hsq) (W ∩ T)
  have : e.inverse.IsTriangulated := pushZ_isTriangulated h08FA h0AFJ (edsEtaleMap hsq) (W ∩ T)
    (isQuasiCompact_edsEtaleMap h073B hsq hZ hXqs hVqc)
    (isQuasiSeparated_edsEtaleMap h073B2 hsq hZ hVqs) hWT
  have : e.functor.Additive := Functor.IsTriangulated.instAdditive _
  have : e.inverse.Additive := Functor.IsTriangulated.instAdditive _
  obtain ⟨WU, hWUle⟩ := GluedPreferred.exists_paperData_of_equivalence e WY
  have hWUt : TStructureEquivalent WU.t (standardTStructure X (W ∩ T)) := by
    have heq : WU.t = standardTStructure X (W ∩ T) := by
      apply RelativeWeakApprox.TStructure.ext_le_zero
      funext M
      apply propext
      rw [hWUle, hWY]
      change (standardTStructure (edsEtaleSpace hsq) (edsW hsq (W ∩ T))).le 0
        ((pullZ h08F4 hpb (edsEtaleMap hsq) (W ∩ T)).obj M) ↔ _
      constructor
      · intro hM
        rw [TStructure.le_iff_isLE] at hM
        have h' := (hA6.2.2.2 _ 0).1 hM
        exact ((standardTStructure X (W ∩ T)).le 0).prop_of_iso (asIso (adj.unit.app M)).symm
          (((standardTStructure X (W ∩ T)).le_iff_isLE _ _).2 h')
      · intro hM
        rw [TStructure.le_iff_isLE] at hM ⊢
        exact (hA6.2.2.1 M 0).1 hM
    rw [heq]
    exact tStructureEquivalent_refl _
  -- the middle term: a compact generator with eventually vanishing self-extensions
  have hgen := lemma_A_9_generator h0AEC h0AED X hXqc hZ hXqs W hW hWc
  let G' := hgen.choose
  have hG'c : IsCompactObject.{u} G' := hgen.choose_spec.2.1
  have hG'g : IsPaperGenerator G' := hgen.choose_spec.2.2
  obtain ⟨N, hN⟩ := lemma_5_6_dqcZ h09M8 hbd h09MB h0AED hZ X hXqc hXqs W hW hWc G' hG'c hG'g
  have : LocallySmall.{u} (DqcZ (edsOpenSpace hsq) (pointsMap B S hS _ j.hom ⁻¹' W)) :=
    locallySmall_dqcZ h079Q _ _
  have : LocallySmall.{u} (DqcZ X W) := locallySmall_dqcZ h079Q X W
  have : LocallySmall.{u} (DqcZ X (W ∩ T)) := locallySmall_dqcZ h079Q X (W ∩ T)
  have : HasCoproducts.{u} (DqcZ (edsOpenSpace hsq) (pointsMap B S hS _ j.hom ⁻¹' W)) :=
    hasCoproducts h08F3 hsum _ _ hWU
  have : HasCoproducts.{u} (DqcZ X W) := hasCoproducts h08F3 hsum X W hW
  have : HasCoproducts.{u} (DqcZ X (W ∩ T)) := hasCoproducts h08F3 hsum X (W ∩ T) hWT
  -- the bound of Lemma 5.7: `Rj_* D^{≤ c}_qc(U) ⊆ D^{≤ c + r}(X)` (Stacks 08FA (2))
  obtain ⟨N₀, hN₀⟩ := h08FAb j hjqc hjqs hXqc
  have hr0 : N₀ ≤ max N₀ 0 := le_max_left _ _
  have hr1 : 0 ≤ max N₀ 0 := le_max_right _ _
  -- abbreviations
  let tO := DerivedCategory.TStructure.t (C := Modules.{u, u} B S hS X.1 X.2)
  let tD := standardTStructure X W
  let tZ := standardTStructure (edsOpenSpace hsq) (pointsMap B S hS _ j.hom ⁻¹' W)
  let tU := standardTStructure X (W ∩ T)
  -- `i_* = Rj_*` raises the degree by at most `r`
  have hL : ∀ (M : DqcZ (edsOpenSpace hsq) (pointsMap B S hS _ j.hom ⁻¹' W)) (n : ℤ),
      tZ.le n M → tD.le (n + max N₀ 0) (R.iLower.obj M) := by
    intro M n hM
    rw [standardTStructure_le_iff_ιZ] at hM ⊢
    have h₀ : ((push j).obj ((ιZ _ _).obj M)).IsLE (n + N₀) :=
      hN₀ _ M.obj.property n ((DerivedCategory.TStructure.t.le_iff_isLE _ n).1 hM)
    have h₁ : tO.le (n + max N₀ 0) ((push j).obj ((ιZ _ _).obj M)) :=
      tO.le_monotone (by omega) _ ((tO.le_iff_isLE _ _).2 h₀)
    exact (tO.le (n + max N₀ 0)).prop_of_iso (eL.app M).symm h₁
  -- `j_!` is the inclusion: it preserves and reflects the standard aisles
  have hJ : ∀ (M : DqcZ X (W ∩ T)) (n : ℤ), tD.le n (R.jShriek.obj M) ↔ tU.le n M := by
    intro M n
    rw [standardTStructure_le_iff_ιZ, standardTStructure_le_iff_ιZ]
    exact ⟨fun h => (tO.le n).prop_of_iso (eJ.app M) h,
      fun h => (tO.le n).prop_of_iso (eJ.app M).symm h⟩
  -- `i^* = Lj^*` preserves the standard aisles (`j` is étale)
  have hI : ∀ (E : DqcZ X W) (n : ℤ), tD.le n E → tZ.le n (R.iStar.obj E) := by
    intro E n hE
    rw [standardTStructure_le_iff_ιZ] at hE ⊢
    refine (DerivedCategory.TStructure.t.le n).prop_of_iso (eS.app E).symm ?_
    rw [TStructure.le_iff_isLE] at hE ⊢
    change ((pull j).obj ((ιZ X W).obj E)).IsLE n
    change ((ιZ X W).obj E).IsLE n at hE
    rw [DerivedCategory.isLE_iff] at hE ⊢
    exact fun i hi => isZero_homology_pull_of_isEtale j (isEtale_of_isOpenImmersion B S hS hj) _ i
      (hE i hi)
  -- the comparison of the standard and the glued `t`-structures
  have h₁ : ∀ (n : ℤ) (E : DqcZ X W), tD.le n E →
      gluedLe R.iStar R.jStar tZ tU (n + (max N₀ 0 + 1)) E := by
    intro n E hE
    have hi := hI E n hE
    refine ⟨tZ.le_monotone (by omega) _ hi, ?_⟩
    have h3 : tD.le (n + max N₀ 0 + 1) ((R.iLower.obj (R.iStar.obj E))⟦(-1 : ℤ)⟧) :=
      tD.le_shift (n + max N₀ 0) (-1) (n + max N₀ 0 + 1) (by omega)
        (R.iLower.obj (R.iStar.obj E)) (hL _ n hi)
    have h2 := tD.isLE₂ _ (inv_rot_of_distTriang _ (R.first_distinguished E))
      (n + max N₀ 0 + 1) ((tD.le_iff_isLE _ _).1 h3)
      ((tD.le_iff_isLE _ _).1 (tD.le_monotone (by omega) _ hE))
    have h2' : tD.le (n + (max N₀ 0 + 1)) (R.jShriek.obj (R.jStar.obj E)) :=
      tD.le_monotone (by omega) _ ((tD.le_iff_isLE _ _).2 h2)
    exact (hJ _ _).1 h2'
  have h₂ : ∀ (n : ℤ) (E : DqcZ X W), gluedLe R.iStar R.jStar tZ tU n E →
      tD.le (n + (max N₀ 0 + 1)) E := by
    rintro n E ⟨hi, hj⟩
    have h1 : tD.le (n + (max N₀ 0 + 1)) (R.jShriek.obj (R.jStar.obj E)) :=
      tD.le_monotone (by omega) _ ((hJ _ n).2 hj)
    have h3 : tD.le (n + (max N₀ 0 + 1)) (R.iLower.obj (R.iStar.obj E)) :=
      tD.le_monotone (by omega) _ (hL _ n hi)
    exact (tD.le_iff_isLE _ _).2 (tD.isLE₂ _ (R.first_distinguished E) _
      ((tD.le_iff_isLE _ _).1 h1) ((tD.le_iff_isLE _ _).1 h3))
  exact GluedPreferred.exists_paperData_of_gluedBounds_univ.{u} R WZ WU G'
    ((Stacks.isCompactObject_iff_sumUniverse_isCompactAb G').1 hG'c) hG'g
    ⟨N + 1, fun n hn f => hN n (by omega) f⟩ tD tZ tU
    (by rw [hWZ]; exact tStructureEquivalent_refl _) hWUt (max N₀ 0 + 1) (by omega) h₁ h₂

end Proposition

/-! ### Non-vacuity -/

section NonVacuity

/-- **Non-vacuity of `proposition_5_8_standard`**: as for `proposition_5_8_nonVacuity`, the square
`(⊤ ⊆ X, ⊤.ι)` on the empty open subspace `X` of a quasi-separated `X₀` meets every hypothesis,
its open and étale parts satisfying standard W.A. (`satisfiesStandardWA_of_isEmpty`). -/
theorem proposition_5_8_standard_nonVacuity (hempty : SupportEmptyInput B S hS)
    (hEDS : EDSTopInput B S hS) (hqcO : OpenSubspaceQuasiCompactInput B S hS)
    [∀ Y : AlgebraicSpaces B S hS, (qcohDerived Y).IsTriangulated]
    [∀ (Y : AlgebraicSpaces B S hS) T, ObjectProperty.IsTriangulated
      (CohomologySupportedOn B S hS Y.1 Y.2 T)]
    (hZ : B.Contains (⊤_ Scheme.{u})) (X₀ : AlgebraicSpaces B S hS)
    (hX₀qs : IsAbsolutelyQuasiSeparated B S hS hZ X₀.1) :
    ∃ (X : AlgebraicSpaces B S hS) (hsq : IsElementaryDistinguishedSquare B S hS X.2
        (⊤ : Subfunctor X.1) (⊤ : Subfunctor X.1).ι),
      IsQuasiCompactSpace B S hS X.1 ∧ IsAbsolutelyQuasiSeparated B S hS hZ X.1 ∧
      IsQuasiCompactSpace B S hS (⊤ : Subfunctor X.1).toFunctor ∧
      IsAbsolutelyQuasiSeparated B S hS hZ (⊤ : Subfunctor X.1).toFunctor ∧
      SatisfiesStandardWA (edsOpenSpace hsq) ∧ SatisfiesStandardWA (edsEtaleSpace hsq) := by
  let X := emptySpace X₀
  have hXe := isEmpty_points_emptySpace X₀
  have hXqc : IsQuasiCompactSpace B S hS X.1 :=
    hqcO X₀.2 (emptySubspace X₀).2 (by
      have hr : Set.range (pointsMap B S hS (emptySubspace X₀).1.toFunctor
          (emptySubspace X₀).1.ι) = ∅ :=
        Set.eq_empty_iff_forall_notMem.2 fun _ ⟨p, _⟩ => hXe.elim p
      rw [hr]
      exact isCompact_empty)
  have hXqs : IsAbsolutelyQuasiSeparated B S hS hZ X.1 :=
    isAbsolutelyQuasiSeparated_of_isQuasiSeparated B S hS hZ X.2 hX₀qs
      (isQuasiSeparated_of_mono' (emptySubspace X₀).1.ι)
  have hsq := hEDS X.2 (isOpenSubspace_top X.2)
  have e : (⊤ : Subfunctor X.1).toFunctor ≅ X.1 := asIso (⊤ : Subfunctor X.1).ι
  have hTe : IsEmpty (points B S hS (⊤ : Subfunctor X.1).toFunctor) :=
    (pointsMap B S hS _ (⊤ : Subfunctor X.1).ι).isEmpty
  refine ⟨X, hsq, hXqc, hXqs, IsQuasiCompactSpace.of_iso B S hS hXqc e.symm,
    isAbsolutelyQuasiSeparated_of_isQuasiSeparated B S hS hZ hsq.isAlgebraicSpace hXqs
      (isQuasiSeparated_of_mono' (⊤ : Subfunctor X.1).ι),
    satisfiesStandardWA_of_isEmpty hempty _ hTe, satisfiesStandardWA_of_isEmpty hempty _ hTe⟩

end NonVacuity

/-! ### Corollary 1.2, standard W.A. -/

/-- **The module model with the standard `t`-structure** (Neeman 2024, Theorem 3.2(iv) for
`Spec A`, `Z = V(I)`, as proved in the tree, `NeemanAffineSupport.satisfiesPaperWA_of_fg`): for
`I` finitely generated, `D_{V(I)}(A-Mod)` carries weak approximation data whose `t`-structure is
the standard one.  The data are those of `IdealNeemanM1.satisfiesPaperWA_idealSupported`
(Koszul generator, `ClosedSupportNeemanM4.idealSupportedPaperDataOfH0Cover`), whose
`t`-structure is `affineDZIdealStandardTStructure` by construction. -/
theorem exists_affineData_standard (A : Type u) [CommRing A] (I : Ideal A) (hI : I.FG) :
    ∃ W : PaperM2.PaperWeakApproximationData (NeemanFiniteSupportM4.AffineDZIdeal A I),
      W.t = NeemanFiniteSupportM4.affineDZIdealStandardTStructure A I := by
  classical
  obtain ⟨s, rfl⟩ := hI
  have h : FiniteKoszulM1.functionIdeal A s.toList = Ideal.span (s : Set A) := by
    rw [AffineSupportedSchemeBaseM1.functionIdeal_eq_span_toFinset, Finset.toList_toFinset]
  rw [← h]
  let fs := s.toList
  let G : NeemanFiniteSupportM4.AffineDZIdeal A (FiniteKoszulM1.functionIdeal A fs) :=
    ⟨(FiniteKoszulM1.koszulListData A (FiniteKoszulM1.unitExponents A fs)).obj, by
      rw [← FiniteKoszulM1.listIdeal_unitExponents]
      exact (FiniteKoszulM1.koszulListData A (FiniteKoszulM1.unitExponents A fs)).supported⟩
  have hGc : IsCompactAb G := IdealNeemanM1.isCompactAb_koszulListData_unitExponents A fs
    (RegularCompact.ringObject_isCompactAb A)
  have hGg : IsPaperGenerator G := fun hF =>
    IdealNeemanM1.isZero_idealSupported_of_ambient_detection A fs hF
  obtain ⟨N, hN, hGle, hvan⟩ :=
    ClosedSupportNeemanM4.exists_idealSupported_perfect_standard_bounds
      A (FiniteKoszulM1.functionIdeal A fs) G
      (FiniteKoszulM1.koszulListData A (FiniteKoszulM1.unitExponents A fs)).perfect
  exact ⟨ClosedSupportNeemanM4.idealSupportedPaperDataOfH0Cover
    A (FiniteKoszulM1.functionIdeal A fs) G N hN hGc hGg hGle hvan
      (IdealNeemanM1.idealSupportedH0Cover A fs N hN), rfl⟩

/-- **Weak approximation data descend to a smaller coproduct universe with the same
`t`-structure** (the construction of `UniverseDescent.satisfiesPaperWA_of_max`, which keeps the
generator, the `t`-structure and the bound). -/
theorem exists_paperData_of_max.{w, v, v', u'} {C : Type u'} [Category.{v} C] [HasZeroObject C]
    [HasShift C ℤ] [Preadditive C] [∀ (n : ℤ), (shiftFunctor C n).Additive] [Pretriangulated C]
    [LocallySmall.{w} C] [HasCoproducts.{w} C]
    (W : SumUniverse.PaperWeakApproximationData.{max w v'} C) :
    ∃ W' : SumUniverse.PaperWeakApproximationData.{w} C, W'.t = W.t :=
  ⟨{ G := W.G
     t := W.t
     A := W.A
     A_pos := W.A_pos
     G_compact := UniverseDescent.isCompactAb_of_max W.G_compact
     G_paperGenerates := W.G_paperGenerates
     G_mem_le := W.G_mem_le
     hom_vanishing := W.hom_vanishing
     exists_triangle := fun F hF => by
       obtain ⟨E, D, f, g, k, hT, hE, hD⟩ := W.exists_triangle F hF
       exact ⟨E, D, f, g, k, hT, UniverseDescent.envelope_le.{w} _ _ _ _ hE, hD⟩ }, rfl⟩

-- The elaboration of the instance terms is slow.
set_option maxHeartbeats 1000000 in
/-- **From `DqcSupported X T` to `D_{qc,T}(X)`, with the standard `t`-structure and `Type u`-indexed
direct sums**: weak approximation data on the full subcategory `DqcSupported X T` of `D(𝒪_X)`
whose `t`-structure is the standard one (`Y ∈ t^{≤ 0}` iff `Y ∈ D^{≤ 0}(𝒪_X)`), for direct sums
indexed by the Hom universe `Type (u + 1)`, give weak approximation data on `D_{qc,T}(X)` with the
standard `t`-structure for `Type u`-indexed direct sums (along `toDqcSupported`, then
`exists_paperData_of_max` with Stacks 079Q and 08F3). -/
theorem exists_paperData_dqcZ_standard (h079Q : Tag079QInput.{u}) (h08F3 : Tag08F3Input B S hS)
    (hsum : SupportedDirectSumsInput B S hS) (X : AlgebraicSpaces B S hS)
    [(qcohDerived X).IsTriangulated] (T : Set (points B S hS X.1))
    [ObjectProperty.IsTriangulated (CohomologySupportedOn B S hS X.1 X.2 T)]
    [(DqcSupported X T).IsTriangulated] (hT : IsClosed T)
    (W : SumUniverse.PaperWeakApproximationData.{u + 1} (DqcSupported X T).FullSubcategory)
    (hW : ∀ Y : (DqcSupported X T).FullSubcategory,
      W.t.le 0 Y ↔ (DerivedCategory.TStructure.t (C := Modules.{u, u} B S hS X.1 X.2)).le 0 Y.obj) :
    ∃ W' : SumUniverse.PaperWeakApproximationData.{u} (DqcZ X T),
      W'.t = standardTStructure X T := by
  let e := (toDqcSupported X T).asEquivalence
  let : e.functor.CommShift ℤ := (inferInstance : (toDqcSupported X T).CommShift ℤ)
  have : e.functor.IsTriangulated := (inferInstance : (toDqcSupported X T).IsTriangulated)
  have : e.functor.Additive := ⟨fun {E F f g} => by
    ext
    exact (ιZ X T).map_add⟩
  let := e.commShiftInverse ℤ
  have := e.commShift_of_functor ℤ
  have : e.inverse.IsTriangulated := e.toAdjunction.isTriangulated_rightAdjoint
  have : ∀ n : ℤ, (shiftFunctor (DqcSupported X T).FullSubcategory n).Additive :=
    fun n => inferInstance
  obtain ⟨W₁, hW₁⟩ := GluedPreferred.exists_paperData_of_equivalence e W
  have : LocallySmall.{u} (DqcZ X T) := locallySmall_dqcZ h079Q _ _
  have : HasCoproducts.{u} (DqcZ X T) := hasCoproducts h08F3 hsum _ _ hT
  obtain ⟨W', hW'⟩ := exists_paperData_of_max.{u, u + 1, u + 1, u + 1} W₁
  refine ⟨W', hW'.trans ?_⟩
  apply RelativeWeakApprox.TStructure.ext_le_zero
  funext Y
  apply propext
  rw [hW₁]
  change W.t.le 0 ((toDqcSupported X T).obj Y) ↔ _
  rw [hW, standardTStructure_le_iff_ιZ]
  all_goals exact Iff.rfl

section AffineBase

variable (U : BigFppfOver B S hS) [IsAffine ((BigFppfOver.toScheme B S hS).obj U)]

/-- The associated module `M ↦ M^~` reflects zero objects, from Stacks 06Z0: `Φ` is fully
faithful, `Φ(M[0]) ≅ M^~[0]` and `M ≅ H⁰(M[0])`. -/
theorem isZero_associated_iff (hq : Affine.Tag06Z0QcohInput B S hS)
    (h06Z0 : Affine.Tag06Z0Input B S hS) [PreservesFiniteLimits (Affine.associated U)]
    (N : ModuleCat.{u} Γ((BigFppfOver.toScheme B S hS).obj U, ⊤)) :
    IsZero ((Affine.associated U).obj N) ↔ IsZero N := by
  refine ⟨fun h => ?_, fun h => (Affine.associated U).map_isZero h⟩
  have := Affine.full_derivedAssociated U hq h06Z0
  have := Affine.faithful_derivedAssociated U hq h06Z0
  have h₁ : IsZero ((Affine.derivedAssociated U).obj
      ((DerivedCategory.singleFunctor (ModuleCat.{u} Γ((BigFppfOver.toScheme B S hS).obj U, ⊤))
        0).obj N)) :=
    (Functor.map_isZero (DerivedCategory.singleFunctor _ 0) h).of_iso
      (((Affine.associated U).mapDerivedCategorySingleFunctor 0).app N)
  have h₂ := IsZero.of_full_of_faithful_of_isZero (Affine.derivedAssociated U) _ h₁
  exact ((DerivedCategory.homologyFunctor _ 0).map_isZero h₂).of_iso
    ((DerivedCategory.singleFunctorCompHomologyFunctorIso _ 0).app N).symm

/-- **`Φ : D(R) ⥤ D(𝒪_{h_U})` is `t`-exact for the standard `t`-structures, and reflects them**:
`Φ(M) ∈ D^{≤ n}` iff `M ∈ D^{≤ n}` (`Hⁱ(Φ M) ≅ Hⁱ(M)^~`, and `M ↦ M^~` reflects zero objects).
This identifies the `t`-structure of the affine base case with the standard one. -/
theorem isLE_derivedAssociated_iff (hq : Affine.Tag06Z0QcohInput B S hS)
    (h06Z0 : Affine.Tag06Z0Input B S hS) [PreservesFiniteLimits (Affine.associated U)]
    (M : DerivedCategory (ModuleCat.{u} Γ((BigFppfOver.toScheme B S hS).obj U, ⊤))) (n : ℤ) :
    ((Affine.derivedAssociated U).obj M).IsLE n ↔ M.IsLE n := by
  rw [DerivedCategory.isLE_iff, DerivedCategory.isLE_iff]
  refine forall_congr' fun i => imp_congr_right fun _ => ?_
  exact ((Affine.homologyIso U M i).isZero_iff).trans (isZero_associated_iff U hq h06Z0 _)

-- The elaboration of the instance terms is slow.
set_option synthInstance.maxHeartbeats 400000 in
set_option maxHeartbeats 1000000 in
/-- **Corollary 1.2** (`cor:weak_approx_spaces`), affine base case, **standard W.A.** (Definition
5.3): an affine algebraic space `h_U` satisfies standard W.A.  For `T = V(I)`, `I` finitely
generated (`exists_fg_eq_zeroLocusPoints`), the module model carries weak approximation data with
the standard `t`-structure (`exists_affineData_standard`); they are transported to
`D_{qc,V(I)}(h_U)` along `D_{V(I)}(R) ≌ D_{qc,V(I)}(h_U)` (`Affine.supportedComparison`), whose
transported `t`-structure is the standard one (`isLE_derivedAssociated_iff`), and descended to
`Type u`-indexed direct sums (`exists_paperData_of_max`, Stacks 079Q and 08F3). -/
theorem satisfiesStandardWA_space (hex : Affine.Tag06Z0ExactInput B S hS)
    (hq : Affine.Tag06Z0QcohInput B S hS) (h06Z0 : Affine.Tag06Z0Input B S hS)
    (h07TY : Affine.Tag07TYInput B S hS) (h079Q : Tag079QInput.{u})
    (h08F3 : Tag08F3Input B S hS) (hsum : SupportedDirectSumsInput B S hS)
    [(qcohDerived (Affine.space U)).IsTriangulated]
    [∀ T, ObjectProperty.IsTriangulated
      (CohomologySupportedOn B S hS (Affine.space U).1 (Affine.space U).2 T)] :
    SatisfiesStandardWA (Affine.space U) := by
  intro T hT hTc
  obtain ⟨I, hI, rfl⟩ := exists_fg_eq_zeroLocusPoints U T hT hTc
  have := hex U
  have := Affine.isTriangulated_dqcSupported U hq h06Z0 h07TY I
  obtain ⟨W₀, hW₀⟩ := exists_affineData_standard _ I hI
  -- along `D_{V(I)}(R) ≌ D_{qc,V(I)}(h_U)`
  have := Affine.isEquivalence_supportedComparison U hq h06Z0 h07TY I
  let F := Affine.supportedComparison U hq h07TY I
  let : F.CommShift ℤ :=
    ObjectProperty.commShiftLift (DqcSupported (Affine.space U) (Affine.zeroLocusPoints U I)) _ _
  have : F.IsTriangulated :=
    ObjectProperty.isTriangulated_lift (DqcSupported (Affine.space U) (Affine.zeroLocusPoints U I))
      _ _
  let e₁ := F.asEquivalence
  let : e₁.functor.CommShift ℤ := (inferInstance : F.CommShift ℤ)
  have : e₁.functor.IsTriangulated := (inferInstance : F.IsTriangulated)
  have : e₁.functor.Additive := Functor.IsTriangulated.instAdditive _
  let := e₁.commShiftInverse ℤ
  have : ∀ n : ℤ, (shiftFunctor
      (DqcSupported (Affine.space U) (Affine.zeroLocusPoints U I)).FullSubcategory n).Additive :=
    fun n => inferInstance
  let W₁ := (SumUniverse.paperData_equiv.symm W₀).transport e₁
  -- the transported `t`-structure is the standard one
  refine exists_paperData_dqcZ_standard h079Q h08F3 hsum (Affine.space U) _ hT W₁ fun Y => ?_
  change W₀.t.le 0 (e₁.inverse.obj Y) ↔ _
  rw [hW₀]
  change DerivedCategory.TStructure.t.le 0 (e₁.inverse.obj Y).obj ↔ _
  let M := e₁.inverse.obj Y
  let φ : (Affine.derivedAssociated U).obj M.obj ≅ Y.obj :=
    (DqcSupported (Affine.space U) (Affine.zeroLocusPoints U I)).ι.mapIso (e₁.counitIso.app _)
  have hiff := isLE_derivedAssociated_iff U hq h06Z0 M.obj 0
  constructor
  · intro h
    have h1 : ((Affine.derivedAssociated U).obj M.obj).IsLE 0 :=
      hiff.2 ((DerivedCategory.TStructure.t.le_iff_isLE _ _).1 h)
    exact (DerivedCategory.TStructure.t.le 0).prop_of_iso φ
      ((DerivedCategory.TStructure.t.le_iff_isLE _ _).2 h1)
  · intro h
    have h1 := (DerivedCategory.TStructure.t.le 0).prop_of_iso φ.symm h
    exact (DerivedCategory.TStructure.t.le_iff_isLE _ _).2
      (hiff.1 ((DerivedCategory.TStructure.t.le_iff_isLE _ _).1 h1))

end AffineBase

section Corollary

attribute [local instance] etaleModulePullback_additive preservesFiniteLimits_etaleModulePullback
  preservesFiniteColimits_etaleModulePullback

variable [∀ Y : AlgebraicSpaces B S hS, (qcohDerived Y).IsTriangulated]
  [∀ (Y : AlgebraicSpaces B S hS) T,
    ObjectProperty.IsTriangulated (CohomologySupportedOn B S hS Y.1 Y.2 T)]

/-- **Standard W.A. (Definition 5.3) is invariant under isomorphisms** of quasi-compact
quasi-separated algebraic spaces: Proposition 5.8, standard part (`proposition_5_8_standard`),
applied to the elementary distinguished square `(∅ ⊆ Y, e : X ≅ Y)`, as in
`satisfiesWA_of_iso`. -/
theorem satisfiesStandardWA_of_iso (h08FA : Tag08FAInput B S hS) (h08F4 : Tag08F4Input B S hS)
    (h0AFJ : Tag0AFJInput B S hS) (hpb : PullbackSupportInput B S hS)
    (hdisj : PullbackDisjointInput B S hS) (hres : EtaleRestrictionSupportInput B S hS)
    (hcounit : OpenImmersionCounitInput B S hS) (hperf : PerfectPullbackInput B S hS)
    (h08F3 : Tag08F3Input B S hS) (hsum : SupportedDirectSumsInput B S hS)
    (h0AEC : Tag0AECInput B S hS) (h0AED : Tag0AEDInput B S hS) (h079Q : Tag079QInput.{u})
    (h0A8G : Tag0A8GInput.{u}) (hRAC : RightAdjointCoproductsInput.{u})
    (hqcs : QuasiCompactSourceInput B S hS) (hcpt : CompactComplPreimageInput B S hS)
    (h08GGu : Tag08GGUnitInput B S hS) (h08GGc : Tag08GGCounitInput B S hS)
    (h073B : Tag073BInput B S hS) (h073B2 : Tag073BTwoInput B S hS)
    (h09M8 : Tag09M8Input B S hS) (hbd : PerfectBoundedAboveInput B S hS)
    (h09MB : Tag09MBInput B S hS) (h08FAb : Tag08FABoundInput B S hS)
    (hEDSc : EDSOfComplSubsetInput B S hS) (hempty : SupportEmptyInput B S hS)
    (hqcO : OpenSubspaceQuasiCompactInput B S hS)
    (hZ : B.Contains (⊤_ Scheme.{u})) {X Y : AlgebraicSpaces B S hS} (e : X.1 ≅ Y.1)
    (hXqc : IsQuasiCompactSpace B S hS X.1) (hXqs : IsAbsolutelyQuasiSeparated B S hS hZ X.1)
    (hYqc : IsQuasiCompactSpace B S hS Y.1) (hYqs : IsAbsolutelyQuasiSeparated B S hS hZ Y.1)
    (h : SatisfiesStandardWA X) : SatisfiesStandardWA Y := by
  let U := emptySubspace Y
  have hUe : IsEmpty (points B S hS U.1.toFunctor) := isEmpty_points_emptySpace Y
  have hsq : IsElementaryDistinguishedSquare B S hS Y.2 U.1 e.hom :=
    hEDSc Y.2 U.1 U.2 X.2 e.hom (isOpenImmersion_of_isIso' e.hom)
      (fun y _ => pointsMap_surjective_of_isIso B S hS e.hom y)
  have hUqc : IsQuasiCompactSpace B S hS U.1.toFunctor := hqcO Y.2 U.2 (by
    have hr : Set.range (pointsMap B S hS U.1.toFunctor U.1.ι) = ∅ :=
      Set.eq_empty_iff_forall_notMem.2 fun _ ⟨p, _⟩ => hUe.elim p
    rw [hr]
    exact isCompact_empty)
  exact proposition_5_8_standard h08FA h08F4 h0AFJ hpb hdisj hres hcounit hperf h08F3 hsum h0AEC
    h0AED h079Q h0A8G hRAC hqcs hcpt h08GGu h08GGc h073B h073B2 h09M8 hbd h09MB h08FAb
    hsq hZ hYqc hYqs hUqc hXqc hXqs (satisfiesStandardWA_of_isEmpty hempty _ hUe) h

/-- **Corollary 1.2** (`cor:weak_approx_spaces`), first claim in LP26's stronger form, over
algebraic spaces: a quasi-compact quasi-separated algebraic space `X` satisfies **standard W.A.**
(Definition 5.3): for every closed `S ⊆ |X|` with quasi-compact complement there are weak
approximation data on `D_{qc,S}(X)` whose `t`-structure is the standard one.  This is what LP26's
proof establishes ("We establish standard W.A., which is stronger than the first claim").

As `corollary_1_2`, without LP26's hypothesis of quasi-finite separated diagonal (the induction
starts at the empty open subspace, so only affine spaces enter); the statement is therefore
stronger than the paper's.  Proof: LP26's induction (Stacks 09IT), with Proposition 5.8 in its
standard form (`proposition_5_8_standard`), the affine case `satisfiesStandardWA_space` and
`satisfiesStandardWA_of_iso`. -/
theorem corollary_1_2_standard (h08FA : Tag08FAInput B S hS) (h08F4 : Tag08F4Input B S hS)
    (h0AFJ : Tag0AFJInput B S hS) (hpb : PullbackSupportInput B S hS)
    (hdisj : PullbackDisjointInput B S hS) (hres : EtaleRestrictionSupportInput B S hS)
    (hcounit : OpenImmersionCounitInput B S hS) (hperf : PerfectPullbackInput B S hS)
    (h08F3 : Tag08F3Input B S hS) (hsum : SupportedDirectSumsInput B S hS)
    (h0AEC : Tag0AECInput B S hS) (h0AED : Tag0AEDInput B S hS) (h079Q : Tag079QInput.{u})
    (h0A8G : Tag0A8GInput.{u}) (hRAC : RightAdjointCoproductsInput.{u})
    (hqcs : QuasiCompactSourceInput B S hS) (hcpt : CompactComplPreimageInput B S hS)
    (h08GGu : Tag08GGUnitInput B S hS) (h08GGc : Tag08GGCounitInput B S hS)
    (h073B : Tag073BInput B S hS) (h073B2 : Tag073BTwoInput B S hS)
    (h09M8 : Tag09M8Input B S hS) (hbd : PerfectBoundedAboveInput B S hS)
    (h09MB : Tag09MBInput B S hS) (h08FAb : Tag08FABoundInput B S hS)
    (hEDSc : EDSOfComplSubsetInput B S hS) (hempty : SupportEmptyInput B S hS)
    (hqcO : OpenSubspaceQuasiCompactInput B S hS) (h09IT : Tag09ITInput B S hS)
    (hqsAff : AffineQuasiSeparatedInput B S hS)
    (hex : Affine.Tag06Z0ExactInput B S hS) (hq : Affine.Tag06Z0QcohInput B S hS)
    (h06Z0 : Affine.Tag06Z0Input B S hS) (h07TY : Affine.Tag07TYInput B S hS)
    (hZ : B.Contains (⊤_ Scheme.{u})) (X : AlgebraicSpaces B S hS)
    (hXqc : IsQuasiCompactSpace B S hS X.1) (hXqs : IsAbsolutelyQuasiSeparated B S hS hZ X.1) :
    SatisfiesStandardWA X := by
  have qsSub : ∀ (W : Subfunctor X.1) (hW : IsAlgebraicSpace B S hS W.toFunctor),
      IsAbsolutelyQuasiSeparated B S hS hZ W.toFunctor := fun W hW =>
    isAbsolutelyQuasiSeparated_of_isQuasiSeparated B S hS hZ hW hXqs (isQuasiSeparated_of_mono' W.ι)
  let P : Subfunctor X.1 → Prop := fun W => ∀ hW : IsOpenSubspace B S hS W,
    IsQuasiCompactSpace B S hS W.toFunctor → SatisfiesStandardWA ⟨W.toFunctor, hW.1⟩
  have hE : IsEmpty (points B S hS (emptySubspace X).1.toFunctor) := isEmpty_points_emptySpace X
  have hEqc : IsQuasiCompactSpace B S hS (emptySubspace X).1.toFunctor :=
    hqcO X.2 (emptySubspace X).2 (by
      have hr : Set.range (pointsMap B S hS _ (emptySubspace X).1.ι) = ∅ :=
        Set.eq_empty_iff_forall_notMem.2 fun _ ⟨p, _⟩ => hE.elim p
      rw [hr]
      exact isCompact_empty)
  have hPE : P (emptySubspace X).1 := fun _ _ => satisfiesStandardWA_of_isEmpty hempty _ hE
  have hstep : ∀ (W₁ W₂ : Subfunctor X.1), IsOpenSubspace B S hS W₁ →
      ∀ (hW₂ : IsOpenSubspace B S hS W₂),
      IsQuasiCompactSpace B S hS W₁.toFunctor →
      IsQuasiCompactSpace B S hS W₂.toFunctor →
      ∀ hle : W₁ ≤ W₂, (emptySubspace X).1 ≤ W₁ →
      ∀ {V : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} (f : V ⟶ W₂.toFunctor),
        (∃ T : BigFppfOver B S hS,
          IsAffine ((BigFppfOver.toScheme B S hS).obj T) ∧ Nonempty (V ≅ yoneda.obj T)) →
        IsElementaryDistinguishedSquare B S hS hW₂.1
          (Subfunctor.range (Subfunctor.homOfLe hle)) f →
        P W₁ → P W₂ := by
    intro W₁ W₂ hW₁ hW₂ hqc₁ hqc₂ hle _ V f hVaff hsq₀ hP₁ _ _
    let X₂ : AlgebraicSpaces B S hS := ⟨W₂.toFunctor, hW₂.1⟩
    have hsq : IsElementaryDistinguishedSquare B S hS X₂.2
        (Subfunctor.range (Subfunctor.homOfLe hle)) f := hsq₀
    let eU : W₁.toFunctor ≅ (Subfunctor.range (Subfunctor.homOfLe hle)).toFunctor :=
      asIso (Subfunctor.toRange (Subfunctor.homOfLe hle))
    have hUqc := IsQuasiCompactSpace.of_iso B S hS hqc₁ eU
    have hUqs : IsAbsolutelyQuasiSeparated B S hS hZ
        (Subfunctor.range (Subfunctor.homOfLe hle)).toFunctor :=
      isAbsolutelyQuasiSeparated_of_isQuasiSeparated B S hS hZ hsq.isOpenSubspace.1
        (qsSub W₂ hW₂.1) (isQuasiSeparated_of_mono' (Subfunctor.range (Subfunctor.homOfLe hle)).ι)
    have hU : SatisfiesStandardWA (edsOpenSpace hsq) :=
      satisfiesStandardWA_of_iso h08FA h08F4 h0AFJ hpb hdisj hres hcounit hperf h08F3 hsum h0AEC
        h0AED h079Q h0A8G hRAC hqcs hcpt h08GGu h08GGc h073B h073B2 h09M8 hbd h09MB h08FAb
        hEDSc hempty hqcO hZ (X := ⟨W₁.toFunctor, hW₁.1⟩) (Y := edsOpenSpace hsq) eU hqc₁
        (qsSub W₁ hW₁.1) hUqc hUqs (hP₁ hW₁ hqc₁)
    obtain ⟨T, hT, ⟨eV⟩⟩ := hVaff
    have hTqc : IsQuasiCompactSpace B S hS (yoneda.obj T) :=
      isQuasiCompact_yoneda_of_compact B S hS T inferInstance
    have hTqs := hqsAff hZ T hT
    have hVqc : IsQuasiCompactSpace B S hS V := IsQuasiCompactSpace.of_iso B S hS hTqc eV.symm
    have hVqs : IsAbsolutelyQuasiSeparated B S hS hZ V :=
      isAbsolutelyQuasiSeparated_of_isQuasiSeparated B S hS hZ hsq.isAlgebraicSpace hTqs
        (isQuasiSeparated_of_mono' eV.hom)
    have hY : SatisfiesStandardWA (edsEtaleSpace hsq) :=
      satisfiesStandardWA_of_iso h08FA h08F4 h0AFJ hpb hdisj hres hcounit hperf h08F3 hsum h0AEC
        h0AED h079Q h0A8G hRAC hqcs hcpt h08GGu h08GGc h073B h073B2 h09M8 hbd h09MB h08FAb
        hEDSc hempty hqcO hZ (X := Affine.space T) (Y := edsEtaleSpace hsq) eV.symm
        hTqc hTqs hVqc hVqs
        (satisfiesStandardWA_space T hex hq h06Z0 h07TY h079Q h08F3 hsum)
    exact proposition_5_8_standard h08FA h08F4 h0AFJ hpb hdisj hres hcounit hperf h08F3 hsum h0AEC
      h0AED h079Q h0A8G hRAC hqcs hcpt h08GGu h08GGc h073B h073B2 h09M8 hbd h09MB h08FAb
      (X := X₂) hsq hZ hqc₂ (qsSub W₂ hW₂.1) hUqc hVqc hVqs hU hY
  have hTop := h09IT hZ X hXqc hXqs (emptySubspace X).1 (emptySubspace X).2 hEqc P hPE hstep
  have hTqc : IsQuasiCompactSpace B S hS (⊤ : Subfunctor X.1).toFunctor :=
    IsQuasiCompactSpace.of_iso B S hS hXqc (asIso (⊤ : Subfunctor X.1).ι).symm
  exact satisfiesStandardWA_of_iso h08FA h08F4 h0AFJ hpb hdisj hres hcounit hperf h08F3 hsum h0AEC
    h0AED h079Q h0A8G hRAC hqcs hcpt h08GGu h08GGc h073B h073B2 h09M8 hbd h09MB h08FAb
    hEDSc hempty hqcO hZ (X := ⟨(⊤ : Subfunctor X.1).toFunctor, (isOpenSubspace_top X.2).1⟩)
    (Y := X) (asIso (⊤ : Subfunctor X.1).ι) hTqc (qsSub ⊤ (isOpenSubspace_top X.2).1)
    hXqc hXqs (hTop (isOpenSubspace_top X.2) hTqc)

end Corollary

section CorollaryNonVacuity

/-- **Non-vacuity of `corollary_1_2_standard`**: for an object `T₀` of the site with affine,
non-empty underlying scheme, `X = h_{T₀}` has a point, is quasi-compact and quasi-separated, the
instance arguments hold (Stacks 06UQ, `SupportTriangulatedInput`), and `X` satisfies standard
W.A.  Such a `T₀` exists (`corollary_1_2_int_witness`, `Spec ℤ`). -/
theorem corollary_1_2_standard_nonVacuity (h06 : Tag06UQInput B S hS)
    (hsuppT : SupportTriangulatedInput B S hS) (hterm : ContainsTerminalInput.{u})
    (h08FA : Tag08FAInput B S hS) (h08F4 : Tag08F4Input B S hS)
    (h0AFJ : Tag0AFJInput B S hS) (hpb : PullbackSupportInput B S hS)
    (hdisj : PullbackDisjointInput B S hS) (hres : EtaleRestrictionSupportInput B S hS)
    (hcounit : OpenImmersionCounitInput B S hS) (hperf : PerfectPullbackInput B S hS)
    (h08F3 : Tag08F3Input B S hS) (hsum : SupportedDirectSumsInput B S hS)
    (h0AEC : Tag0AECInput B S hS) (h0AED : Tag0AEDInput B S hS) (h079Q : Tag079QInput.{u})
    (h0A8G : Tag0A8GInput.{u}) (hRAC : RightAdjointCoproductsInput.{u})
    (hqcs : QuasiCompactSourceInput B S hS) (hcpt : CompactComplPreimageInput B S hS)
    (h08GGu : Tag08GGUnitInput B S hS) (h08GGc : Tag08GGCounitInput B S hS)
    (h073B : Tag073BInput B S hS) (h073B2 : Tag073BTwoInput B S hS)
    (h09M8 : Tag09M8Input B S hS) (hbd : PerfectBoundedAboveInput B S hS)
    (h09MB : Tag09MBInput B S hS) (h08FAb : Tag08FABoundInput B S hS)
    (hEDSc : EDSOfComplSubsetInput B S hS) (hempty : SupportEmptyInput B S hS)
    (hqcO : OpenSubspaceQuasiCompactInput B S hS) (h09IT : Tag09ITInput B S hS)
    (hqsAff : AffineQuasiSeparatedInput B S hS)
    (hex : Affine.Tag06Z0ExactInput B S hS) (hq : Affine.Tag06Z0QcohInput B S hS)
    (h06Z0 : Affine.Tag06Z0Input B S hS) (h07TY : Affine.Tag07TYInput B S hS)
    (T₀ : BigFppfOver B S hS) (hT₀ : IsAffine ((BigFppfOver.toScheme B S hS).obj T₀))
    (hne : Nonempty ((BigFppfOver.toScheme B S hS).obj T₀)) :
    Nonempty (points B S hS (Affine.space T₀).1) ∧
      IsQuasiCompactSpace B S hS (Affine.space T₀).1 ∧
      IsAbsolutelyQuasiSeparated B S hS (hterm B) (Affine.space T₀).1 ∧
      haveI := isTriangulated_qcohDerived h06 (Affine.space T₀)
      haveI := isTriangulated_support hsuppT (Affine.space T₀)
      SatisfiesStandardWA (Affine.space T₀) := by
  obtain ⟨hqc, hqs', -, -⟩ := nonVacuity_affine_univ hqsAff (hterm B) T₀ hT₀
  have : ∀ Y : AlgebraicSpaces B S hS, (qcohDerived Y).IsTriangulated :=
    fun Y => isTriangulated_qcohDerived h06 Y
  have : ∀ (Y : AlgebraicSpaces B S hS) T,
      ObjectProperty.IsTriangulated (CohomologySupportedOn B S hS Y.1 Y.2 T) :=
    fun Y => isTriangulated_support hsuppT Y
  refine ⟨⟨(schemePointsHomeomorph B S hS T₀).symm hne.some⟩, hqc, hqs', ?_⟩
  exact corollary_1_2_standard h08FA h08F4 h0AFJ hpb hdisj hres hcounit hperf h08F3 hsum h0AEC
    h0AED h079Q h0A8G hRAC hqcs hcpt h08GGu h08GGc h073B h073B2 h09M8 hbd h09MB h08FAb hEDSc
    hempty hqcO h09IT hqsAff hex hq h06Z0 h07TY (hterm B) (Affine.space T₀) hqc hqs'

end CorollaryNonVacuity

