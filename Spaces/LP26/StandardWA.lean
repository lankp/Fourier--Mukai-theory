/-- `E ∈ D^{≤ n}_{qc,T}(X)` iff its underlying object of `D(𝒪_X)` is in the standard
`D^{≤ n}`. -/
theorem standardTStructure_le_iff_ιZ (X : AlgebraicSpaces B S hS) [(qcohDerived X).IsTriangulated]
    (T : Set (points B S hS X.1))
    [ObjectProperty.IsTriangulated (CohomologySupportedOn B S hS X.1 X.2 T)]
    (E : DqcZ X T) (n : ℤ) :
    (standardTStructure X T).le n E ↔
      (DerivedCategory.TStructure.t (C := Modules.{u, u} B S hS X.1 X.2)).le n
        ((ιZ X T).obj E) :=
  ((standardTStructure X T).le_iff_isLE E n).trans
    ((standardTStructure_isLE_iff X T E n).trans
      ((DerivedCategory.TStructure.t.le_iff_isLE _ n).symm))

/-- **An algebraic space with no points satisfies standard W.A.** (Definition 5.3): every
`D_{qc,T}` is zero (Stacks 04K5), and in a zero category every `t`-structure, in particular the
standard one, carries weak approximation data. -/
theorem satisfiesStandardWA_of_isEmpty (hempty : SupportEmptyInput B S hS)
    (Y : AlgebraicSpaces B S hS) [(qcohDerived Y).IsTriangulated]
    [∀ T, ObjectProperty.IsTriangulated (CohomologySupportedOn B S hS Y.1 Y.2 T)]
    (h : IsEmpty (points B S hS Y.1)) : SatisfiesStandardWA Y := fun T _ _ =>
  GluedPreferred.exists_paperData_eq_of_forall_isZero (fun E => by
    refine IsZero.of_full_of_faithful_of_isZero (ιZ Y T) E ?_
    have hH : ∀ i : ℤ, IsZero ((DerivedCategory.homologyFunctor
        (Modules.{u, u} B S hS Y.1 Y.2) i).obj E.obj.obj) := fun i =>
      (hempty Y _).1 (Set.eq_empty_of_isEmpty _)
    have : E.obj.obj.IsLE 0 := (DerivedCategory.isLE_iff _ _).2 fun i _ => hH i
    have : E.obj.obj.IsGE 1 := (DerivedCategory.isGE_iff _ _).2 fun i _ => hH i
    exact DerivedCategory.TStructure.t.isZero E.obj.obj 0 1) _

