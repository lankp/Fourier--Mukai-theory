/-! ### LP26 Theorem 1.1 -/

section Theorem11Univ

variable {DZ : Type uZ} {D : Type uD} {DU : Type uU}
  [Category.{vZ} DZ] [Category.{vD} D] [Category.{vU} DU]
  [Preadditive DZ] [Preadditive D] [Preadditive DU]
  [HasZeroObject DZ] [HasZeroObject D] [HasZeroObject DU]
  [HasShift DZ ℤ] [HasShift D ℤ] [HasShift DU ℤ]
  [∀ (n : ℤ), (shiftFunctor DZ n).Additive]
  [∀ (n : ℤ), (shiftFunctor D n).Additive]
  [∀ (n : ℤ), (shiftFunctor DU n).Additive]
  [Pretriangulated DZ] [Pretriangulated D] [Pretriangulated DU]
  [IsTriangulated DZ] [IsTriangulated D] [IsTriangulated DU]
  [LocallySmall.{w} DZ] [LocallySmall.{w} D] [LocallySmall.{w} DU]
  [HasCoproducts.{w} DZ] [HasCoproducts.{w} D] [HasCoproducts.{w} DU]

/-- **LP26 Theorem 1.1** (`thm:glueing_weak_approx`), **for a coproduct universe `w`
independent of the Hom universes**.  Let `D_Z → D → D_U` be a recollement of triangulated
categories whose morphism types are `w`-small and which have `Type w`-indexed direct sums, with
`D_Z` and `D_U` weakly approximable, and let `G'` be a compact generator of `D`.  Then `D` is
weakly approximable if and only if `Hom(G', G'[n]) = 0` for all `n ≫ 0`.

Lean rendering: as in `theorem_1_1`, with direct sums indexed by `Type w`:
`HasCoproducts.{w}`, compactness `SumUniverse.IsCompactAb.{w}` (Stacks 07LS against
`Type w`-indexed sums; AxiomMath's `IsCompactObject.{w}`), weak approximability
`SumUniverse.SatisfiesPaperWA.{w}` (Definition 2.1 with `SumUniverse.envelope.{w}`).  The
three categories may have different Hom universes `vZ`, `vD`, `vU`.  "Hom sets are sets" is
`LocallySmall.{w}`, automatic at `w = v` (`theorem_1_1` is that case).  This is the form that
applies to AxiomMath's `D(𝒪_X)`: morphisms in `Type (u + 1)`, direct sums over `Type u`,
`w = u` (`theorem_1_1_univ_zero_D`).

Proof: each category is replaced by a triangulated model with morphisms in `Type w`
(`SumUniverse.exists_triangulatedEquivalence_of_locallySmall`, the localization of the category
at its isomorphisms); the recollement, weak approximability, compactness, zero detection and
the Hom vanishing transport along the equivalences (`WeakApprox/SumUniverseTransport.lean`), and
`PaperHypothesesW6.theorem_1_1_paper` applies to the models, with Stacks 09SR from
AxiomMath/Stacks (`tag09SR_paperForm`). -/
theorem theorem_1_1_univ (R : Recollement DZ D DU)
    (hZ : SumUniverse.SatisfiesPaperWA.{w} DZ) (hU : SumUniverse.SatisfiesPaperWA.{w} DU)
    (G' : D) (hG'c : SumUniverse.IsCompactAb.{w} G') (hG'g : IsPaperGenerator G') :
    SumUniverse.SatisfiesPaperWA.{w} D ↔
      ∃ N : ℤ, ∀ n : ℤ, N ≤ n → ∀ f : G' ⟶ G'⟦n⟧, f = 0 := by
  obtain ⟨DZ', _, _, _, _, _, _, eZ, _, _, _, _, _, _, hZ'⟩ :=
    SumUniverse.exists_triangulatedEquivalence_of_locallySmall.{w} DZ
  obtain ⟨D', _, _, _, _, _, _, eD, _, _, _, _, _, _, hD'⟩ :=
    SumUniverse.exists_triangulatedEquivalence_of_locallySmall.{w} D
  obtain ⟨DU', _, _, _, _, _, _, eU, _, _, _, _, _, _, hU'⟩ :=
    SumUniverse.exists_triangulatedEquivalence_of_locallySmall.{w} DU
  have := hZ' inferInstance
  have := hD' inferInstance
  have := hU' inferInstance
  have : HasCoproducts.{w} DZ' := SumUniverse.hasCoproducts_of_equivalence eZ
  have : HasCoproducts.{w} D' := SumUniverse.hasCoproducts_of_equivalence eD
  have : HasCoproducts.{w} DU' := SumUniverse.hasCoproducts_of_equivalence eU
  have key := PaperHypothesesW6.theorem_1_1_paper (SumUniverse.Recollement.transport eZ eD eU R)
    ((SumUniverse.satisfiesPaperWA_iff DZ').1
      ((SumUniverse.satisfiesPaperWA_iff_of_equivalence eZ).1 hZ))
    ((SumUniverse.satisfiesPaperWA_iff DU').1
      ((SumUniverse.satisfiesPaperWA_iff_of_equivalence eU).1 hU))
    (eD.functor.obj G')
    ((SumUniverse.isCompactAb_iff _).1 ((SumUniverse.isCompactAb_functor_obj_iff eD G').2 hG'c))
    ((SumUniverse.isPaperGenerator_functor_obj_iff eD G').2 hG'g)
    (tag09SR_paperForm D') (tag09SR_paperForm DZ')
  rw [SumUniverse.satisfiesPaperWA_iff_of_equivalence eD, SumUniverse.satisfiesPaperWA_iff, key]
  simp only [SumUniverse.homShift_vanishing_iff]

end Theorem11Univ

section Theorem11

variable {DZ : Type uZ} {D : Type uD} {DU : Type uU}
  [Category.{v} DZ] [Category.{v} D] [Category.{v} DU]
  [Preadditive DZ] [Preadditive D] [Preadditive DU]
  [HasZeroObject DZ] [HasZeroObject D] [HasZeroObject DU]
  [HasShift DZ ℤ] [HasShift D ℤ] [HasShift DU ℤ]
  [∀ (n : ℤ), (shiftFunctor DZ n).Additive]
  [∀ (n : ℤ), (shiftFunctor D n).Additive]
  [∀ (n : ℤ), (shiftFunctor DU n).Additive]
  [Pretriangulated DZ] [Pretriangulated D] [Pretriangulated DU]
  [IsTriangulated DZ] [IsTriangulated D] [IsTriangulated DU]
  [HasCoproducts.{v} DZ] [HasCoproducts.{v} D] [HasCoproducts.{v} DU]

/-- **LP26 Theorem 1.1** (`thm:glueing_weak_approx`).  Let `D_Z → D → D_U` be a
recollement of triangulated categories with small coproducts, with `D_Z` and `D_U` weakly
approximable, and let `G'` be a compact generator of `D`.  Then `D` is weakly approximable
if and only if `Hom(G', G'[n]) = 0` for all `n ≫ 0`.

Lean rendering as in `PaperHypothesesW6.theorem_1_1_paper`: compact generation of `D` by
`G'` is `IsCompactAb G'` and `IsPaperGenerator G'` (LP26 §2.1.2); weak approximability is
`SatisfiesPaperWA` (Definition 2.1).  Direct sums are indexed by the Hom universe `v`.  This
is the case `w = v` of `theorem_1_1_univ` (from which it is proved, through
`SumUniverse.satisfiesPaperWA_iff` and `SumUniverse.isCompactAb_iff`); Stacks Tag 09SR, which
LP26 §2.1.2 cites, is a theorem of AxiomMath/Stacks (`tag09SR_paperForm`); the statement has
the paper's hypotheses only. -/
theorem theorem_1_1 (R : Recollement DZ D DU)
    (hZ : SatisfiesPaperWA DZ) (hU : SatisfiesPaperWA DU)
    (G' : D) (hG'c : IsCompactAb G') (hG'g : IsPaperGenerator G') :
    SatisfiesPaperWA D ↔ ∃ N : ℤ, ∀ n : ℤ, N ≤ n → ∀ f : G' ⟶ G'⟦n⟧, f = 0 := by
  have h := theorem_1_1_univ.{v} R ((SumUniverse.satisfiesPaperWA_iff DZ).2 hZ)
    ((SumUniverse.satisfiesPaperWA_iff DU).2 hU) G' ((SumUniverse.isCompactAb_iff G').2 hG'c)
    hG'g
  rwa [SumUniverse.satisfiesPaperWA_iff] at h

end Theorem11

/-- **LP26 Theorem 1.1** (`thm:glueing_weak_approx`), non-vacuity: for every triangulated
`C`, the trivial recollement `0 → ZeroSub C → ZeroSub C` meets every hypothesis of
`theorem_1_1` (`PaperHypothesesW6.NonVacuity.theorem_1_1_paper_zero`). -/
theorem theorem_1_1_zero (C : Type u) [Category.{v} C] [Preadditive C]
    [HasZeroObject C] [HasShift C ℤ] [∀ n : ℤ, (shiftFunctor C n).Additive]
    [Pretriangulated C] [IsTriangulated C] :
    SatisfiesPaperWA (PaperHypothesesW6.NonVacuity.ZeroSub C) ↔ ∃ N : ℤ, ∀ n : ℤ, N ≤ n →
      ∀ f : (⟨0, isZero_zero C⟩ : PaperHypothesesW6.NonVacuity.ZeroSub C) ⟶
        (⟨0, isZero_zero C⟩ : PaperHypothesesW6.NonVacuity.ZeroSub C)⟦n⟧, f = 0 :=
  PaperHypothesesW6.NonVacuity.theorem_1_1_paper_zero C

/-- **LP26 Theorem 1.1** for a coproduct universe `w` (`theorem_1_1_univ`), non-vacuity: for
every triangulated `C`, with **any** Hom universe `v` and any coproduct universe `w`, the trivial
recollement `0 → ZeroSub C → ZeroSub C` meets every hypothesis of `theorem_1_1_univ` at `w`
(`ZeroSub C` has `w`-small morphism types, `Type w`-indexed coproducts, and is weakly
approximable for `w`).  At `C = D(𝒪_X)`, `v = u + 1`, `w = u`: `theorem_1_1_univ_zero_D`
(`Spaces/Stacks/UniverseNonVacuity.lean`). -/
theorem theorem_1_1_univ_zero (C : Type u) [Category.{v} C] [Preadditive C]
    [HasZeroObject C] [HasShift C ℤ] [∀ n : ℤ, (shiftFunctor C n).Additive]
    [Pretriangulated C] [IsTriangulated C] :
    SumUniverse.SatisfiesPaperWA.{w} (PaperHypothesesW6.NonVacuity.ZeroSub C) ↔
      ∃ N : ℤ, ∀ n : ℤ, N ≤ n →
        ∀ f : (⟨0, isZero_zero C⟩ : PaperHypothesesW6.NonVacuity.ZeroSub C) ⟶
          (⟨0, isZero_zero C⟩ : PaperHypothesesW6.NonVacuity.ZeroSub C)⟦n⟧, f = 0 :=
  theorem_1_1_univ.{w}
    (PaperHypothesesW6.NonVacuity.trivialRecollement (PaperHypothesesW6.NonVacuity.ZeroSub C))
    (PaperHypothesesW6.NonVacuity.zeroSub_satisfiesPaperWA_univ _)
    (PaperHypothesesW6.NonVacuity.zeroSub_satisfiesPaperWA_univ C) _
    (SumUniverse.isCompactAb_of_isZero (PaperHypothesesW6.NonVacuity.zeroSub_isZero _))
    (fun {E} _ => PaperHypothesesW6.NonVacuity.zeroSub_isZero E)

/-- **LP26 Theorem 1.1** (`thm:glueing_weak_approx`), non-vacuity with a nonzero middle
term: for every commutative ring `A`, the trivial recollement `0 → D(A) → D(A)` of the
small-Hom derived category `D(A-Mod)`, with `G'` the regular module, meets every
hypothesis of `theorem_1_1`.  Formerly `PaperHypothesesW6.NonVacuity.theorem_1_1_paper_affine`
left Stacks 09SR for `D(A)` as a hypothesis; it is now discharged by AxiomMath. -/
theorem theorem_1_1_affine (A : Type u) [CommRing A] :
    SatisfiesPaperWA
        (RelativeFM.SmallAffineD A (RelativeFM.Spaltenstein.affineSpaltensteinInput A)) ↔
      ∃ N : ℤ, ∀ n : ℤ, N ≤ n →
        ∀ f : (RelativeFM.AffineNeemanEndpointM3.smallRegularModulePaperData A
            (RelativeFM.Spaltenstein.affineSpaltensteinInput A)).G ⟶
          (RelativeFM.AffineNeemanEndpointM3.smallRegularModulePaperData A
            (RelativeFM.Spaltenstein.affineSpaltensteinInput A)).G⟦n⟧, f = 0 := by
  have : HasCoproducts.{u}
      (RelativeFM.SmallAffineD A (RelativeFM.Spaltenstein.affineSpaltensteinInput A)) :=
    RelativeFM.smallAffineHasCoproductsOfUnivLE A _
  exact PaperHypothesesW6.NonVacuity.theorem_1_1_paper_affine A (tag09SR_paperForm _)

/-! ### GL26 Lemmas 2.4 and 2.5 -/

section Lemma24

variable {C : Type u₁} [Category.{v₁} C]
  [HasZeroObject C] [HasShift C ℤ] [Preadditive C]
  [∀ (n : ℤ), (shiftFunctor C n).Additive] [Pretriangulated C] [HasCoproducts.{v₁} C]

/-- **Lemma 2.4** (`lem:localizing_iff_cpt_gen`).  Let `C` be a pretriangulated category
with small (`Type v₁`-indexed) coproducts and `G` a compact object (`IsCompactAb`).  Then
`G` compactly generates `C` (zero detection by the shifts of `G`, `IsPaperGenerator G`)
if and only if `⟨G⟩‾ = C` (the localizing closure of `G` is everything).

From `RelativeFM.lemma_2_4`, whose Stacks 09SN hypothesis is now a theorem of
AxiomMath/Stacks (`tag09SN`).  As there, the paper's additional assumption that `C` is
compactly generated is not needed. -/
theorem lemma_2_4 {G : C} (hG : IsCompactAb G) :
    IsPaperGenerator G ↔
      RelativeFM.ObjectProperty.localizingClosure.{v₁} (ObjectProperty.singleton G) = ⊤ :=
  RelativeFM.lemma_2_4 (tag09SN C) hG

/-- **Lemma 2.4** (`lem:localizing_iff_cpt_gen`) in the language of Lemma 2.5: `G` is a
single compact generator in the sense of `SinglyCompactlyGenerated` (compact and
`⟨G⟩‾ = C`) iff it is compact and detects zero through its shifts (GL26 §2.1).  Stacks
09SN discharged by AxiomMath/Stacks. -/
theorem singlyCompactlyGenerated_iff (G : C) :
    SinglyCompactlyGenerated C G ↔ IsCompactAb G ∧ IsPaperGenerator G :=
  RelativeFM.singlyCompactlyGenerated_iff (tag09SN C) G

end Lemma24

section Lemma25

variable {C : Type u₁} [Category.{v₁} C]
  [HasZeroObject C] [HasShift C ℤ] [Preadditive C]
  [∀ (n : ℤ), (shiftFunctor C n).Additive] [Pretriangulated C] [HasCoproducts.{v₁} C]
  {D : Type u₁} [Category.{v₁} D] [HasZeroObject D] [HasShift D ℤ] [Preadditive D]
  [∀ (n : ℤ), (shiftFunctor D n).Additive] [Pretriangulated D] [HasCoproducts.{v₁} D]

/-- **Lemma 2.5** (`lem:equivalence_or_fully_faithful_via_compacts`) with the paper's
hypothesis "compactly generated by a single object" read as in GL26 §2.1: `GT` and `GS`
are compact (`IsCompactAb`) and detect zero objects through their shifts
(`IsPaperGenerator`), both categories having small coproducts.  For `F ⊣ G` with `F`
exact and `G` preserving small coproducts, `F` is an equivalence iff its restriction to
compact objects is.  From `RelativeFM.lemma_2_5_of_tag09SN`, whose two Stacks 09SN
hypotheses are now theorems of AxiomMath/Stacks (`tag09SN`). -/
theorem lemma_2_5 {F : C ⥤ D} {G : D ⥤ C} (adj : F ⊣ G)
    (GT : C) (hGTc : IsCompactAb GT) (hGTg : IsPaperGenerator GT)
    (GS : D) (hGSc : IsCompactAb GS) (hGSg : IsPaperGenerator GS)
    [∀ (J : Type v₁), PreservesColimitsOfShape (Discrete J) G]
    [F.CommShift ℤ] [F.IsTriangulated] :
    F.IsEquivalence ↔ (Adjunction.compactRestriction adj).IsEquivalence :=
  RelativeFM.lemma_2_5_of_tag09SN (tag09SN C) (tag09SN D) adj GT hGTc hGTg GS hGSc hGSg

end Lemma25

/-- Non-vacuity of the hypothesis of **Lemma 2.5**
(`lem:equivalence_or_fully_faithful_via_compacts`): for every commutative ring `A`, the
regular module singly compactly generates the small-Hom derived category `D(A)`
(`RelativeFM.singlyCompactlyGenerated_smallRingObject`, whose 09SN hypothesis is now
discharged). -/
theorem singlyCompactlyGenerated_smallRingObject (A : Type u) [CommRing A] :
    SinglyCompactlyGenerated (SmallAffineD A (Spaltenstein.affineSpaltensteinInput A))
      (smallRingObject A (Spaltenstein.affineSpaltensteinInput A)) := by
  have := smallAffineHasCoproducts A (Spaltenstein.affineSpaltensteinInput A)
  exact RelativeFM.singlyCompactlyGenerated_smallRingObject A (tag09SN _)

/-! ### Neeman 2024, Theorem 3.2(i), small-Hom affine model -/

section SmallAffine

variable (A : Type u) [CommRing A] (H : AffineSpaltensteinInput A)

/-- **Neeman 2024, Theorem 3.2(i)**, compact ⇒ perfect, affine case, small-Hom model
`SmallAffineD A H`: every compact object lies in `SmallPerf A H`, the thick envelope of
`A[0]`.  From `Neeman32Inputs.smallPerf_of_isCompactAb`, whose Stacks 09SR hypothesis is
now a theorem of AxiomMath/Stacks (`tag09SRPaper`).  A statement about the affine model,
not GL26's result over algebraic spaces. -/
theorem smallPerf_of_isCompactAb {X : SmallAffineD A H} (hX : IsCompactAb X) :
    SmallPerf A H X :=
  Neeman32Inputs.smallPerf_of_isCompactAb A H (tag09SRPaper _) hX

/-- **Neeman 2024, Theorem 3.2(i)**, affine case, small-Hom model: compact ⇔
`SmallPerf A H`, with no hypothesis (Stacks 09SR from AxiomMath/Stacks). -/
theorem smallAffine_neeman_3_2_i :
    ∀ X : SmallAffineD A H, IsCompactAb X ↔ SmallPerf A H X :=
  Neeman32Inputs.smallAffine_neeman_3_2_i A H (tag09SRPaper _)

/-- Compact objects of the small-Hom affine model have eventually vanishing positive
Homs, with no hypothesis (`smallCompactHomZeroAtTop_of_tag09SR`, Stacks 09SR from
AxiomMath/Stacks). -/
theorem smallCompactHomZeroAtTop :
    RelativeWeakApprox.CompactHomZeroAtTop (SmallAffineD A H) :=
  smallCompactHomZeroAtTop_of_tag09SR A H (tag09SRPaper _)

/-- The small-Hom affine package (paper weak approximability, preferred class, compact ⇔
`SmallPerf`), with no hypothesis
(`AffineNeemanEndpointM3.small_affine_regularGenerator_package`, Stacks 09SR from
AxiomMath/Stacks). -/
theorem small_affine_regularGenerator_package :
    PaperM2.SatisfiesPaperWA (SmallAffineD A H) ∧
      NeemanPreferredM6.InPreferredClass (NeemanGeneratorM5.smallStandardTStructure A H) ∧
      ∀ X : SmallAffineD A H, IsCompactAb X ↔ SmallPerf A H X :=
  AffineNeemanEndpointM3.small_affine_regularGenerator_package A H (tag09SRPaper _)

end SmallAffine

/-- Non-vacuity at a concrete ring: `theorem_1_1_affine` over `ℤ`. -/
example : SatisfiesPaperWA
      (RelativeFM.SmallAffineD ℤ (RelativeFM.Spaltenstein.affineSpaltensteinInput ℤ)) ↔
    ∃ N : ℤ, ∀ n : ℤ, N ≤ n →
      ∀ f : (RelativeFM.AffineNeemanEndpointM3.smallRegularModulePaperData ℤ
          (RelativeFM.Spaltenstein.affineSpaltensteinInput ℤ)).G ⟶
        (RelativeFM.AffineNeemanEndpointM3.smallRegularModulePaperData ℤ
          (RelativeFM.Spaltenstein.affineSpaltensteinInput ℤ)).G⟦n⟧, f = 0 :=
  theorem_1_1_affine ℤ

end RelativeFM.Spaces.Stacks

