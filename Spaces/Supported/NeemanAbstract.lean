import FourierMukai.Scheme.NeemanPreferred
import StacksFrontier.CategoryTheory.Triangulated.CompactObjects.ThickSubcategory
import WeakApprox.CompactlyGeneratedTStructure

/-!
# Uniform detection of boundedness below and Neeman's preferred equivalence class

The categorical part of the preferred-class clause of GL26 **Lemma A.9**
(`lem:preferred_eq_class`), that is, of Neeman, *Bounded t-structures on the category of perfect
complexes*, Acta Math. 233 (2024), Theorem 3.2(iii): the standard `t`-structure of `D_{qc,Z}(X)` is
equivalent (Neeman's Definition 2.9, `NeemanPreferredM6.TStructureEquivalent`) to the
`t`-structure generated by a compact generator `G`, whose coaisle `tG^{≥ 1}` is the class of the
objects `Y` with `Hom(G[n], Y) = 0` for all `n ≥ 0` (`genCoaisle G`; for the `t`-structure
compactly generated by `G` this is `CompactTStructureW6.ge_one_iff_of_compactlyGenerated`).

Everything here is universe-free category theory on a pretriangulated category `C` with a
`t`-structure `t`; the coproducts, when they occur, are indexed by an arbitrary universe `w`
(AxiomMath's `IsCompactObject.{w}`, Stacks 07LS), independent of the Hom universe, as for
AxiomMath's `D(𝒪_X)`.

## What is proved

* `tStructureEquivalent_of_detectsBelowUniformly`: if `G ∈ t^{≤ b}` and there is `A` with
  `genCoaisle G ⊆ t^{≥ A}` (`DetectsBelowUniformly t G`), then `t` is equivalent to every
  `t`-structure `tG` with `tG^{≥ 1} = genCoaisle G`.  This is the only way the two inclusions of
  Definition 2.9 are obtained: `t^{≤ -A-1} ⊆ ⊥(tG^{≥1}) = tG^{≤ 0}` and
  `tG^{≤ 0} ⊆ ⊥(t^{≥ b+1}) = t^{≤ b}`.
* `detectsBelowUniformly_of_mem_triangEnvelope`: the uniform bound does not depend on the
  generator — it passes from `G` to every `G'` whose triangulated envelope contains `G`
  (the mechanism behind Neeman's Remark 2.11).
* `detectsBelowUniformly_of_detectsBelow`: **a direct-sum argument** turning the non-uniform
  statement "every `Y ∈ genCoaisle G` is bounded below" into the uniform one, for `G` compact.
  If for every `k` some `Y_k ∈ genCoaisle G` were not in `t^{≥ -k}`, then `∐ₖ Y_k` would lie in
  `genCoaisle G` (compactness of the `G[n]`) but in no `t^{≥ a}`, since each `Y_k` is a retract of
  it.

Nothing is assumed.
-/

noncomputable section

namespace RelativeFM.Spaces.Supported

open CategoryTheory CategoryTheory.Limits CategoryTheory.Pretriangulated
open CategoryTheory.Triangulated

universe w v u

variable {C : Type u} [Category.{v} C] [Preadditive C] [HasZeroObject C] [HasShift C ℤ]
  [∀ n : ℤ, (shiftFunctor C n).Additive] [Pretriangulated C]

/-! ### The coaisle generated by an object -/

/-- The coaisle `tG^{≥ 1}` of the `t`-structure generated by `G`: the objects `Y` with
`Hom(G[n], Y) = 0` for every `n ≥ 0`. -/
def genCoaisle (G : C) : ObjectProperty C := fun Y =>
  ∀ n : ℤ, 0 ≤ n → ∀ f : G⟦n⟧ ⟶ Y, f = 0

/-- `G` *detects boundedness below uniformly* for `t`: there is `A` such that every `Y` with
`Hom(G[n], Y) = 0` for all `n ≥ 0` lies in `t^{≥ A}`. -/
def DetectsBelowUniformly (t : TStructure C) (G : C) : Prop :=
  ∃ A : ℤ, ∀ Y : C, genCoaisle G Y → t.IsGE Y A

omit [HasZeroObject C] [Pretriangulated C] in
/-- A map `G[n] ⟶ Y[k]` vanishes as soon as every map `G[n - k] ⟶ Y` does. -/
lemma eq_zero_of_shift (G Y : C) (n k : ℤ) (h : ∀ g : G⟦n - k⟧ ⟶ Y, g = 0)
    (f : G⟦n⟧ ⟶ Y⟦k⟧) : f = 0 := by
  let e : G⟦n - k⟧ ≅ G⟦n⟧⟦-k⟧ := (shiftFunctorAdd' C n (-k) (n - k) (by omega)).app G
  have h0 := h (e.hom ≫ f⟦-k⟧' ≫ (shiftShiftNeg Y k).hom)
  have h1 : f⟦-k⟧' = 0 := by
    rw [← cancel_mono (shiftShiftNeg Y k).hom, zero_comp, ← cancel_epi e.hom, comp_zero]
    exact h0
  apply (shiftFunctor C (-k)).map_injective
  rw [h1, Functor.map_zero]

/-- `genCoaisle G` is closed under isomorphisms. -/
instance (G : C) : (genCoaisle G).IsClosedUnderIsomorphisms where
  of_iso e h := fun n hn f => by
    rw [← cancel_mono e.inv, zero_comp]
    exact h n hn _

/-! ### From a uniform bound to Neeman's equivalence -/

/-- Retracts of objects of `t^{≥ n}` lie in `t^{≥ n}`. -/
lemma isGE_of_retract (t : TStructure C) {X Y : C} (r : Retract X Y) (n : ℤ)
    (hY : t.IsGE Y n) : t.IsGE X n := by
  rw [t.isGE_iff_orthogonal (n - 1) n (by omega)]
  intro Z f hZ
  have : t.IsLE Z (n - 1) := hZ
  calc f = f ≫ 𝟙 X := (Category.comp_id f).symm
    _ = f ≫ r.i ≫ r.r := by rw [r.retract]
    _ = (f ≫ r.i) ≫ r.r := (Category.assoc _ _ _).symm
    _ = 0 := by rw [t.zero (f ≫ r.i) (n - 1) n (by omega), zero_comp]

/-- **Neeman's equivalence from a uniform bound.**  Let `t` be a `t`-structure, `G ∈ t^{≤ b}`
with `genCoaisle G ⊆ t^{≥ A}` for some `A`, and `tG` a `t`-structure with
`tG^{≥ 1} = genCoaisle G` (for instance the `t`-structure compactly generated by `G`).  Then `t`
and `tG` are equivalent in the sense of Neeman 2024, Definition 2.9. -/
theorem tStructureEquivalent_of_detectsBelowUniformly (t tG : TStructure C) (G : C) (b : ℤ)
    (hG : t.IsLE G b) (htG : ∀ Y : C, tG.ge 1 Y ↔ genCoaisle G Y)
    (hU : DetectsBelowUniformly t G) : NeemanPreferredM6.TStructureEquivalent t tG := by
  obtain ⟨A, hA⟩ := hU
  let N : ℤ := max (max (1 - A) b) 1
  have hN1 : 1 - A ≤ N := le_trans (le_max_left _ _) (le_max_left _ _)
  have hNb : b ≤ N := le_trans (le_max_right _ _) (le_max_left _ _)
  refine ⟨N, lt_of_lt_of_le zero_lt_one (le_max_right _ _), ?_, ?_⟩
  · intro X hX
    have : t.IsLE X (-N) := ⟨hX⟩
    have hXle : tG.IsLE X 0 := by
      rw [tG.isLE_iff_orthogonal 0 1 (by omega)]
      intro Y f hY
      have hYc : genCoaisle G Y := (htG Y).1 hY.1
      have : t.IsGE Y A := hA Y hYc
      have : t.IsGE Y (-N + 1) := t.isGE_of_ge Y (-N + 1) A (by omega)
      exact t.zero f (-N) (-N + 1) (by omega)
    exact hXle.1
  · intro X hX
    have hXle : tG.IsLE X 0 := ⟨hX⟩
    have : t.IsLE X N := by
      rw [t.isLE_iff_orthogonal N (N + 1) rfl]
      intro Y f hY
      have hYc : tG.ge 1 Y := by
        rw [htG]
        intro n hn g
        have : t.IsLE (G⟦n⟧) (b - n) := t.isLE_shift G b n (b - n) (by omega)
        have : t.IsLE (G⟦n⟧) N := t.isLE_of_le _ (b - n) N (by omega)
        exact t.zero g N (N + 1)
      have : tG.IsGE Y 1 := ⟨hYc⟩
      exact tG.zero f 0 1 (by omega)
    exact this.1

/-! ### Independence of the generator -/

/-- The objects `H` such that, for some `m`, every `Y ∈ genCoaisle G` receives only zero maps
from `H[n]`, `n ≥ m`. -/
def bndFrom (G : C) : ObjectProperty C := fun H =>
  ∃ m : ℤ, ∀ Y : C, genCoaisle G Y → ∀ n : ℤ, m ≤ n → ∀ f : H⟦n⟧ ⟶ Y, f = 0

variable (G : C)

omit [HasZeroObject C] [∀ n : ℤ, (shiftFunctor C n).Additive] [Pretriangulated C] in
lemma mem_bndFrom_self : bndFrom G G := ⟨0, fun _ hY n hn f => hY n hn f⟩

instance : (bndFrom G).IsClosedUnderIsomorphisms where
  of_iso e := by
    rintro ⟨m, hm⟩
    refine ⟨m, fun Y hY n hn f => ?_⟩
    rw [← cancel_epi ((shiftFunctor C n).mapIso e).hom, comp_zero]
    exact hm Y hY n hn _

instance : (bndFrom G).ContainsZero where
  exists_zero := by
    obtain ⟨Z, hZ⟩ := HasZeroObject.zero (C := C)
    exact ⟨Z, hZ, 0, fun Y _ n _ f => ((shiftFunctor C n).map_isZero hZ).eq_of_src f 0⟩

instance : (bndFrom G).IsStableUnderShift ℤ where
  isStableUnderShiftBy a := ⟨fun H => by
    rintro ⟨m, hm⟩
    refine ⟨m - a, fun Y hY n hn f => ?_⟩
    let e : H⟦a⟧⟦n⟧ ≅ H⟦a + n⟧ := ((shiftFunctorAdd C a n).app H).symm
    rw [← cancel_epi e.inv, comp_zero]
    exact hm Y hY (a + n) (by omega) _⟩

instance : (bndFrom G).IsTriangulatedClosed₂ :=
  ObjectProperty.IsTriangulatedClosed₂.mk' (fun T hT ⟨m₁, h₁⟩ ⟨m₃, h₃⟩ => by
    refine ⟨max m₁ m₃, fun Y hY n hn f => ?_⟩
    have hT' := Triangle.shift_distinguished T hT n
    obtain ⟨w, rfl⟩ := Triangle.yoneda_exact₂ _ hT' f
      (h₁ Y hY n (le_trans (le_max_left _ _) hn) _)
    have hw : w = 0 := h₃ Y hY n (le_trans (le_max_right _ _) hn) _
    rw [hw]
    exact comp_zero)

instance : (bndFrom G).IsStableUnderRetracts where
  of_retract {X Y} r := by
    rintro ⟨m, hm⟩
    refine ⟨m, fun Z hZ n hn f => ?_⟩
    have key : f = (r.i⟦n⟧') ≫ (r.r⟦n⟧' ≫ f) := by
      rw [← Category.assoc, ← CategoryTheory.Functor.map_comp, r.retract, CategoryTheory.Functor.map_id,
        Category.id_comp]
    rw [key, hm Z hZ n hn (r.r⟦n⟧' ≫ f), comp_zero]

instance : (bndFrom G).IsTriangulated where

/-- Every object of the triangulated envelope of `G` lies in `bndFrom G`. -/
lemma triangEnvelope_le_bndFrom : (ObjectProperty.singleton G).triangEnvelope ≤ bndFrom G := by
  rw [ObjectProperty.triangEnvelope_le_iff, ObjectProperty.singleton_le_iff]
  exact mem_bndFrom_self G

variable {G}

/-- **Independence of the generator.**  If `G` lies in the triangulated envelope of `G'` and
`G` detects boundedness below uniformly, so does `G'`. -/
theorem detectsBelowUniformly_of_mem_triangEnvelope (t : TStructure C) {G' : C}
    (hG : (ObjectProperty.singleton G').triangEnvelope G) (hU : DetectsBelowUniformly t G) :
    DetectsBelowUniformly t G' := by
  obtain ⟨m, hm⟩ := triangEnvelope_le_bndFrom G' G hG
  obtain ⟨A, hA⟩ := hU
  refine ⟨A - m, fun Y hY => ?_⟩
  have hY' : genCoaisle G (Y⟦-m⟧) := fun n hn f =>
    eq_zero_of_shift G Y n (-m) (fun g => hm Y hY (n - -m) (by omega) g) f
  have h1 : t.IsGE (Y⟦-m⟧) A := hA _ hY'
  have h2 : t.IsGE (Y⟦-m⟧⟦m⟧) (A - m) := t.isGE_shift (Y⟦-m⟧) A m (A - m) (by omega)
  have : t.IsGE ((shiftFunctor C (-m) ⋙ shiftFunctor C m).obj Y) (A - m) := h2
  exact t.isGE_of_iso ((shiftFunctorCompIsoId C (-m) m (by omega)).app Y) (A - m)

/-! ### The direct-sum argument -/

/-- **From boundedness below to a uniform bound.**  Let `C` have direct sums indexed by `Type w`
and `G` be compact (`IsCompactObject.{w}`, Stacks 07LS).  If every `Y ∈ genCoaisle G` is bounded
below for `t`, then there is a uniform bound: `genCoaisle G ⊆ t^{≥ A}` for some `A`. -/
theorem detectsBelowUniformly_of_detectsBelow [HasCoproducts.{w} C] (t : TStructure C)
    (hG : IsCompactObject.{w} G) (h : ∀ Y : C, genCoaisle G Y → ∃ a : ℤ, t.IsGE Y a) :
    DetectsBelowUniformly t G := by
  classical
  by_contra hne
  simp only [DetectsBelowUniformly, not_exists, not_forall, exists_prop] at hne
  choose Y hY hnot using hne
  let F : ULift.{w} ℕ → C := fun k => Y (-(k.down : ℤ))
  have hΦ : genCoaisle G (∐ F) := fun n _ f => by
    obtain ⟨x, hx⟩ :=
      ((isCompactObject_shift hG n).bijective_toAddMonoid_rightComp_sigmaι F).2 f
    have hx0 : x = 0 := DFinsupp.ext fun k => hY _ n (by omega) _
    rw [← hx, hx0, map_zero]
  obtain ⟨a, ha⟩ := h _ hΦ
  let k : ULift.{w} ℕ := ⟨(-a).toNat⟩
  let r : Retract (F k) (∐ F) :=
    { i := Sigma.ι F k
      r := Sigma.desc fun j => if hj : j = k then eqToHom (by rw [hj]) else 0
      retract := by simp }
  have hk : t.IsGE (F k) a := isGE_of_retract t r a ha
  have hle : -((k.down : ℕ) : ℤ) ≤ a := by
    have := Int.self_le_toNat (-a)
    simp only [k]
    omega
  exact hnot _ (t.isGE_of_ge _ _ a hle)

/-! ### Non-vacuity -/

open RelativeWeakApprox in
/-- **Non-vacuity of `tStructureEquivalent_of_detectsBelowUniformly`.**  When direct sums are
indexed by the Hom universe (`HasCoproducts.{v}`) and `G` is compact in the tree's sense
(`IsCompactAb`), the `t`-structure compactly generated by `G`
(`CompactTStructureW6.compactTStructure`, Alonso–Jeremías–Souto) satisfies every hypothesis of the
theorem with `t = tG`: `G ∈ t^{≤ 0}`, `tG^{≥ 1} = genCoaisle G`, and the uniform bound with
`A = 1`. -/
theorem compactTStructure_hypotheses [HasCoproducts.{v} C] (G : C) (hG : IsCompactAb G) :
    (CompactTStructureW6.compactTStructure G hG).IsLE G 0 ∧
      (∀ Y : C, (CompactTStructureW6.compactTStructure G hG).ge 1 Y ↔ genCoaisle G Y) ∧
      DetectsBelowUniformly (CompactTStructureW6.compactTStructure G hG) G := by
  have hge := CompactTStructureW6.ge_one_iff_of_compactlyGenerated G
    (CompactTStructureW6.compactTStructure G hG) (CompactTStructureW6.compactTStructure_le_zero G hG)
  refine ⟨⟨?_⟩, hge, ⟨1, fun Y hY => ⟨(hge Y).2 hY⟩⟩⟩
  rw [CompactTStructureW6.compactTStructure_le_zero]
  exact Coprod.of_mem G ⟨0, le_rfl, ⟨(shiftFunctorZero C ℤ).symm.app G⟩⟩

end RelativeFM.Spaces.Supported
