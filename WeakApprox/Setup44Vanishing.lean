import WeakApprox.Lemma43

/-!
# Setup 4.4(3): the Hom-vanishing condition

Setup 4.4(3) says `Hom(G, D^{≤-A}) = 0` for the normalized generator
`G = G'⟦m⟧ ⊞ j_!G_U` and the common bound `A`.  It is *derived* here rather
than assumed: Lemma 4.3(4) gives eventual self-Hom vanishing of `G`, and
Lemma 3.5 (with the aisle `D^{≤0}` compactly generated by `G`) turns that into
`Hom(G, Y) = 0` for `Y ∈ D^{≤-N}`.

The only external input is `IsClassicalGeneratorOnCompacts G'` (Stacks 09SR for
the paper's compacts), exactly as in Lemma 4.3(4).  Neither an upper aisle bound
for `j_!G_U` nor a separate vanishing argument for each biproduct summand is
needed.

Found by a member of the Ultramath run `smwur4wqg` (direction D2).
-/

@[expose] public section

namespace RelativeWeakApprox

open CategoryTheory CategoryTheory.Limits
open CategoryTheory.Pretriangulated CategoryTheory.Triangulated

universe v u

section BoundedAbove

variable {C : Type u} [Category.{v} C] [HasZeroObject C] [HasShift C ℤ]
  [Preadditive C] [∀ (n : ℤ), (shiftFunctor C n).Additive] [Pretriangulated C]

/-- **Boundedness criterion used in Lemma 4.3.** If maps from `G` to large
positive shifts of `Y` eventually vanish, and `G` is a generator lying in the
degree-zero aisle, then `Y` is bounded above by a nonnegative aisle degree.

This is the general form of the proposed upper-bound argument for `j_!G_U`.
The proof shifts a map `G[-n] ⟶ Y` by `n`, so `h` applies precisely when
`n ≥ N`; the existing `le_of_hom_zero_neg_shifts` criterion finishes the
argument. -/

theorem exists_nonneg_le_of_eventuallyHomZero (t : TStructure C) (G Y : C)
    (hG : IsGenerator G) (hG0 : t.le 0 G) (h : EventuallyHomZero G Y) :
    ∃ B : ℤ, 0 ≤ B ∧ t.le B Y := by
  obtain ⟨N, hN⟩ := h
  apply exists_nonneg_le_of_hom_zero_neg_shifts t G hG hG0
  refine ⟨N, fun n hn f => ?_⟩
  apply (shiftFunctor C n).map_injective
  rw [Functor.map_zero, ← cancel_epi (shiftNegShift G n).inv, comp_zero]
  exact hN n hn _

/-- **Setup 4.4(3), at a prescribed common cutoff.** Let `G` be compact and
let its degree-zero aisle be compactly generated by `G`, as in Lemma 3.5.  If
`Hom(G,G[n]) = 0` for `n ≥ N` and `N ≤ A`, then `Hom(G,Y) = 0` for every
`Y ∈ t.le (-A)`.  Monotonicity of aisles allows `A` to be the common maximum
of the three bounds in Setup 4.4. -/

theorem setup_4_4_3_vanishing_at (t : TStructure C) (G : C) [IsCompactAb G]
    {N A : ℤ} (hNA : N ≤ A) (haisle : t.le 0 = Coprod (shiftTail G 0))
    (hG : ∀ n : ℤ, N ≤ n → ∀ f : G ⟶ G⟦n⟧, f = 0)
    {Y : C} (hY : t.le (-A) Y) : ∀ f : G ⟶ Y, f = 0 := by
  apply lemma_3_5 t G N haisle hG
  exact t.le_monotone (by omega) Y hY

end BoundedAbove

section Recollement

universe uZ uD uU

variable {DZ : Type uZ} {D : Type uD} {DU : Type uU}
  [Category.{v} DZ] [Category.{v} D] [Category.{v} DU]
  [Preadditive DZ] [Preadditive D] [Preadditive DU]
  [HasZeroObject DZ] [HasZeroObject D] [HasZeroObject DU]
  [HasShift DZ ℤ] [HasShift D ℤ] [HasShift DU ℤ]
  [∀ (n : ℤ), (shiftFunctor DZ n).Additive]
  [∀ (n : ℤ), (shiftFunctor D n).Additive]
  [∀ (n : ℤ), (shiftFunctor DU n).Additive]
  [Pretriangulated DZ] [Pretriangulated D] [Pretriangulated DU]
  [CategoryTheory.IsTriangulated DZ] [CategoryTheory.IsTriangulated D]
  [CategoryTheory.IsTriangulated DU]

/-- **Lemma 4.3(2), compactness part.** Compactness of `G'` and `G_U` implies
compactness of the normalized generator `G'[m] ⊞ j_!G_U`.  The three
categories have the common hom universe `v`, as required by `IsCompactAb`. -/

theorem isCompactAb_normalizedGenerator (R : Recollement DZ D DU)
    (G' : D) (GU : DU) (m : ℤ)
    [HasBinaryBiproduct (G'⟦m⟧) (R.jShriek.obj GU)]
    (hG'compact : IsCompactAb G') (hGUcompact : IsCompactAb GU) :
    IsCompactAb (G'⟦m⟧ ⊞ R.jShriek.obj GU) :=
  isCompactAb_biprod (isCompactAb_shift G' m hG'compact)
    (R.isCompactAb_jShriek_obj hGUcompact)

/-- **An upper aisle bound for `j_!G_U`, auxiliary to Setup 4.4.** Under the paper's
classical-generation input `hgen` (§2.1.2), compactness and eventual
self-vanishing of `G'`, and generation with `G' ∈ t.le 0`, the object
`j_!G_U` lies in `t.le B` for some `B ≥ 0`.

The extra input is exactly `IsClassicalGeneratorOnCompacts G'`: it places the
compact object `j_!G_U` in the finite thick envelope of `G'`, yielding
`EventuallyHomZero G' (j_!G_U)`.  `IsGenerator G'` alone supplies only the
final separation criterion, not that envelope membership. -/

theorem exists_nonneg_le_jShriek_GU (R : Recollement DZ D DU)
    (tD : TStructure D) (G' : D) (GU : DU)
    (hG'0 : tD.le 0 G') (hG'gen : IsGenerator G')
    (hG'compact : IsCompactAb G') (hGUcompact : IsCompactAb GU)
    (hG' : EventuallyHomZero G' G')
    (hgen : IsClassicalGeneratorOnCompacts G') :
    ∃ B : ℤ, 0 ≤ B ∧ tD.le B (R.jShriek.obj GU) := by
  apply exists_nonneg_le_of_eventuallyHomZero tD G' _ hG'gen hG'0
  exact eventuallyHomZero_of_compact hG' hgen hG'compact
    (R.isCompactAb_jShriek_obj hGUcompact)

/-- **Setup 4.4(3) and Lemma 4.3(4).** There is a positive common cutoff `A`
for which the normalized generator `G = G'[m] ⊞ j_!G_U` has eventual positive
self-Hom vanishing and satisfies `Hom(G,tD.le (-A)) = 0`.

The hypotheses are the paper's compactness of the two input generators,
eventual self-vanishing of `G'`, compact generation of the aisle by `G`, and
classical generation on compacts `hgen`.  The last hypothesis is the explicit
rendering of §2.1.2 already used by `lemma_4_3_4`; it is not inferred from bare
`IsGenerator G'`.  No upper aisle bound for `j_!G_U`, no `tD.le 0 G'`
hypothesis, and no separate Hom-vanishing assumption on either summand is
needed.  This is the paper's actual route: Lemma 4.3(4) followed by Lemma 3.5. -/

theorem exists_setup_4_4_3 (R : Recollement DZ D DU) (tD : TStructure D)
    (G' : D) (GU : DU) (m : ℤ)
    [HasBinaryBiproduct (G'⟦m⟧) (R.jShriek.obj GU)]
    (hG'compact : IsCompactAb G') (hGUcompact : IsCompactAb GU)
    (hG' : EventuallyHomZero G' G')
    (hgen : IsClassicalGeneratorOnCompacts G')
    (haisle : tD.le 0 = Coprod (shiftTail (G'⟦m⟧ ⊞ R.jShriek.obj GU) 0)) :
    ∃ A : ℤ, 0 < A ∧
      EventuallyHomZero (G'⟦m⟧ ⊞ R.jShriek.obj GU)
        (G'⟦m⟧ ⊞ R.jShriek.obj GU) ∧
      (∀ {Y : D}, tD.le (-A) Y →
        ∀ f : (G'⟦m⟧ ⊞ R.jShriek.obj GU) ⟶ Y, f = 0) := by
  letI : IsCompactAb (G'⟦m⟧ ⊞ R.jShriek.obj GU) :=
    isCompactAb_normalizedGenerator R G' GU m hG'compact hGUcompact
  have hG : EventuallyHomZero (G'⟦m⟧ ⊞ R.jShriek.obj GU)
      (G'⟦m⟧ ⊞ R.jShriek.obj GU) :=
    lemma_4_3_4 R G' GU m hG' hgen hGUcompact
  obtain ⟨N, hN⟩ := hG
  refine ⟨max N 1, lt_of_lt_of_le Int.zero_lt_one (le_max_right N 1),
    ⟨N, hN⟩, ?_⟩
  intro Y hY
  exact setup_4_4_3_vanishing_at tD _ (le_max_left N 1) haisle hN hY

end Recollement


end RelativeWeakApprox

#print axioms RelativeWeakApprox.setup_4_4_3_vanishing_at
#print axioms RelativeWeakApprox.exists_setup_4_4_3
#print axioms RelativeWeakApprox.exists_nonneg_le_jShriek_GU
