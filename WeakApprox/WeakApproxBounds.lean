import WeakApprox.CompactlyGeneratedTStructure
import WeakApprox.PaperGeneratorM2

/-!
# Bounds from weak approximation data: BNP Corollary 3.10(1) and the preferred class

Sources: Lank--Pauwels, *Gluing weak approximability along recollements* (LP26),
§2.1.4 (`def:weak_approx`), the proof of Lemma 4.3(1) (`lem:normalize`) and
Setup 4.4 (`setup:standing`); Burke--Neeman--Pauwels, *Gluing approximable
triangulated categories* (2023), Corollary 3.10(1) and Lemma 3.7; Neeman,
Proposition 3.6 / Remark 1.19 (the `t`-structure of weak approximation data lies
in the preferred equivalence class).

Throughout, `W` is weak approximation data `(G, t, A)` in the paper's sense
(`PaperWeakApproximationData`: `G` compact, zero-detecting, `G ∈ t^{≤A}`,
`Hom(G, t^{≤-A}) = 0`, and the approximation triangles).  Everything is proved
from these fields; no homotopy colimit is needed.

## What is proved

* `exists_factor_step`: one approximation step.  If `X ∈ t^{≤m}` and
  `Hom(G[-k], V) = 0` for `m - A ≤ k ≤ m + A`, every `X ⟶ V` factors through an
  object of `t^{≤m-1}`.
* `le_of_factor`: if the first map of a truncation triangle at level `n`
  factors through `t^{≤q}`, `q ≤ n`, then its source lies in `t^{≤q}`.
* `bnp_3_10_1`: **BNP Corollary 3.10(1)** for the data's own `t`-structure: if
  `Hom(G[-k], Y) = 0` for all `k ≥ N`, then `Y ∈ t^{≤ N + A - 1}`.
* `ge_of_hom_vanishing`: the dual bound.  If `Hom(G[-k], V) = 0` for all
  `k ≤ c`, then `V ∈ t^{≥ c - A + 1}`.
* `le_compactlyGenerated_of_le`, `compactlyGenerated_le_of_le`: the
  `t`-structure of `W` and the `t`-structure compactly generated by `W.G`
  interpose with amplitude `A` (`t^{≤-A} ⊆ t_G^{≤0} ⊆ t^{≤A}`).  This is the
  statement that weak approximation data lie in the preferred equivalence class.

Nothing is assumed beyond the fields of `W`.
-/

@[expose] public section

namespace RelativeWeakApprox.WABoundsW6

open CategoryTheory CategoryTheory.Limits
open CategoryTheory.Pretriangulated CategoryTheory.Triangulated
open RelativeWeakApprox RelativeWeakApprox.PaperM2

universe v u

variable {C : Type u} [Category.{v} C] [Preadditive C] [HasZeroObject C]
  [HasShift C ℤ] [∀ n : ℤ, (shiftFunctor C n).Additive] [Pretriangulated C]

/-! ### Generalities on `t`-structures -/

section General

/-- Maps from an object of `t^{≤ p}` to an object of `t^{≥ q}`, `p < q`, vanish. -/
lemma hom_zero_of_le_ge (t : TStructure C) {X Y : C} {p q : ℤ} (hpq : p < q)
    (hX : t.le p X) (hY : t.ge q Y) (f : X ⟶ Y) : f = 0 := by
  have hX' : t.le (q - 1) X := t.le_monotone (by omega) X hX
  have hX0 : t.le 0 (X⟦q - 1⟧) := t.le_shift (q - 1) (q - 1) 0 (by omega) X hX'
  have hY1 : t.ge 1 (Y⟦q - 1⟧) := t.ge_shift q (q - 1) 1 (by omega) Y hY
  have h0 := t.zero' (f⟦q - 1⟧') hX0 hY1
  apply (shiftFunctor C (q - 1)).map_injective
  rw [h0, Functor.map_zero]

/-- **Retract argument.**  Let `A →ι Y → B → A[1]` be distinguished with
`A ∈ t^{≤n}` and `B ∈ t^{≥n+1}`.  If `ι` factors through an object `D` of
`t^{≤q}` with `q ≤ n`, then `A ∈ t^{≤q}`. -/
theorem le_of_factor (t : TStructure C) {A Y B D : C} {ι : A ⟶ Y} {π : Y ⟶ B}
    {δ : B ⟶ A⟦(1 : ℤ)⟧} (hT : Triangle.mk ι π δ ∈ distTriang C) {n q : ℤ} (hqn : q ≤ n)
    (hA : t.le n A) (hB : t.ge (n + 1) B) (hD : t.le q D) (p : A ⟶ D) (r : D ⟶ Y)
    (hpr : ι = p ≫ r) : t.le q A := by
  have hrπ : r ≫ π = 0 :=
    hom_zero_of_le_ge t (by omega : q < n + 1) hD hB _
  obtain ⟨ψ, hψ⟩ : ∃ ψ : D ⟶ A, r = ψ ≫ ι := Triangle.coyoneda_exact₂ _ hT r hrπ
  have h1 : (𝟙 A - p ≫ ψ) ≫ ι = 0 := by
    rw [Preadditive.sub_comp, Category.id_comp, Category.assoc, ← hψ, ← hpr, sub_self]
  obtain ⟨w, hw⟩ : ∃ w : A ⟶ B⟦(-1 : ℤ)⟧,
      𝟙 A - p ≫ ψ = w ≫ (Triangle.mk ι π δ).invRotate.mor₁ :=
    Triangle.coyoneda_exact₂ _ (inv_rot_of_distTriang _ hT) _ h1
  have hB' : t.ge (n + 2) (B⟦(-1 : ℤ)⟧) := t.ge_shift (n + 1) (-1) (n + 2) (by omega) B hB
  have hw0 : w = 0 := hom_zero_of_le_ge t (by omega : n < n + 2) hA hB' w
  have h2 : 𝟙 A - p ≫ ψ = 0 := by
    rw [hw]; subst hw0; exact zero_comp
  rw [sub_eq_zero] at h2
  rw [TStructure.le_iff_isLE, t.isLE_iff_orthogonal q (q + 1) rfl]
  intro V g hV
  have hψg : ψ ≫ g = 0 :=
    hom_zero_of_le_ge t (by omega : q < q + 1) hD (t.ge_of_isGE V (q + 1)) _
  rw [← Category.id_comp g, h2, Category.assoc, hψg, comp_zero]

end General

variable (W : PaperWeakApproximationData C)

/-! ### Elementary bounds -/

/-- `G[n] ∈ t^{≤ A - n}`. -/
lemma G_shift_le (n : ℤ) : W.t.le (W.A - n) (W.G⟦n⟧) :=
  W.t.le_shift W.A n (W.A - n) (by omega) W.G W.G_mem_le

/-- `Hom(G[n], Z) = 0` for `Z ∈ t^{≤p}` and `p + n ≤ -A`. -/
lemma hom_shift_zero {n p : ℤ} (h : p + n ≤ -W.A) {Z : C} (hZ : W.t.le p Z)
    (f : W.G⟦n⟧ ⟶ Z) : f = 0 := by
  have hZ' : W.t.le (-W.A) (Z⟦-n⟧) :=
    W.t.le_monotone h _ (W.t.le_shift p (-n) (p + n) (by omega) Z hZ)
  have h0 := W.hom_vanishing hZ' ((shiftShiftNeg W.G n).inv ≫ f⟦-n⟧')
  have h1 : f⟦-n⟧' = 0 := by
    rw [← cancel_epi (shiftShiftNeg W.G n).inv, comp_zero]
    exact h0
  apply (shiftFunctor C (-n)).map_injective
  rw [h1, Functor.map_zero]

/-- `Hom(G[n], Z) = 0` for `Z ∈ t^{≥q}` and `A - n < q`. -/
lemma hom_shift_zero_ge {n q : ℤ} (h : W.A - n < q) {Z : C} (hZ : W.t.ge q Z)
    (f : W.G⟦n⟧ ⟶ Z) : f = 0 :=
  hom_zero_of_le_ge W.t h (G_shift_le W n) hZ f

/-! ### One approximation step -/

/-- **One approximation step.**  If `X ∈ t^{≤m}` and `Hom(G[-k], V) = 0` for
`m - A ≤ k ≤ m + A`, then every `f : X ⟶ V` factors through some
`D ∈ t^{≤m-1}`.  Proof: approximate `X[m] ∈ t^{≤0}` by `E → X[m] → D'` with
`E ∈ ⟨G⟩^{[-A,A]}`, shift back by `-m`, and use that `E[-m] ∈ ⟨G⟩^{[m-A,m+A]}`
has no maps to `V` (LP26 Lemma 3.1(4)). -/
theorem exists_factor_step {m : ℤ} {X V : C} (hX : W.t.le m X)
    (hV : ∀ k : ℤ, m - W.A ≤ k → k ≤ m + W.A → ∀ f : W.G⟦-k⟧ ⟶ V, f = 0)
    (f : X ⟶ V) : ∃ (D : C) (p : X ⟶ D) (q : D ⟶ V), W.t.le (m - 1) D ∧ f = p ≫ q := by
  have hX0 : W.t.le 0 (X⟦m⟧) := W.t.le_shift m m 0 (by omega) X hX
  obtain ⟨E, D, a, b, c, hT, hE, hD⟩ := W.exists_triangle _ hX0
  have hT' := Triangle.shift_distinguished _ hT (-m)
  let e : X⟦m⟧⟦-m⟧ ≅ X := shiftShiftNeg X m
  have hE' : envelope W.G (-W.A + m) (W.A + m) (E⟦-m⟧) := by
    have := map_shift_envelope W.G (-W.A) W.A (-m) hE
    simpa [sub_neg_eq_add] using this
  let b' : X⟦m⟧⟦-m⟧ ⟶ D⟦-m⟧ := ((Triangle.shiftFunctor C (-m)).obj (Triangle.mk a b c)).mor₂
  obtain ⟨q, hq⟩ : ∃ q : D⟦-m⟧ ⟶ V, e.hom ≫ f = b' ≫ q := Triangle.yoneda_exact₂ _ hT'
    (e.hom ≫ f)
    (hom_zero_of_mem_envelope (fun k hk₁ hk₂ g => hV k (by omega) (by omega) g) hE' _)
  refine ⟨D⟦-m⟧, e.inv ≫ b', q, W.t.le_shift (-1) (-m) (m - 1) (by omega) D hD, ?_⟩
  rw [Category.assoc, ← hq, Iso.inv_hom_id_assoc]

/-- Iterated approximation: `j` steps down, provided the `Hom` vanishing holds
on each window. -/
theorem exists_factor_iter {V : C} :
    ∀ (j : ℕ) {m : ℤ} {X : C}, W.t.le m X →
      (∀ k : ℤ, m - j + 1 - W.A ≤ k → k ≤ m + W.A → ∀ f : W.G⟦-k⟧ ⟶ V, f = 0) →
      ∀ f : X ⟶ V, ∃ (D : C) (p : X ⟶ D) (q : D ⟶ V), W.t.le (m - j) D ∧ f = p ≫ q := by
  intro j
  induction j with
  | zero =>
    intro m X hX _ f
    exact ⟨X, 𝟙 X, f, by simpa using hX, by simp⟩
  | succ j ih =>
    intro m X hX hV f
    obtain ⟨D, p, q, hD, hf⟩ := ih hX (fun k hk₁ hk₂ g => hV k (by push_cast; omega) hk₂ g) f
    obtain ⟨D', p', q', hD', hq⟩ := exists_factor_step W hD
      (fun k hk₁ hk₂ g => hV k (by push_cast; omega) (by omega) g) q
    refine ⟨D', p ≫ p', q', by push_cast; simpa [sub_sub] using hD', ?_⟩
    rw [hf, hq, Category.assoc]

/-! ### BNP Corollary 3.10(1) -/

/-- **Burke--Neeman--Pauwels, Corollary 3.10(1)**, for the `t`-structure of the
data: if `Hom(G[-k], Y) = 0` for every `k ≥ N`, then `Y ∈ t^{≤ N + A - 1}`; in
particular `Y ∈ t^-`.

Proof: take the truncation triangle `Aₖ → Y → Bₖ` at the level
`K = N + 3A`; iterated approximation factors `Aₖ → Y` through
`t^{≤ N + A - 1}`, so `Aₖ ∈ t^{≤ N + A - 1}` (`le_of_factor`); then every map
`G[n] → Bₖ` vanishes (for large `n` by the coaisle bound, for small `n` because it
lifts to `Y`), so `Bₖ = 0` by zero detection and `Y ≅ Aₖ`. -/
theorem bnp_3_10_1 {Y : C} {N : ℤ}
    (hY : ∀ k : ℤ, N ≤ k → ∀ f : W.G⟦-k⟧ ⟶ Y, f = 0) : W.t.le (N + W.A - 1) Y := by
  have hApos := W.A_pos
  let K : ℤ := N + 3 * W.A
  obtain ⟨A₀, B, hA₀, hB, ι, π, δ, hT⟩ := W.t.exists_triangle Y K (K + 1) rfl
  -- `ι` factors through `t^{≤ N + A - 1}`
  have hj : (0 : ℤ) ≤ K - (N + W.A - 1) := by omega
  obtain ⟨D, p, r, hD, hpr⟩ := exists_factor_iter W (K - (N + W.A - 1)).toNat hA₀
    (fun k hk₁ _ g => hY k (by rw [Int.toNat_of_nonneg hj] at hk₁; omega) g) ι
  rw [Int.toNat_of_nonneg hj, show K - (K - (N + W.A - 1)) = N + W.A - 1 by ring] at hD
  have hA₀' : W.t.le (N + W.A - 1) A₀ :=
    le_of_factor W.t hT (by omega) hA₀ hB hD p r hpr
  -- `B = 0`
  have hBz : IsZero B := by
    apply W.G_paperGenerates
    intro n g
    by_cases hn : W.A - K ≤ n
    · exact hom_shift_zero_ge W (by omega) hB g
    · have hA₁ : W.t.le (N + W.A - 2) (A₀⟦(1 : ℤ)⟧) :=
        W.t.le_shift (N + W.A - 1) 1 (N + W.A - 2) (by omega) A₀ hA₀'
      have hgδ : g ≫ δ = 0 := hom_shift_zero W (by omega) hA₁ _
      obtain ⟨x, hx⟩ := Triangle.coyoneda_exact₃ _ hT g hgδ
      dsimp at hx
      have hx0 : x = 0 := by
        have e : W.G⟦n⟧ ≅ W.G⟦-(-n)⟧ := eqToIso (by rw [neg_neg])
        rw [← cancel_epi e.inv, comp_zero]
        exact hY (-n) (by omega) _
      rw [hx, hx0, zero_comp]
  have hiso : IsIso ι := (Triangle.isZero₃_iff_isIso₁ _ hT).1 hBz
  exact (W.t.le (N + W.A - 1)).prop_of_iso (asIso ι) hA₀'

/-- `t^-` form of `bnp_3_10_1`. -/
theorem bnp_3_10_1_exists {Y : C} (hY : ∃ N : ℤ, ∀ k : ℤ, N ≤ k → ∀ f : W.G⟦-k⟧ ⟶ Y, f = 0) :
    ∃ m : ℤ, W.t.le m Y := by
  obtain ⟨N, hN⟩ := hY
  exact ⟨_, bnp_3_10_1 W hN⟩

/-! ### The dual bound and the preferred equivalence class -/

/-- **Coaisle bound.**  If `Hom(G[-k], V) = 0` for every `k ≤ c`, then
`V ∈ t^{≥ c - A + 1}`.  Proof: the first object `X` of the truncation triangle
of `V` at level `c - A` lies in every `t^{≤ c - A - j}` (iterated approximation
and `le_of_factor`), so all maps `G[n] → X` vanish and `X = 0`. -/
theorem ge_of_hom_vanishing {V : C} {c : ℤ}
    (hV : ∀ k : ℤ, k ≤ c → ∀ f : W.G⟦-k⟧ ⟶ V, f = 0) : W.t.ge (c - W.A + 1) V := by
  obtain ⟨X, B, hX, hB, ι, π, δ, hT⟩ := W.t.exists_triangle V (c - W.A) (c - W.A + 1) rfl
  have hXall : ∀ j : ℕ, W.t.le (c - W.A - j) X := by
    intro j
    obtain ⟨D, p, r, hD, hpr⟩ := exists_factor_iter W j hX
      (fun k _ hk₂ g => hV k (by omega) g) ι
    exact le_of_factor W.t hT (by omega) hX hB hD p r hpr
  have hXz : IsZero X := by
    apply W.G_paperGenerates
    intro n g
    have hj : (0 : ℤ) ≤ c + n + 1 + |c| + |n| := by
      have := abs_nonneg c; have := abs_nonneg n
      have := le_abs_self c; have := neg_abs_le c; have := le_abs_self n; have := neg_abs_le n
      omega
    have hX' := hXall (c + n + 1 + |c| + |n|).toNat
    rw [Int.toNat_of_nonneg hj] at hX'
    exact hom_shift_zero W (by
      have := le_abs_self c; have := neg_abs_le c; have := le_abs_self n; have := neg_abs_le n
      omega) hX' g
  have hiso : IsIso π := (Triangle.isZero₁_iff_isIso₂ _ hT).1 hXz
  exact (W.t.ge (c - W.A + 1)).prop_of_iso (asIso π).symm hB

/-- The compactly generated aisle of `W.G` lies in `t^{≤A}`. -/
theorem compactlyGenerated_le_of_le (t' : TStructure C)
    (ht' : t'.le 0 = Coprod (shiftTail W.G 0)) : t'.le 0 ≤ W.t.le W.A := by
  have (J : Type v) : (W.t.le W.A).IsClosedUnderColimitsOfShape (Discrete J) :=
    TStructure.le_isClosedUnderColimitsOfShape W.t W.A (Discrete J)
  have : (W.t.le W.A).IsTriangulatedClosed₂ := TStructure.le_isTriangulatedClosed₂ W.t W.A
  rw [ht']
  apply Coprod.le
  rintro X ⟨k, hk, ⟨e⟩⟩
  exact (W.t.le W.A).prop_of_iso e.symm
    (W.t.le_monotone (by omega) _ (G_shift_le W k))

/-- `t^{≤ -A}` lies in the compactly generated aisle of `W.G`. -/
theorem le_compactlyGenerated_of_le (t' : TStructure C)
    (ht' : t'.le 0 = Coprod (shiftTail W.G 0)) : W.t.le (-W.A) ≤ t'.le 0 := by
  intro X hX
  rw [TStructure.le_iff_isLE, t'.isLE_iff_orthogonal 0 1 (by omega)]
  intro V f hV'
  have hV : t'.ge 1 V := t'.ge_of_isGE V 1
  rw [CompactTStructureW6.ge_one_iff_of_compactlyGenerated W.G t' ht'] at hV
  have hVge : W.t.ge (0 - W.A + 1) V :=
    ge_of_hom_vanishing W (c := 0) (fun k hk g => hV (-k) (by omega) g)
  exact hom_zero_of_le_ge W.t (by omega) hX hVge f

end RelativeWeakApprox.WABoundsW6

