import WeakApprox.Setup44Reduced
import WeakApprox.Setup44Vanishing

/-!
# Setup 4.4 with only the irreducible hypotheses

`Setup44Reduced` (`WeakApprox/Setup44Reduced.lean`) removes the three fields of
Setup 4.4 that are conclusions of Lemma 4.3.  This file removes the rest of the
redundancy: the common bound `A` and the Hom-vanishing condition (3) are not
data either.

* The bound is not data: weak approximation data may be weakened to any larger
  bound (`WeakApproximationData.monoBound`), so the setup only needs two weak
  approximation data on the ends, and the common bound can be chosen afterwards.
* Condition (3), `Hom(G, D^{≤-A}) = 0`, is derived by
  `exists_setup_4_4_3` (`WeakApprox/Setup44Vanishing.lean`) from Lemma 4.3(4)
  and Lemma 3.5.

What remains in `Setup44Minimal` is exactly the paper's Setup 4.4 data together
with the compact-generation equations and Stacks 09SR, the latter as the
explicit `IsClassicalGeneratorOnCompacts G'` argument of `toSetup44`.  Note that
09SR is used only to produce condition (3); the compactness and generation of
the normalized generator are Lemma 4.3(2) and need no external input.
-/

@[expose] public section

namespace RelativeWeakApprox

open CategoryTheory CategoryTheory.Limits
open CategoryTheory.Pretriangulated CategoryTheory.Triangulated

universe v u uZ uD uU

section BoundMonotonicity

variable {C : Type u} [Category.{v} C] [HasZeroObject C] [HasShift C ℤ]
  [Preadditive C] [∀ (n : ℤ), (shiftFunctor C n).Additive] [Pretriangulated C]

/-- Weak approximation data may be weakened to any larger bound: the generator
stays in a larger aisle, the vanishing hypothesis holds on a smaller one, and
the approximation triangles only need a larger envelope. -/
def WeakApproximationData.monoBound (W : WeakApproximationData C) {A' : ℤ}
    (hA : W.A ≤ A') : WeakApproximationData C where
  G := W.G
  t := W.t
  A := A'
  A_pos := lt_of_lt_of_le W.A_pos hA
  G_compact := W.G_compact
  G_generates := W.G_generates
  G_mem_le := W.t.le_monotone hA W.G W.G_mem_le
  hom_vanishing := by
    intro Y hY f
    exact W.hom_vanishing (W.t.le_monotone (by omega) Y hY) f
  exists_triangle := by
    intro F hF
    obtain ⟨E, D, f, g, h, hT, hE, hD⟩ := W.exists_triangle F hF
    exact ⟨E, D, f, g, h, hT,
      lemma31_2_mono W.G (a := -W.A) (b := W.A) (a' := -A') (b' := A')
        (by omega) hA E hE, hD⟩

end BoundMonotonicity

section Setup

variable (DZ : Type uZ) (D : Type uD) (DU : Type uU)
  [Category.{v} DZ] [Category.{v} D] [Category.{v} DU]
  [Preadditive DZ] [Preadditive D] [Preadditive DU]
  [HasZeroObject DZ] [HasZeroObject D] [HasZeroObject DU]
  [HasShift DZ ℤ] [HasShift D ℤ] [HasShift DU ℤ]
  [∀ (n : ℤ), (shiftFunctor DZ n).Additive]
  [∀ (n : ℤ), (shiftFunctor D n).Additive]
  [∀ (n : ℤ), (shiftFunctor DU n).Additive]
  [Pretriangulated DZ] [Pretriangulated D] [Pretriangulated DU]
  [CategoryTheory.IsTriangulated DZ] [CategoryTheory.IsTriangulated D]
  [CategoryTheory.IsTriangulated DU]

/-- **Setup 4.4, minimal form.**  `Setup44Reduced` without the bound `A`, its
positivity and the Hom-vanishing condition (3): the bound is chosen after the
fact and (3) is derived. -/
structure Setup44Minimal where
  /-- The recollement. -/
  R : Recollement DZ D DU
  /-- The t-structure on `D`. -/
  tD : TStructure D
  /-- The t-structure on `D_Z`. -/
  tZ : TStructure DZ
  /-- The t-structure on `D_U`. -/
  tU : TStructure DU
  /-- Weak approximation data on `D_Z`, with its own bound. -/
  approxZ : WeakApproximationData DZ
  /-- Weak approximation data on `D_U`, with its own bound. -/
  approxU : WeakApproximationData DU
  /-- The compact generator of `D_U`. -/
  GU : DU
  /-- The compact generator of `D`. -/
  G' : D
  /-- `G'` is compact. -/
  G'_compact : IsCompactAb G'
  /-- `G'` generates. -/
  G'_generates : IsGenerator G'
  /-- Eventual positive self-Hom vanishing for `G'`. -/
  G'_eventual : ∃ N : ℤ, ∀ n : ℤ, N ≤ n → ∀ f : G' ⟶ G'⟦n⟧, f = 0
  /-- The normalizing shift. -/
  m : ℤ
  /-- The normalization bound `j^*G' ∈ D_U^{≤m}`. -/
  jStar_G'_mem : tU.le m (R.jStar.obj G')
  /-- The binary biproduct defining the normalized generator. -/
  [normalized_biproduct : HasBinaryBiproduct (G'⟦m⟧) (R.jShriek.obj GU)]
  /-- `D^{≤0}` is compactly generated by the normalized generator. -/
  tD_compactlyGenerated :
    tD.le 0 = Coprod (shiftTail (G'⟦m⟧ ⊞ R.jShriek.obj GU) 0)
  /-- `D_Z^{≤0}` is compactly generated by `i^*G`. -/
  tZ_compactlyGenerated :
    tZ.le 0 = Coprod (shiftTail (R.iStar.obj (G'⟦m⟧ ⊞ R.jShriek.obj GU)) 0)
  /-- `D_U^{≤0}` is compactly generated by `GU`. -/
  tU_compactlyGenerated : tU.le 0 = Coprod (shiftTail GU 0)
  /-- The data on `D_Z` uses `tZ`. -/
  approxZ_t : approxZ.t = tZ
  /-- The data on `D_U` uses `tU`. -/
  approxU_t : approxU.t = tU
  /-- The generator of the data on `D_Z` is `i^*G`. -/
  approxZ_G : approxZ.G = R.iStar.obj (G'⟦m⟧ ⊞ R.jShriek.obj GU)
  /-- The generator of the data on `D_U` is `GU`. -/
  approxU_G : approxU.G = GU

end Setup

namespace Setup44Minimal

variable {DZ D DU}
  [Category.{v} DZ] [Category.{v} D] [Category.{v} DU]
  [Preadditive DZ] [Preadditive D] [Preadditive DU]
  [HasZeroObject DZ] [HasZeroObject D] [HasZeroObject DU]
  [HasShift DZ ℤ] [HasShift D ℤ] [HasShift DU ℤ]
  [∀ (n : ℤ), (shiftFunctor DZ n).Additive]
  [∀ (n : ℤ), (shiftFunctor D n).Additive]
  [∀ (n : ℤ), (shiftFunctor DU n).Additive]
  [Pretriangulated DZ] [Pretriangulated D] [Pretriangulated DU]
  [CategoryTheory.IsTriangulated DZ] [CategoryTheory.IsTriangulated D]
  [CategoryTheory.IsTriangulated DU]

variable (S : Setup44Minimal DZ D DU)

/-- `GU` is compact, transported from the data on `D_U`. -/
theorem GU_compact : IsCompactAb S.GU := by
  rw [← S.approxU_G]
  exact S.approxU.G_compact

/-- The paper's Setup 4.4, from the minimal data and Stacks 09SR.

The bound is `max A₀ (max approxZ.A approxU.A)`, where `A₀ > 0` is the bound
produced by `exists_setup_4_4_3`; both weak approximation data are weakened to
it. -/
noncomputable def toSetup44Reduced (hgen : IsClassicalGeneratorOnCompacts S.G') :
    Setup44Reduced DZ D DU := by
  classical
  have hG' : EventuallyHomZero S.G' S.G' := S.G'_eventual
  have haisle : S.tD.le 0 = Coprod (shiftTail (S.G'⟦S.m⟧ ⊞ S.R.jShriek.obj S.GU) 0) :=
    S.tD_compactlyGenerated
  let hex : ∃ A : ℤ, 0 < A ∧
      (∀ {Y : D}, S.tD.le (-A) Y →
        ∀ f : (S.G'⟦S.m⟧ ⊞ S.R.jShriek.obj S.GU) ⟶ Y, f = 0) :=
    (exists_setup_4_4_3 S.R S.tD S.G' S.GU S.m S.G'_compact S.GU_compact hG'
      hgen haisle).imp fun A hA => ⟨hA.1, hA.2.2⟩
  let A₀ : ℤ := hex.choose
  have hA₀pos : 0 < A₀ := hex.choose_spec.1
  have hvan₀ : ∀ {Y : D}, S.tD.le (-A₀) Y →
      ∀ f : (S.G'⟦S.m⟧ ⊞ S.R.jShriek.obj S.GU) ⟶ Y, f = 0 :=
    hex.choose_spec.2
  let A : ℤ := max A₀ (max S.approxZ.A S.approxU.A)
  have hA₀ : A₀ ≤ A := le_max_left _ _
  have hAZ : S.approxZ.A ≤ A := le_trans (le_max_left _ _) (le_max_right _ _)
  have hAU : S.approxU.A ≤ A := le_trans (le_max_right _ _) (le_max_right _ _)
  have hpos : 0 < A := lt_of_lt_of_le hA₀pos hA₀
  refine
    { R := S.R
      tD := S.tD
      tZ := S.tZ
      tU := S.tU
      approxZ := S.approxZ.monoBound hAZ
      approxU := S.approxU.monoBound hAU
      GU := S.GU
      G' := S.G'
      G'_compact := S.G'_compact
      G'_generates := S.G'_generates
      G'_eventual := S.G'_eventual
      m := S.m
      jStar_G'_mem := S.jStar_G'_mem
      normalized_biproduct := S.normalized_biproduct
      tD_compactlyGenerated := S.tD_compactlyGenerated
      tZ_compactlyGenerated := S.tZ_compactlyGenerated
      tU_compactlyGenerated := S.tU_compactlyGenerated
      A := A
      A_pos := hpos
      approxZ_t := S.approxZ_t
      approxU_t := S.approxU_t
      approxZ_G := S.approxZ_G
      approxU_G := S.approxU_G
      approxZ_A := rfl
      approxU_A := rfl
      G_hom_vanishing := fun {Y} hY f => hvan₀ (S.tD.le_monotone (by omega) Y hY) f }

variable [HasCoproducts.{v} DZ] [HasCoproducts.{v} D] [HasCoproducts.{v} DU]

/-- The paper's Setup 4.4 from the minimal data and Stacks 09SR. -/
noncomputable def toSetup44 (hgen : IsClassicalGeneratorOnCompacts S.G') :
    Setup44 DZ D DU :=
  (S.toSetup44Reduced hgen).toSetup44

end Setup44Minimal

end RelativeWeakApprox

#print axioms RelativeWeakApprox.WeakApproximationData.monoBound
#print axioms RelativeWeakApprox.Setup44Minimal.toSetup44Reduced
#print axioms RelativeWeakApprox.Setup44Minimal.toSetup44
