import WeakApprox.PaperMainMinimalM2

/-!
# Lemma 4.3(1): the actual boundedness input

LP's proof of Lemma 4.3(1) invokes Burke--Neeman--Pauwels, *Gluing
approximable triangulated categories*, Forum Math. Sigma 11 (2023), Corollary
3.10(1), not a morphism-separation argument. We state that theorem as a named
input and derive Lemma 4.3(1) using zero detection throughout. No part of this
file claims to prove the BNP theorem.
-/

@[expose] public section

namespace RelativeWeakApprox.PaperM2

open CategoryTheory CategoryTheory.Limits
open CategoryTheory.Pretriangulated CategoryTheory.Triangulated
open RelativeWeakApprox

universe v u uZ uD uU

section BNP

variable {C : Type u} [Category.{v} C] [Preadditive C]
  [HasZeroObject C] [HasShift C ℤ] [∀ (n : ℤ), (shiftFunctor C n).Additive]
  [Pretriangulated C] [HasCoproducts.{v} C]

/-- Burke--Neeman--Pauwels, Corollary 3.10(1), in the generality used by LP.

The `t`-structure is compactly generated by the chosen compact generator,
hence is in the preferred equivalence class. Weak approximability is supplied
by the first argument. The conclusion is literally BNP's bounded-above
assertion. -/
def BNP310Input (C : Type u) [Category.{v} C] [Preadditive C]
    [HasZeroObject C] [HasShift C ℤ] [∀ (n : ℤ), (shiftFunctor C n).Additive]
    [Pretriangulated C] [HasCoproducts.{v} C] : Prop :=
  ∀ (_ : SatisfiesPaperWA C) (G : C) (t : TStructure C),
    IsCompactAb G → IsPaperGenerator G →
    t.le 0 = Coprod (shiftTail G 0) →
    ∀ {Y : C}, (∃ N : ℤ, ∀ n : ℤ, N ≤ n → ∀ f : G⟦-n⟧ ⟶ Y, f = 0) →
      ∃ m : ℤ, t.le m Y

end BNP

section Recollement

variable {DZ : Type uZ} {D : Type uD} {DU : Type uU}
  [Category.{v} DZ] [Category.{v} D] [Category.{v} DU]
  [Preadditive DZ] [Preadditive D] [Preadditive DU]
  [HasZeroObject DZ] [HasZeroObject D] [HasZeroObject DU]
  [HasShift DZ ℤ] [HasShift D ℤ] [HasShift DU ℤ]
  [∀ (n : ℤ), (shiftFunctor DZ n).Additive]
  [∀ (n : ℤ), (shiftFunctor D n).Additive]
  [∀ (n : ℤ), (shiftFunctor DU n).Additive]
  [Pretriangulated DZ] [Pretriangulated D] [Pretriangulated DU]
  [CategoryTheory.IsTriangulated DZ] [CategoryTheory.IsTriangulated D]
  [CategoryTheory.IsTriangulated DU]

/-- LP Lemma 4.3(1) with zero-detection generation. The finite-thick-envelope
argument is unchanged; the final boundedness step is precisely BNP 3.10(1).
In particular `hGUgen` is not promoted to morphism separation. -/
theorem lemma_4_3_1_paper [HasCoproducts.{v} DU]
    (R : Recollement DZ D DU) (tU : TStructure DU)
    (WU : PaperWeakApproximationData DU) (G' : D) (GU : DU)
    (hG' : EventuallyHomZero G' G')
    (hgen : IsClassicalGeneratorOnCompacts G')
    (hGUcompact : IsCompactAb GU) (hGUgen : IsPaperGenerator GU)
    (htU : tU.le 0 = Coprod (shiftTail GU 0))
    (hBNP : BNP310Input DU) :
    ∃ m : ℤ, 0 ≤ m ∧ tU.le m (R.jStar.obj G') := by
  have hjCompact : IsCompactAb (R.jShriek.obj GU) :=
    R.isCompactAb_jShriek_obj hGUcompact
  have hG'mem : (ObjectProperty.singleton G').triangEnvelope G' :=
    ObjectProperty.le_triangEnvelope _ _ ((ObjectProperty.singleton_iff _ _).2 rfl)
  have he : EventuallyHomZero (R.jShriek.obj GU) G' :=
    eventuallyHomZero_of_mem_triangEnvelope hG' (hgen _ hjCompact) hG'mem
  obtain ⟨N, hN⟩ := he
  have hvan : ∃ N : ℤ, ∀ n : ℤ, N ≤ n →
      ∀ g : GU⟦-n⟧ ⟶ R.jStar.obj G', g = 0 := by
    refine ⟨N, fun n hn g => ?_⟩
    exact hom_zero_of_adjunction_of_eventuallyHomZero
      R.jShriek R.jStar R.jShriekAdj hN hn g
  obtain ⟨m, hm⟩ := hBNP ⟨WU⟩ GU tU hGUcompact hGUgen htU hvan
  exact ⟨max m 0, le_max_right _ _, tU.le_monotone (le_max_left _ _) _ hm⟩

end Recollement

end RelativeWeakApprox.PaperM2

#print axioms RelativeWeakApprox.PaperM2.BNP310Input
#print axioms RelativeWeakApprox.PaperM2.lemma_4_3_1_paper
