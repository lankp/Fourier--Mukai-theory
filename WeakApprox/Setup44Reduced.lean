import WeakApprox.Main
import WeakApprox.Lemma4323

/-!
# Setup 4.4 with the derivable fields removed

Three fields of `Setup44` are conclusions of Lemma 4.3 rather than hypotheses of
the paper's setup, and are proved here instead of assumed:

* `G_compact`, from compactness of `G'` and of `G_U` and closure of
  `IsCompactAb` under binary biproducts (Lemma 4.3(2));
* `G_generates`, from generation of `G'` (Lemma 4.3(2));
* `tD_glued`, from the three compact-generation equations and the normalization
  bound, by Lemma 4.3(3).

`Setup44Reduced` therefore carries only the paper's data, and `toSetup44`
reconstructs the full structure.  The same reduction is given for `SetupMain`,
i.e. without the eventual-vanishing field of the forward direction of
Theorem 1.1.

Found by a member of the Ultramath run `smwur4wqg` (direction D1).
-/

@[expose] public section

namespace RelativeWeakApprox

open CategoryTheory CategoryTheory.Limits
open CategoryTheory.Pretriangulated CategoryTheory.Triangulated

universe v uZ uD uU

section ReducedDeclarations

variable (DZ : Type uZ) (D : Type uD) (DU : Type uU)
  [Category.{v} DZ] [Category.{v} D] [Category.{v} DU]
  [Preadditive DZ] [Preadditive D] [Preadditive DU]
  [HasZeroObject DZ] [HasZeroObject D] [HasZeroObject DU]
  [HasShift DZ ℤ] [HasShift D ℤ] [HasShift DU ℤ]
  [∀ (n : ℤ), (shiftFunctor DZ n).Additive]
  [∀ (n : ℤ), (shiftFunctor D n).Additive]
  [∀ (n : ℤ), (shiftFunctor DU n).Additive]
  [Pretriangulated DZ] [Pretriangulated D] [Pretriangulated DU]
  [CategoryTheory.IsTriangulated DZ] [CategoryTheory.IsTriangulated D]
  [CategoryTheory.IsTriangulated DU]

/-- **Setup 4.4, reduced by Lemma 4.3(2)--(3).** This has exactly the fields
of `Setup44` except `G_compact`, `G_generates`, and `tD_glued`; all three are
reconstructed in `Setup44Reduced.toSetup44`. A common hom universe is used
because `Coprod` and the compactness and gluing lemmas are indexed by it. -/
structure Setup44Reduced where
  /-- The recollement of Setup 4.4. -/
  R : Recollement DZ D DU
  /-- The t-structure on `D`. -/
  tD : TStructure D
  /-- The t-structure on `D_Z`. -/
  tZ : TStructure DZ
  /-- The t-structure on `D_U`. -/
  tU : TStructure DU
  /-- Weak approximation data on `D_Z`, as in Setup 4.4. -/
  approxZ : WeakApproximationData DZ
  /-- Weak approximation data on `D_U`, as in Setup 4.4. -/
  approxU : WeakApproximationData DU
  /-- The chosen compact generator of `D_U`. -/
  GU : DU
  /-- The chosen compact generator of `D` in Lemma 4.3. -/
  G' : D
  /-- `G'` is compact, an input to Lemma 4.3(2). -/
  G'_compact : IsCompactAb G'
  /-- `G'` generates, an input to Lemma 4.3(2). -/
  G'_generates : IsGenerator G'
  /-- Eventual positive self-Hom vanishing for `G'`, as used in Setup 4.4. -/
  G'_eventual : ∃ N : ℤ, ∀ n : ℤ, N ≤ n → ∀ f : G' ⟶ G'⟦n⟧, f = 0
  /-- The normalizing shift of Lemma 4.3(1). -/
  m : ℤ
  /-- The normalization bound `j^*G' ∈ D_U^{≤m}` of Lemma 4.3(1). -/
  jStar_G'_mem : tU.le m (R.jStar.obj G')
  /-- The particular binary biproduct defining the normalized generator. -/
  [normalized_biproduct : HasBinaryBiproduct (G'⟦m⟧) (R.jShriek.obj GU)]
  /-- The degree-zero aisle on `D` is compactly generated by the normalized
  generator. This is not a field of `WeakApproximationData`. -/
  tD_compactlyGenerated :
    tD.le 0 = Coprod (shiftTail (G'⟦m⟧ ⊞ R.jShriek.obj GU) 0)
  /-- The degree-zero aisle on `D_Z` is compactly generated by `i^*G`. -/
  tZ_compactlyGenerated :
    tZ.le 0 = Coprod (shiftTail (R.iStar.obj (G'⟦m⟧ ⊞ R.jShriek.obj GU)) 0)
  /-- The degree-zero aisle on `D_U` is compactly generated by `GU`. -/
  tU_compactlyGenerated : tU.le 0 = Coprod (shiftTail GU 0)
  /-- The data on `D_Z` has the displayed t-structure. -/
  approxZ_t : approxZ.t = tZ
  /-- The data on `D_U` has the displayed t-structure. -/
  approxU_t : approxU.t = tU
  /-- The generator of the data on `D_Z` is `i^*G`. -/
  approxZ_G : approxZ.G = R.iStar.obj (G'⟦m⟧ ⊞ R.jShriek.obj GU)
  /-- The generator of the data on `D_U` is `GU`. -/
  approxU_G : approxU.G = GU
  /-- The chosen common bound. -/
  A : ℤ
  /-- Positivity of the common bound. -/
  A_pos : 0 < A
  /-- The data on `D_Z` uses the common bound. -/
  approxZ_A : approxZ.A = A
  /-- The data on `D_U` uses the common bound. -/
  approxU_A : approxU.A = A
  /-- Setup 4.4(3): Hom from the normalized generator into `D^{≤-A}` vanishes. -/
  G_hom_vanishing : ∀ {Y : D}, tD.le (-A) Y →
    ∀ f : (G'⟦m⟧ ⊞ R.jShriek.obj GU) ⟶ Y, f = 0

/-- **Theorem 1.1 setup, reduced by Lemma 4.3(2)--(3).** This is
`Setup44Reduced` without the eventual-vanishing field, exactly as `SetupMain`
is `Setup44` without that field. -/
structure SetupMainReduced where
  /-- The recollement of Setup 4.4. -/
  R : Recollement DZ D DU
  /-- The t-structure on `D`. -/
  tD : TStructure D
  /-- The t-structure on `D_Z`. -/
  tZ : TStructure DZ
  /-- The t-structure on `D_U`. -/
  tU : TStructure DU
  /-- Weak approximation data on `D_Z`. -/
  approxZ : WeakApproximationData DZ
  /-- Weak approximation data on `D_U`. -/
  approxU : WeakApproximationData DU
  /-- The chosen compact generator of `D_U`. -/
  GU : DU
  /-- The chosen compact generator of `D`. -/
  G' : D
  /-- `G'` is compact. -/
  G'_compact : IsCompactAb G'
  /-- `G'` generates. -/
  G'_generates : IsGenerator G'
  /-- The normalizing shift of Lemma 4.3(1). -/
  m : ℤ
  /-- The normalization bound for `j^*G'`. -/
  jStar_G'_mem : tU.le m (R.jStar.obj G')
  /-- The particular binary biproduct defining the normalized generator. -/
  [normalized_biproduct : HasBinaryBiproduct (G'⟦m⟧) (R.jShriek.obj GU)]
  /-- The degree-zero aisle on `D` is compactly generated by the normalized
  generator. -/
  tD_compactlyGenerated :
    tD.le 0 = Coprod (shiftTail (G'⟦m⟧ ⊞ R.jShriek.obj GU) 0)
  /-- The degree-zero aisle on `D_Z` is compactly generated by `i^*G`. -/
  tZ_compactlyGenerated :
    tZ.le 0 = Coprod (shiftTail (R.iStar.obj (G'⟦m⟧ ⊞ R.jShriek.obj GU)) 0)
  /-- The degree-zero aisle on `D_U` is compactly generated by `GU`. -/
  tU_compactlyGenerated : tU.le 0 = Coprod (shiftTail GU 0)
  /-- The data on `D_Z` has the displayed t-structure. -/
  approxZ_t : approxZ.t = tZ
  /-- The data on `D_U` has the displayed t-structure. -/
  approxU_t : approxU.t = tU
  /-- The generator of the data on `D_Z` is `i^*G`. -/
  approxZ_G : approxZ.G = R.iStar.obj (G'⟦m⟧ ⊞ R.jShriek.obj GU)
  /-- The generator of the data on `D_U` is `GU`. -/
  approxU_G : approxU.G = GU
  /-- The chosen common bound. -/
  A : ℤ
  /-- Positivity of the common bound. -/
  A_pos : 0 < A
  /-- The data on `D_Z` uses the common bound. -/
  approxZ_A : approxZ.A = A
  /-- The data on `D_U` uses the common bound. -/
  approxU_A : approxU.A = A
  /-- Setup 4.4(3): Hom from the normalized generator into `D^{≤-A}` vanishes. -/
  G_hom_vanishing : ∀ {Y : D}, tD.le (-A) Y →
    ∀ f : (G'⟦m⟧ ⊞ R.jShriek.obj GU) ⟶ Y, f = 0

end ReducedDeclarations

namespace Setup44Reduced

variable {DZ : Type uZ} {D : Type uD} {DU : Type uU}
  [Category.{v} DZ] [Category.{v} D] [Category.{v} DU]
  [Preadditive DZ] [Preadditive D] [Preadditive DU]
  [HasZeroObject DZ] [HasZeroObject D] [HasZeroObject DU]
  [HasShift DZ ℤ] [HasShift D ℤ] [HasShift DU ℤ]
  [∀ (n : ℤ), (shiftFunctor DZ n).Additive]
  [∀ (n : ℤ), (shiftFunctor D n).Additive]
  [∀ (n : ℤ), (shiftFunctor DU n).Additive]
  [Pretriangulated DZ] [Pretriangulated D] [Pretriangulated DU]
  [CategoryTheory.IsTriangulated DZ] [CategoryTheory.IsTriangulated D]
  [CategoryTheory.IsTriangulated DU]

/-- Compactness of `GU`, transported from the weak approximation data on `D_U`.
This is the `D_U` input to Lemma 4.3(2). -/
theorem GU_compact (S : Setup44Reduced DZ D DU) : IsCompactAb S.GU := by
  rw [← S.approxU_G]
  exact S.approxU.G_compact

/-- **Lemma 4.3(2), compactness.** The normalized generator is compact because
shifts and `j_!` preserve compactness and compact objects are closed under the
chosen binary biproduct. -/
theorem G_compact (S : Setup44Reduced DZ D DU) :
    IsCompactAb (S.G'⟦S.m⟧ ⊞ S.R.jShriek.obj S.GU) :=
  isCompactAb_biprod (isCompactAb_shift S.G' S.m S.G'_compact)
    (recollement_jShriek_compact S.R S.GU_compact)

/-- **Lemma 4.3(2), generation.** Generation of the normalized generator
follows from generation of `G'`; no generation hypothesis on `GU` is needed. -/
theorem G_generates (S : Setup44Reduced DZ D DU) :
    IsGenerator (S.G'⟦S.m⟧ ⊞ S.R.jShriek.obj S.GU) :=
  (lemma_4_3_2_generation S.R S.G' S.GU S.m S.G'_generates).1

/-- **Lemma 4.3(3).** The three retained compact-generation equations and the
normalization bound determine the degree-zero aisle on `D` as the glued aisle. -/
theorem tD_glued (S : Setup44Reduced DZ D DU) :
    S.tD.le 0 = gluedLe S.R.iStar S.R.jStar S.tZ S.tU 0 :=
  lemma_4_3_3 S.R S.tD S.tZ S.tU S.G' S.GU S.m S.jStar_G'_mem
    S.tD_compactlyGenerated S.tZ_compactlyGenerated S.tU_compactlyGenerated

/-- Reconstruct the original **Setup 4.4** package. The only non-forgetful
fields are the three conclusions of Lemma 4.3(2)--(3) proved above. -/
def toSetup44 (S : Setup44Reduced DZ D DU) : Setup44 DZ D DU where
  R := S.R
  tD := S.tD
  tZ := S.tZ
  tU := S.tU
  approxZ := S.approxZ
  approxU := S.approxU
  GU := S.GU
  G' := S.G'
  G'_compact := S.G'_compact
  G'_generates := S.G'_generates
  G'_eventual := S.G'_eventual
  m := S.m
  jStar_G'_mem := S.jStar_G'_mem
  normalized_biproduct := S.normalized_biproduct
  G_compact := S.G_compact
  G_generates := S.G_generates
  tD_compactlyGenerated := S.tD_compactlyGenerated
  tZ_compactlyGenerated := S.tZ_compactlyGenerated
  tU_compactlyGenerated := S.tU_compactlyGenerated
  tD_glued := S.tD_glued
  approxZ_t := S.approxZ_t
  approxU_t := S.approxU_t
  approxZ_G := S.approxZ_G
  approxU_G := S.approxU_G
  A := S.A
  A_pos := S.A_pos
  approxZ_A := S.approxZ_A
  approxU_A := S.approxU_A
  G_hom_vanishing := S.G_hom_vanishing

end Setup44Reduced

namespace Setup44

variable {DZ : Type uZ} {D : Type uD} {DU : Type uU}
  [Category.{v} DZ] [Category.{v} D] [Category.{v} DU]
  [Preadditive DZ] [Preadditive D] [Preadditive DU]
  [HasZeroObject DZ] [HasZeroObject D] [HasZeroObject DU]
  [HasShift DZ ℤ] [HasShift D ℤ] [HasShift DU ℤ]
  [∀ (n : ℤ), (shiftFunctor DZ n).Additive]
  [∀ (n : ℤ), (shiftFunctor D n).Additive]
  [∀ (n : ℤ), (shiftFunctor DU n).Additive]
  [Pretriangulated DZ] [Pretriangulated D] [Pretriangulated DU]
  [CategoryTheory.IsTriangulated DZ] [CategoryTheory.IsTriangulated D]
  [CategoryTheory.IsTriangulated DU]

/-- Forget the three derivable conclusions of **Lemma 4.3(2)--(3)** in the
original Setup 4.4 package. -/
def toReduced (S : Setup44 DZ D DU) : Setup44Reduced DZ D DU where
  R := S.R
  tD := S.tD
  tZ := S.tZ
  tU := S.tU
  approxZ := S.approxZ
  approxU := S.approxU
  GU := S.GU
  G' := S.G'
  G'_compact := S.G'_compact
  G'_generates := S.G'_generates
  G'_eventual := S.G'_eventual
  m := S.m
  jStar_G'_mem := S.jStar_G'_mem
  normalized_biproduct := S.normalized_biproduct
  tD_compactlyGenerated := S.tD_compactlyGenerated
  tZ_compactlyGenerated := S.tZ_compactlyGenerated
  tU_compactlyGenerated := S.tU_compactlyGenerated
  approxZ_t := S.approxZ_t
  approxU_t := S.approxU_t
  approxZ_G := S.approxZ_G
  approxU_G := S.approxU_G
  A := S.A
  A_pos := S.A_pos
  approxZ_A := S.approxZ_A
  approxU_A := S.approxU_A
  G_hom_vanishing := S.G_hom_vanishing

end Setup44

namespace SetupMainReduced

variable {DZ : Type uZ} {D : Type uD} {DU : Type uU}
  [Category.{v} DZ] [Category.{v} D] [Category.{v} DU]
  [Preadditive DZ] [Preadditive D] [Preadditive DU]
  [HasZeroObject DZ] [HasZeroObject D] [HasZeroObject DU]
  [HasShift DZ ℤ] [HasShift D ℤ] [HasShift DU ℤ]
  [∀ (n : ℤ), (shiftFunctor DZ n).Additive]
  [∀ (n : ℤ), (shiftFunctor D n).Additive]
  [∀ (n : ℤ), (shiftFunctor DU n).Additive]
  [Pretriangulated DZ] [Pretriangulated D] [Pretriangulated DU]
  [CategoryTheory.IsTriangulated DZ] [CategoryTheory.IsTriangulated D]
  [CategoryTheory.IsTriangulated DU]

/-- Compactness of `GU` from the data on `D_U`, for the reduced Theorem 1.1
setup and Lemma 4.3(2). -/
theorem GU_compact (S : SetupMainReduced DZ D DU) : IsCompactAb S.GU := by
  rw [← S.approxU_G]
  exact S.approxU.G_compact

/-- **Lemma 4.3(2), compactness**, for the reduced Theorem 1.1 setup. -/
theorem G_compact (S : SetupMainReduced DZ D DU) :
    IsCompactAb (S.G'⟦S.m⟧ ⊞ S.R.jShriek.obj S.GU) :=
  isCompactAb_biprod (isCompactAb_shift S.G' S.m S.G'_compact)
    (recollement_jShriek_compact S.R S.GU_compact)

/-- **Lemma 4.3(2), generation**, for the reduced Theorem 1.1 setup. -/
theorem G_generates (S : SetupMainReduced DZ D DU) :
    IsGenerator (S.G'⟦S.m⟧ ⊞ S.R.jShriek.obj S.GU) :=
  (lemma_4_3_2_generation S.R S.G' S.GU S.m S.G'_generates).1

/-- **Lemma 4.3(3)**, for the reduced Theorem 1.1 setup: the normalized aisle
is the glued aisle. -/
theorem tD_glued (S : SetupMainReduced DZ D DU) :
    S.tD.le 0 = gluedLe S.R.iStar S.R.jStar S.tZ S.tU 0 :=
  lemma_4_3_3 S.R S.tD S.tZ S.tU S.G' S.GU S.m S.jStar_G'_mem
    S.tD_compactlyGenerated S.tZ_compactlyGenerated S.tU_compactlyGenerated

/-- Adjoin the eventual-vanishing hypothesis of **Theorem 1.1** to obtain the
reduced Setup 4.4 package. -/
def toSetup44Reduced (S : SetupMainReduced DZ D DU)
    (hG' : ∃ N : ℤ, ∀ n : ℤ, N ≤ n → ∀ f : S.G' ⟶ S.G'⟦n⟧, f = 0) :
    Setup44Reduced DZ D DU where
  R := S.R
  tD := S.tD
  tZ := S.tZ
  tU := S.tU
  approxZ := S.approxZ
  approxU := S.approxU
  GU := S.GU
  G' := S.G'
  G'_compact := S.G'_compact
  G'_generates := S.G'_generates
  G'_eventual := hG'
  m := S.m
  jStar_G'_mem := S.jStar_G'_mem
  normalized_biproduct := S.normalized_biproduct
  tD_compactlyGenerated := S.tD_compactlyGenerated
  tZ_compactlyGenerated := S.tZ_compactlyGenerated
  tU_compactlyGenerated := S.tU_compactlyGenerated
  approxZ_t := S.approxZ_t
  approxU_t := S.approxU_t
  approxZ_G := S.approxZ_G
  approxU_G := S.approxU_G
  A := S.A
  A_pos := S.A_pos
  approxZ_A := S.approxZ_A
  approxU_A := S.approxU_A
  G_hom_vanishing := S.G_hom_vanishing

/-- Reduced form of `SetupMain.toSetup44`: only eventual vanishing must be
added; the three Lemma 4.3(2)--(3) conclusions are proved, not assumed. -/
def toSetup44 (S : SetupMainReduced DZ D DU)
    (hG' : ∃ N : ℤ, ∀ n : ℤ, N ≤ n → ∀ f : S.G' ⟶ S.G'⟦n⟧, f = 0) :
    Setup44 DZ D DU :=
  (S.toSetup44Reduced hG').toSetup44

/-- Reconstruct the original `SetupMain` package from its reduced form, using
Lemma 4.3(2)--(3) for the three omitted fields. -/
def toSetupMain (S : SetupMainReduced DZ D DU) : SetupMain DZ D DU where
  R := S.R
  tD := S.tD
  tZ := S.tZ
  tU := S.tU
  approxZ := S.approxZ
  approxU := S.approxU
  GU := S.GU
  G' := S.G'
  G'_compact := S.G'_compact
  G'_generates := S.G'_generates
  m := S.m
  jStar_G'_mem := S.jStar_G'_mem
  normalized_biproduct := S.normalized_biproduct
  G_compact := S.G_compact
  G_generates := S.G_generates
  tD_compactlyGenerated := S.tD_compactlyGenerated
  tZ_compactlyGenerated := S.tZ_compactlyGenerated
  tU_compactlyGenerated := S.tU_compactlyGenerated
  tD_glued := S.tD_glued
  approxZ_t := S.approxZ_t
  approxU_t := S.approxU_t
  approxZ_G := S.approxZ_G
  approxU_G := S.approxU_G
  A := S.A
  A_pos := S.A_pos
  approxZ_A := S.approxZ_A
  approxU_A := S.approxU_A
  G_hom_vanishing := S.G_hom_vanishing

end SetupMainReduced

