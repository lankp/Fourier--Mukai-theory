import WeakApprox.MainMinimal

/-!
# Statement audit: Lemma 3.5 and Theorem 1.1 are the paper's text-forms

`WeakApprox/TStructureConvention.lean` settles the grading convention.  This
file audits the *statements* against the paper's wording, under the
identification `paper[n] = ⟦n⟧`.

* `EventuallyHomZero X Y` is, by definition, the paper's
  `Hom(X, Y[n]) = 0` for `n ≫ 0` (`eventuallyHomZero_iff_paper`, `Iff.rfl`).
* The hypothesis and conclusion of `lemma_3_5` are definitionally the paper's
  `lem:hom_vanishing` (`lemma_3_5_hypothesis_iff_paper`,
  `lemma_3_5_conclusion_iff_paper`), and `lemma_3_5_paper` is that lemma
  verbatim.
* `SetupMainMinimal.theorem_1_1` is the paper's `thm:glueing_weak_approx`
  verbatim (`theorem_1_1_statement_iff_paper`, `theorem_1_1_paper`).

The substantive new lemma is `le_neg_eq_coprod_shiftTail`: if `t.le 0` is
compactly generated by `H`, then `t.le (-n₀) = Coprod {H⟦n⟧ : n ≥ n₀}`.  This is
the paper's `T^{≤-n₀} = T^{≤0}[n₀]`, and it is the aisle identity used in the
proof of `lem:hom_vanishing`; the same sign `+n₀` occurs on both sides, so no
opposite-shift correction is needed anywhere.

Found by a member of the Ultramath run `smwuug9t7` (direction D3).
-/

@[expose] public section

namespace RelativeWeakApprox

open CategoryTheory CategoryTheory.Limits
open CategoryTheory.Pretriangulated CategoryTheory.Triangulated

universe v u uZ uD uU

section HomPredicates

variable {C : Type u} [Category.{v} C] [HasZeroObject C] [HasShift C ℤ]
  [Preadditive C] [∀ (n : ℤ), (shiftFunctor C n).Additive] [Pretriangulated C]

/-- Text-form `Hom(X,Y) = 0`: every morphism from `X` to `Y` is zero. -/
def PaperHomZero (X Y : C) : Prop := ∀ f : X ⟶ Y, f = 0

/-- The condition in `thm:glueing_weak_approx` and in Lemma 4.3 of
Lank--Pauwels: `Hom(X,Y[n]) = 0` for all sufficiently large positive `n`.
Here paper `[n]` is literally `⟦n⟧`. -/
def PaperEventuallyHomZero (X Y : C) : Prop :=
  ∃ N : ℤ, ∀ n : ℤ, N ≤ n → PaperHomZero X (Y⟦n⟧)

omit [HasZeroObject C] [∀ (n : ℤ), (shiftFunctor C n).Additive] [Pretriangulated C] in
/-- The two eventual-vanishing predicates are definitionally the same.  In
particular, the library's cutoff is `N ≤ n`, not `n ≤ N`, and its target is
`Y⟦n⟧`, not `Y⟦-n⟧`. -/
theorem eventuallyHomZero_iff_paper (X Y : C) :
    EventuallyHomZero X Y ↔ PaperEventuallyHomZero X Y := Iff.rfl

omit [HasZeroObject C] [HasShift C ℤ] [∀ (n : ℤ), (shiftFunctor C n).Additive]
  [Pretriangulated C] in
/-- The morphismwise rendering of `Hom(X,Y) = 0` agrees with subsingletonness
of the Hom type. -/
theorem paperHomZero_iff_subsingleton (X Y : C) :
    PaperHomZero X Y ↔ Subsingleton (X ⟶ Y) := by
  constructor
  · intro h
    exact ⟨fun f g => by rw [h f, h g]⟩
  · intro h f
    exact @Subsingleton.elim _ h f 0

/-- The hypothesis of paper `lem:hom_vanishing` (Lemma 3.5):
`Hom(H,H[n]) = 0` for every `n ≥ n₀`, with the same sign of `n` as in Lean. -/
def PaperLemma35Hypothesis (H : C) (n₀ : ℤ) : Prop :=
  ∀ n : ℤ, n₀ ≤ n → PaperHomZero H (H⟦n⟧)

/-- The conclusion of paper `lem:hom_vanishing` (Lemma 3.5):
`Hom(H,T^{≤-n₀}) = 0`. -/
def PaperLemma35Conclusion (t : TStructure C) (H : C) (n₀ : ℤ) : Prop :=
  ∀ {Y : C}, t.le (-n₀) Y → PaperHomZero H Y

omit [HasZeroObject C] [∀ (n : ℤ), (shiftFunctor C n).Additive] [Pretriangulated C] in
/-- The library's Lemma 3.5 hypothesis is definitionally the paper's, without
replacing `n₀` by `-n₀` or `H⟦n⟧` by `H⟦-n⟧`. -/
theorem lemma_3_5_hypothesis_iff_paper (H : C) (n₀ : ℤ) :
    (∀ n : ℤ, n₀ ≤ n → ∀ f : H ⟶ H⟦n⟧, f = 0) ↔
      PaperLemma35Hypothesis H n₀ := Iff.rfl

/-- The library's Lemma 3.5 conclusion is definitionally the paper's. -/
theorem lemma_3_5_conclusion_iff_paper (t : TStructure C) (H : C) (n₀ : ℤ) :
    (∀ {Y : C}, t.le (-n₀) Y → ∀ f : H ⟶ Y, f = 0) ↔
      PaperLemma35Conclusion t H n₀ := Iff.rfl

set_option linter.style.haveILetI false in
/-- **The aisle identity in the proof of `lem:hom_vanishing` (Lemma 3.5).**
If `t.le 0` is compactly generated by `H`, then
`t.le (-n₀) = Coprod {H⟦n⟧ | n ≥ n₀}`.

This is the paper's equality
`T^{≤-n₀} = T^{≤0}[n₀] = Coprod({H[n] : n ≥ n₀})`.  The first inclusion shifts
`Y ∈ t.le (-n₀)` by `⟦-n₀⟧`, uses compact generation in degree zero, and then
shifts back by `⟦n₀⟧`.  The other inclusion uses `H⟦n⟧ ∈ t.le (-n)` and
monotonicity `-n ≤ -n₀`.  Thus the same sign `+n₀` occurs on both sides. -/
theorem le_neg_eq_coprod_shiftTail (t : TStructure C) (H : C) (n₀ : ℤ)
    (hgen : t.le 0 = Coprod (shiftTail H 0)) :
    t.le (-n₀) = Coprod (shiftTail H n₀) := by
  apply le_antisymm
  · intro Y hY
    have hY₀ : t.le 0 (Y⟦-n₀⟧) := t.le_shift (-n₀) (-n₀) 0 (by omega) Y hY
    have hYcoprod : Coprod (shiftTail H 0) (Y⟦-n₀⟧) := by
      rw [← hgen]
      exact hY₀
    have hshift := map_shift_Coprod (shiftTail H 0) n₀ hYcoprod
    rw [shiftImage_shiftTail] at hshift
    have hshift' : Coprod (shiftTail H n₀) ((Y⟦-n₀⟧)⟦n₀⟧) := by
      simpa only [zero_add] using hshift
    exact (Coprod (shiftTail H n₀)).prop_of_iso (shiftNegShift Y n₀) hshift'
  · letI (J : Type v) : (t.le (-n₀)).IsClosedUnderColimitsOfShape (Discrete J) :=
      TStructure.le_isClosedUnderColimitsOfShape t (-n₀) (Discrete J)
    letI : (t.le (-n₀)).IsTriangulatedClosed₂ :=
      TStructure.le_isTriangulatedClosed₂ t (-n₀)
    apply Coprod.le
    intro X hX
    obtain ⟨n, hn, ⟨e⟩⟩ := hX
    have hH : t.le 0 H := generator_mem_le_zero t H hgen
    have hHshift : t.le (-n) (H⟦n⟧) := t.le_shift 0 n (-n) (by omega) H hH
    exact (t.le (-n₀)).prop_of_iso e.symm
      (t.le_monotone (by omega) _ hHshift)

/-- **Paper `lem:hom_vanishing` (Lemma 3.5), verbatim in library vocabulary.**
Under the identification paper `[n] = ⟦n⟧`, this is also exactly the existing
`lemma_3_5`; no opposite-shift hypothesis is used. -/
theorem lemma_3_5_paper (t : TStructure C) (H : C) [IsCompactAb H] (n₀ : ℤ)
    (hgen : t.le 0 = Coprod (shiftTail H 0))
    (h : PaperLemma35Hypothesis H n₀) {Y : C} (hY : t.le (-n₀) Y) :
    PaperHomZero H Y := by
  apply hom_zero_of_mem_coprod_shiftTail H h
  rw [← le_neg_eq_coprod_shiftTail t H n₀ hgen]
  exact hY

end HomPredicates

namespace SetupMainMinimal

variable {DZ : Type uZ} {D : Type uD} {DU : Type uU}
  [Category.{v} DZ] [Category.{v} D] [Category.{v} DU]
  [Preadditive DZ] [Preadditive D] [Preadditive DU]
  [HasZeroObject DZ] [HasZeroObject D] [HasZeroObject DU]
  [HasShift DZ ℤ] [HasShift D ℤ] [HasShift DU ℤ]
  [∀ (n : ℤ), (shiftFunctor DZ n).Additive]
  [∀ (n : ℤ), (shiftFunctor D n).Additive]
  [∀ (n : ℤ), (shiftFunctor DU n).Additive]
  [Pretriangulated DZ] [Pretriangulated D] [Pretriangulated DU]
  [CategoryTheory.IsTriangulated DZ] [CategoryTheory.IsTriangulated D]
  [CategoryTheory.IsTriangulated DU]

variable (S : SetupMainMinimal DZ D DU)

/-- The right-hand side of the existing `theorem_1_1` is definitionally the
paper's `Hom(G',G'[n]) = 0` for `n ≫ 0`. -/
theorem theorem_1_1_vanishing_iff_paper :
    (∃ N : ℤ, ∀ n : ℤ, N ≤ n → ∀ f : S.G' ⟶ S.G'⟦n⟧, f = 0) ↔
      PaperEventuallyHomZero S.G' S.G' := Iff.rfl

/-- The whole proposition proved by the library's Theorem 1.1 is equivalent
(indeed definitionally equal after unfolding the text-form predicate) to the
paper's statement. -/
theorem theorem_1_1_statement_iff_paper :
    (SatisfiesWA D ↔ ∃ N : ℤ, ∀ n : ℤ, N ≤ n →
        ∀ f : S.G' ⟶ S.G'⟦n⟧, f = 0) ↔
      (SatisfiesWA D ↔ PaperEventuallyHomZero S.G' S.G') := Iff.rfl

variable [HasCoproducts.{v} DZ] [HasCoproducts.{v} D] [HasCoproducts.{v} DU]

/-- **Paper `thm:glueing_weak_approx` (Theorem 1.1), verbatim in the library's
vocabulary.**  The proof is the existing theorem itself: its positive-shift
condition is already the paper's, with `G'`, `N`, and `n` unchanged. -/
theorem theorem_1_1_paper
    (h09SR : ∀ (G : D), IsGenerator G → IsCompactAb G →
      IsClassicalGeneratorOnCompacts G) :
    SatisfiesWA D ↔ PaperEventuallyHomZero S.G' S.G' :=
  S.theorem_1_1 h09SR

end SetupMainMinimal

end RelativeWeakApprox