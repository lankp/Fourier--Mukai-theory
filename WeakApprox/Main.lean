import WeakApprox.TwoStage
import WeakApprox.EventualVanishing

/-!
# Theorem 1.1

  P. Lank, B. Pauwels, *Gluing weak approximability along recollements*.

For a recollement of singly compactly generated triangulated categories with
`D_Z` and `D_U` weakly approximable, `D` is weakly approximable if and only if
`Hom(G', G'⟦n⟧) = 0` for `n ≫ 0`.

## Rendering

`SetupMain` is Setup 4.4 of the paper with the *one* field `G'_eventual`
removed: in the forward direction that vanishing is the conclusion, so it must
not be assumed, while in the reverse direction it is the hypothesis of the
equivalence and is supplied by `SetupMain.toSetup44`.  Everything else in
Setup 4.4 is kept verbatim, including the conclusions of Lemma 4.3(1)--(3) and
the descriptions of the three compactly generated aisles.

Both directions are theorems about Setup 4.4 and need no external input.  The
forward direction uses only `G ∈ D^{≤0}` and `Hom(G, D^{≤-A}) = 0`, which give
`Hom(G, G⟦n⟧) = 0` for `n ≥ A`, and then that `G'` lies in the thick envelope of
`G` because `G'⟦m⟧` is a summand of `G`.  Stacks Tag 09SR (Ravenel--Neeman) is
not used here: it is needed only to derive Setup 4.4 from the paper's own
hypotheses, i.e. in Lemma 4.3.  See `WeakApprox/NineSR.lean` and
`results/WEAK_APPROX.md` for what is and is not formalized of it.

The reverse direction is `WeakApprox/TwoStage.lean`: `Setup44` produces weak
approximation data with the normalized generator `G'⟦m⟧ ⊞ j_!G_U`, the glued
t-structure and the bound `3A`.
-/

@[expose] public section

namespace RelativeWeakApprox

open CategoryTheory CategoryTheory.Limits
open CategoryTheory.Pretriangulated CategoryTheory.Triangulated

universe v uZ uD uU

section SetupDeclaration

variable (DZ : Type uZ) (D : Type uD) (DU : Type uU)
  [Category.{v} DZ] [Category.{v} D] [Category.{v} DU]
  [Preadditive DZ] [Preadditive D] [Preadditive DU]
  [HasZeroObject DZ] [HasZeroObject D] [HasZeroObject DU]
  [HasShift DZ ℤ] [HasShift D ℤ] [HasShift DU ℤ]
  [∀ (n : ℤ), (shiftFunctor DZ n).Additive]
  [∀ (n : ℤ), (shiftFunctor D n).Additive]
  [∀ (n : ℤ), (shiftFunctor DU n).Additive]
  [Pretriangulated DZ] [Pretriangulated D] [Pretriangulated DU]
  [CategoryTheory.IsTriangulated DZ] [CategoryTheory.IsTriangulated D]
  [CategoryTheory.IsTriangulated DU]

structure SetupMain where
  /-- The recollement. -/
  R : Recollement DZ D DU
  /-- The t-structure on `D`. -/
  tD : TStructure D
  /-- The t-structure on `D_Z`. -/
  tZ : TStructure DZ
  /-- The t-structure on `D_U`. -/
  tU : TStructure DU
  /-- Weak approximation data on `D_Z`. -/
  approxZ : WeakApproximationData DZ
  /-- Weak approximation data on `D_U`. -/
  approxU : WeakApproximationData DU
  /-- The chosen compact generator of `D_U`. -/
  GU : DU
  /-- The chosen compact generator of `D`. -/
  G' : D
  /-- `G'` is compact. -/
  G'_compact : IsCompactAb G'
  /-- `G'` generates. -/
  G'_generates : IsGenerator G'
  /-- The normalizing shift. -/
  m : ℤ
  /-- The degree bound for `j^*G'`. -/
  jStar_G'_mem : tU.le m (R.jStar.obj G')
  /-- Existence of the particular binary biproduct used for the normalized
  generator; no global biproduct assumption is made. -/
  [normalized_biproduct : HasBinaryBiproduct (G'⟦m⟧) (R.jShriek.obj GU)]
  /-- The normalized generator is coproduct-compact.  This is a Lemma 4.3(2)
  conclusion taken as setup data. -/
  G_compact : IsCompactAb (G'⟦m⟧ ⊞ R.jShriek.obj GU)
  /-- The normalized generator generates.  This is a Lemma 4.3(2) conclusion
  taken as setup data. -/
  G_generates : IsGenerator (G'⟦m⟧ ⊞ R.jShriek.obj GU)
  /-- The degree-zero aisle on `D` is compactly generated by the normalized
  generator, in the rendering used by Lemma 3.5. -/
  tD_compactlyGenerated :
    tD.le 0 = Coprod (shiftTail (G'⟦m⟧ ⊞ R.jShriek.obj GU) 0)
  /-- The degree-zero aisle on `D_Z` is compactly generated by `i^*G`. -/
  tZ_compactlyGenerated :
    tZ.le 0 = Coprod (shiftTail (R.iStar.obj (G'⟦m⟧ ⊞ R.jShriek.obj GU)) 0)
  /-- The degree-zero aisle on `D_U` is compactly generated by `GU`. -/
  tU_compactlyGenerated : tU.le 0 = Coprod (shiftTail GU 0)
  /-- The degree-zero aisle on `D` is the glued aisle. -/
  tD_glued : tD.le 0 = gluedLe R.iStar R.jStar tZ tU 0
  /-- The weak approximation data on `D_Z` has the displayed t-structure. -/
  approxZ_t : approxZ.t = tZ
  /-- The weak approximation data on `D_U` has the displayed t-structure. -/
  approxU_t : approxU.t = tU
  /-- The generator of the data on `D_Z` is `i^*G`. -/
  approxZ_G : approxZ.G = R.iStar.obj (G'⟦m⟧ ⊞ R.jShriek.obj GU)
  /-- The generator of the data on `D_U` is `GU`. -/
  approxU_G : approxU.G = GU
  /-- The common strictly positive bound. -/
  A : ℤ
  /-- Positivity of the common bound. -/
  A_pos : 0 < A
  /-- The data on `D_Z` uses the common bound. -/
  approxZ_A : approxZ.A = A
  /-- The data on `D_U` uses the common bound. -/
  approxU_A : approxU.A = A
  /-- The remaining Hom-vanishing condition of Setup 4.4. -/
  G_hom_vanishing : ∀ {Y : D}, tD.le (-A) Y →
    ∀ f : (G'⟦m⟧ ⊞ R.jShriek.obj GU) ⟶ Y, f = 0


end SetupDeclaration

namespace SetupMain

variable {DZ : Type uZ} {D : Type uD} {DU : Type uU}
  [Category.{v} DZ] [Category.{v} D] [Category.{v} DU]
  [Preadditive DZ] [Preadditive D] [Preadditive DU]
  [HasZeroObject DZ] [HasZeroObject D] [HasZeroObject DU]
  [HasShift DZ ℤ] [HasShift D ℤ] [HasShift DU ℤ]
  [∀ (n : ℤ), (shiftFunctor DZ n).Additive]
  [∀ (n : ℤ), (shiftFunctor D n).Additive]
  [∀ (n : ℤ), (shiftFunctor DU n).Additive]
  [Pretriangulated DZ] [Pretriangulated D] [Pretriangulated DU]
  [CategoryTheory.IsTriangulated DZ] [CategoryTheory.IsTriangulated D]
  [CategoryTheory.IsTriangulated DU]

/-- The normalized compact generator `G = G'⟦m⟧ ⊞ j_!G_U`. -/
noncomputable def G (S : SetupMain DZ D DU) : D := S.G'⟦S.m⟧ ⊞ S.R.jShriek.obj S.GU

/-- Adjoin the eventual vanishing of `Hom(G', G'⟦n⟧)` to a `SetupMain`, to get
the setup assumed by the reverse direction (`WeakApprox/TwoStage.lean`). -/
def toSetup44 (S : SetupMain DZ D DU)
    (hG' : ∃ N : ℤ, ∀ n : ℤ, N ≤ n → ∀ f : S.G' ⟶ S.G'⟦n⟧, f = 0) :
    Setup44 DZ D DU where
  R := S.R
  tD := S.tD
  tZ := S.tZ
  tU := S.tU
  approxZ := S.approxZ
  approxU := S.approxU
  GU := S.GU
  G' := S.G'
  G'_compact := S.G'_compact
  G'_generates := S.G'_generates
  G'_eventual := hG'
  m := S.m
  jStar_G'_mem := S.jStar_G'_mem
  normalized_biproduct := S.normalized_biproduct
  G_compact := S.G_compact
  G_generates := S.G_generates
  tD_compactlyGenerated := S.tD_compactlyGenerated
  tZ_compactlyGenerated := S.tZ_compactlyGenerated
  tU_compactlyGenerated := S.tU_compactlyGenerated
  tD_glued := S.tD_glued
  approxZ_t := S.approxZ_t
  approxU_t := S.approxU_t
  approxZ_G := S.approxZ_G
  approxU_G := S.approxU_G
  A := S.A
  A_pos := S.A_pos
  approxZ_A := S.approxZ_A
  approxU_A := S.approxU_A
  G_hom_vanishing := S.G_hom_vanishing

/-- The normalized generator lies in its own degree-zero compactly generated
aisle. -/
theorem G_mem_le_zero (S : SetupMain DZ D DU) : S.tD.le 0 S.G := by
  rw [S.tD_compactlyGenerated]
  exact Coprod.of_mem _ ⟨0, le_rfl, ⟨(shiftFunctorZero D ℤ).symm.app S.G⟩⟩

/-- The normalized generator has eventually vanishing positive self-shift Homs.

This uses no weak approximation data on `D`: it is a consequence of the two
Setup 4.4 conditions `G ∈ D^{≤0}` and `Hom(G, D^{≤-A}) = 0`, with cutoff `A`
(a map `G ⟶ G⟦n⟧` lands in `D^{≤-n} ⊆ D^{≤-A}` as soon as `n ≥ A`). -/
theorem eventuallyHomZero_G (S : SetupMain DZ D DU) : EventuallyHomZero S.G S.G := by
  refine ⟨S.A, fun n hn f => S.G_hom_vanishing ?_ f⟩
  apply S.tD.le_monotone (show 0 - n ≤ -S.A by omega)
  exact S.tD.le_shift 0 n (0 - n) (by ring) S.G S.G_mem_le_zero

/-- `G'` lies in the thick envelope of the normalized generator: `G'⟦m⟧` is a
summand of `G = G'⟦m⟧ ⊞ j_!G_U`, and thick envelopes are closed under retracts
and shifts. -/
theorem thick_G' (S : SetupMain DZ D DU) :
    (ObjectProperty.singleton S.G).triangEnvelope S.G' := by
  have hG : (ObjectProperty.singleton S.G).triangEnvelope S.G :=
    ObjectProperty.le_triangEnvelope _ _ ((ObjectProperty.singleton_iff _ _).2 rfl)
  have hmem : (ObjectProperty.singleton S.G).triangEnvelope (S.G'⟦S.m⟧) :=
    ObjectProperty.prop_of_retract _
      ⟨biprod.inl, biprod.fst, biprod.inl_fst⟩ hG
  have hmem' : (ObjectProperty.singleton S.G).triangEnvelope ((S.G'⟦S.m⟧)⟦-S.m⟧) :=
    (ObjectProperty.singleton S.G).triangEnvelope.le_shift (-S.m) _ hmem
  exact ObjectProperty.prop_of_iso _ (shiftShiftNeg S.G' S.m) hmem'

/-- **Theorem 1.1, forward direction.**  Eventual vanishing of the positive
self-shifts of `G'`.

This needs neither `SatisfiesWA D` nor Stacks 09SR: it is a theorem about
Setup 4.4 alone.  `G` has eventual self-vanishing by `eventuallyHomZero_G`, and
`G'` lies in the thick envelope of `G` by `thick_G'`, so the vanishing
transports along the envelope. -/
theorem theorem_1_1_forward (S : SetupMain DZ D DU) :
    ∃ N : ℤ, ∀ n : ℤ, N ≤ n → ∀ f : S.G' ⟶ S.G'⟦n⟧, f = 0 :=
  eventuallyHomZero_of_mem_triangEnvelope S.eventuallyHomZero_G S.thick_G' S.thick_G'

/-- **Theorem 1.1.**  With `D_Z` and `D_U` weakly approximable, `D` is weakly
approximable if and only if `Hom(G', G'⟦n⟧) = 0` for `n ≫ 0`.

Both directions are theorems about Setup 4.4.  The forward direction
(`theorem_1_1_forward`) needs neither weak approximability of `D` nor Stacks
09SR; the reverse direction supplies the vanishing to `Setup44` and applies the
two-stage approximation of `WeakApprox/TwoStage.lean`.  Stacks 09SR enters only
when Setup 4.4 is derived from the paper's own hypotheses, i.e. in Lemma 4.3. -/
theorem theorem_1_1 (S : SetupMain DZ D DU)
    [HasCoproducts.{v} DZ] [HasCoproducts.{v} D] [HasCoproducts.{v} DU] :
    SatisfiesWA D ↔ ∃ N : ℤ, ∀ n : ℤ, N ≤ n → ∀ f : S.G' ⟶ S.G'⟦n⟧, f = 0 :=
  ⟨fun _ => S.theorem_1_1_forward, fun h => satisfiesWA_of_setup (S.toSetup44 h)⟩

end SetupMain

end RelativeWeakApprox

#print axioms RelativeWeakApprox.SetupMain.toSetup44
#print axioms RelativeWeakApprox.SetupMain.eventuallyHomZero_G
#print axioms RelativeWeakApprox.SetupMain.thick_G'
#print axioms RelativeWeakApprox.SetupMain.theorem_1_1_forward
#print axioms RelativeWeakApprox.SetupMain.theorem_1_1
