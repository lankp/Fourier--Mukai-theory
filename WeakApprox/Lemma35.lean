import WeakApprox.HomVanishing
import WeakApprox.Shift
import Mathlib.Tactic

@[expose] public section

/-!
# Lemma 3.5: vanishing of `Hom(H, -)` on a compactly generated aisle

Lemma 3.5 of

  P. Lank, B. Pauwels, *Gluing weak approximability along recollements*: if `H` is
compact and `T^{≤0}` is the aisle compactly generated by `H`, and
`Hom(H, H⟦n⟧) = 0` for `n ≥ n₀`, then `Hom(H, Y) = 0` for every `Y ∈ T^{≤-n₀}`.

The compact generation of the aisle is rendered, as in the paper, by
`t.le 0 = Coprod {H⟦n⟧ | n ≥ 0}` (`shiftTail H 0`).

Found by a member of the Ultramath run `smwun9hk2` (direction D4).
-/

namespace RelativeWeakApprox

open CategoryTheory CategoryTheory.Limits
open CategoryTheory.Pretriangulated CategoryTheory.Triangulated

universe v u

variable {C : Type u} [Category.{v} C] [HasZeroObject C] [HasShift C ℤ]
  [Preadditive C] [∀ (n : ℤ), (shiftFunctor C n).Additive] [Pretriangulated C]

/-- The strictly full class of objects isomorphic to `H⟦n⟧` for some `n ≥ n₀`.
This is the generating class occurring in the compactly generated aisle in
Lemma 3.5. -/
def shiftTail (H : C) (n₀ : ℤ) : ObjectProperty C := fun X =>
  ∃ n : ℤ, n₀ ≤ n ∧ Nonempty (X ≅ H⟦n⟧)

/-- Shifting the generating class `H[n]`, `n ≥ n₀`, by `s` adds `s` to the
cutoff. -/
lemma shiftImage_shiftTail (H : C) (n₀ s : ℤ) :
    shiftImage (shiftTail H n₀) s = shiftTail H (n₀ + s) := by
  ext X
  constructor
  · rintro ⟨Y, ⟨n, hn, ⟨eY⟩⟩, ⟨eX⟩⟩
    refine ⟨n + s, by omega, ⟨?_⟩⟩
    exact eX.trans (((shiftFunctor C s).mapIso eY).trans
      ((shiftFunctorAdd' C n s (n + s) rfl).symm.app H))
  · rintro ⟨n, hn, ⟨eX⟩⟩
    refine ⟨H⟦n - s⟧, ⟨n - s, by omega, ⟨Iso.refl _⟩⟩, ⟨?_⟩⟩
    exact eX.trans ((shiftFunctorAdd' C (n - s) s n (by omega)).app H)

/-- Covariant Hom-vanishing passes to the coproduct/extension closure of a tail
of shifts of a compact object. This is the closure step in Lemma 3.5. -/
theorem hom_zero_of_mem_coprod_shiftTail (H : C) [IsCoproductCompact H] {n₀ : ℤ}
    (h : ∀ n : ℤ, n₀ ≤ n → ∀ f : H ⟶ H⟦n⟧, f = 0)
    {Y : C} (hY : Coprod (shiftTail H n₀) Y) : ∀ f : H ⟶ Y, f = 0 := by
  have hle : Coprod (shiftTail H n₀) ≤ homZeroRight H := by
    apply Coprod.le
    intro X hX
    obtain ⟨n, hn, ⟨e⟩⟩ := hX
    intro f
    rw [← cancel_mono e.hom, zero_comp]
    exact h n hn (f ≫ e.hom)
  exact hle Y hY

/-- **Lemma 3.5.** Let `H` be coproduct-compact and let the aisle `t.le 0` be
compactly generated by `H`. If `Hom(H, H⟦n⟧) = 0` for all `n ≥ n₀`, then
`Hom(H, Y) = 0` for every `Y ∈ t.le (-n₀)`.

Rendering of compact generation: the hypothesis `hgen` is literally
`t.le 0 = Coprod {H⟦n⟧ | n ≥ 0}`, using the project's inductive `Coprod` and
`shiftTail`. Compactness is the project's `IsCoproductCompact`. No additional
coproduct-existence or retract-closure hypothesis is imposed. -/
theorem lemma_3_5 (t : TStructure C) (H : C) [IsCoproductCompact H] (n₀ : ℤ)
    (hgen : t.le 0 = Coprod (shiftTail H 0))
    (h : ∀ n : ℤ, n₀ ≤ n → ∀ f : H ⟶ H⟦n⟧, f = 0)
    {Y : C} (hY : t.le (-n₀) Y) : ∀ f : H ⟶ Y, f = 0 := by
  have hY₀ : t.le 0 (Y⟦-n₀⟧) := t.le_shift (-n₀) (-n₀) 0 (by omega) Y hY
  have hYcoprod : Coprod (shiftTail H 0) (Y⟦-n₀⟧) := by
    rw [← hgen]
    exact hY₀
  have hshift := map_shift_Coprod (shiftTail H 0) n₀ hYcoprod
  rw [shiftImage_shiftTail] at hshift
  have hshift' : Coprod (shiftTail H n₀) ((Y⟦-n₀⟧)⟦n₀⟧) := by
    simpa only [zero_add] using hshift
  have hYcoprod' : Coprod (shiftTail H n₀) Y :=
    (Coprod (shiftTail H n₀)).prop_of_iso (shiftNegShift Y n₀) hshift'
  exact hom_zero_of_mem_coprod_shiftTail H h hYcoprod'
