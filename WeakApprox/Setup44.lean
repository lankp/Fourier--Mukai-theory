import WeakApprox.Recollement
import WeakApprox.Closure
import WeakApprox.Lemma35
import WeakApprox.Lemma42
import Mathlib.CategoryTheory.Limits.Shapes.BinaryBiproducts
import Mathlib.CategoryTheory.ObjectProperty.CompleteLattice
import Mathlib.Tactic

/-!
# Setup 4.4 for lifts to aisles

This file packages Setup 4.4 of P. Lank and B. Pauwels, *Gluing weak
approximability along recollements*, using the project's existing recollement,
weak-approximation, envelope, and compactly-generated-aisle definitions.

Found by a member of the Ultramath run `smwunmkmj` (direction D1).

The two compact-generation assertions and the gluing assertion for the normalized
generator are fields, rather than reproofs of Lemma 4.3(2)--(3).  The two weak
approximation data are required to have the displayed t-structures, generators,
and common bound `A`; these compatibility conditions are equalities.  The bound
`Hom(G, D^{≤ -A}) = 0` from Setup 4.4 is also a field.  A binary biproduct of the
two summands of `G` is assumed to exist (rather than assuming all binary
biproducts in `D`).  The integer `m` is not required to be nonnegative, exactly
as in the task statement.
-/

@[expose] public section

namespace RelativeWeakApprox

open CategoryTheory CategoryTheory.Limits
open CategoryTheory.Pretriangulated CategoryTheory.Triangulated

universe vZ uZ vD uD vU uU

section SetupDeclaration

variable (DZ : Type uZ) (D : Type uD) (DU : Type uU)
  [Category.{vZ} DZ] [Category.{vD} D] [Category.{vU} DU]
  [Preadditive DZ] [Preadditive D] [Preadditive DU]
  [HasZeroObject DZ] [HasZeroObject D] [HasZeroObject DU]
  [HasShift DZ ℤ] [HasShift D ℤ] [HasShift DU ℤ]
  [∀ (n : ℤ), (shiftFunctor DZ n).Additive]
  [∀ (n : ℤ), (shiftFunctor D n).Additive]
  [∀ (n : ℤ), (shiftFunctor DU n).Additive]
  [Pretriangulated DZ] [Pretriangulated D] [Pretriangulated DU]
  [CategoryTheory.IsTriangulated DZ] [CategoryTheory.IsTriangulated D]
  [CategoryTheory.IsTriangulated DU]

/-- **Setup 4.4.**  The normalized generator is definitionally
`G'⟦m⟧ ⊞ j_!GU`; see `Setup44.G`.

The fields `G_compact`, `G_generates`, `tD_compactlyGenerated`,
`tZ_compactlyGenerated`, and `tD_glued` explicitly assume the conclusions of
Lemma 4.3(2)--(3) and the descriptions of the three compactly generated aisles.
The fields `approxZ_t`, `approxU_t`, `approxZ_G`, `approxU_G`, `approxZ_A`, and
`approxU_A` identify the supplied weak approximation data with the displayed
objects and the common bound.  `G_hom_vanishing` is the third condition in the
paper's Setup 4.4, before the common bound is chosen. -/
structure Setup44 where
  /-- The recollement. -/
  R : Recollement DZ D DU
  /-- The t-structure on `D`. -/
  tD : TStructure D
  /-- The t-structure on `D_Z`. -/
  tZ : TStructure DZ
  /-- The t-structure on `D_U`. -/
  tU : TStructure DU
  /-- Weak approximation data on `D_Z`. -/
  approxZ : WeakApproximationData DZ
  /-- Weak approximation data on `D_U`. -/
  approxU : WeakApproximationData DU
  /-- The chosen compact generator of `D_U`. -/
  GU : DU
  /-- The chosen compact generator of `D`. -/
  G' : D
  /-- `G'` is coproduct-compact. -/
  G'_compact : IsCompactAb G'
  /-- `G'` generates. -/
  G'_generates : IsGenerator G'
  /-- Eventual positive-degree self-Hom vanishing for `G'`. -/
  G'_eventual : ∃ N : ℤ, ∀ n : ℤ, N ≤ n → ∀ f : G' ⟶ G'⟦n⟧, f = 0
  /-- The normalizing shift. -/
  m : ℤ
  /-- The degree bound for `j^*G'`. -/
  jStar_G'_mem : tU.le m (R.jStar.obj G')
  /-- Existence of the particular binary biproduct used for the normalized
  generator; no global biproduct assumption is made. -/
  [normalized_biproduct : HasBinaryBiproduct (G'⟦m⟧) (R.jShriek.obj GU)]
  /-- The normalized generator is coproduct-compact.  This is a Lemma 4.3(2)
  conclusion taken as setup data. -/
  G_compact : IsCompactAb (G'⟦m⟧ ⊞ R.jShriek.obj GU)
  /-- The normalized generator generates.  This is a Lemma 4.3(2) conclusion
  taken as setup data. -/
  G_generates : IsGenerator (G'⟦m⟧ ⊞ R.jShriek.obj GU)
  /-- The degree-zero aisle on `D` is compactly generated by the normalized
  generator, in the rendering used by Lemma 3.5. -/
  tD_compactlyGenerated :
    tD.le 0 = Coprod (shiftTail (G'⟦m⟧ ⊞ R.jShriek.obj GU) 0)
  /-- The degree-zero aisle on `D_Z` is compactly generated by `i^*G`. -/
  tZ_compactlyGenerated :
    tZ.le 0 = Coprod (shiftTail (R.iStar.obj (G'⟦m⟧ ⊞ R.jShriek.obj GU)) 0)
  /-- The degree-zero aisle on `D_U` is compactly generated by `GU`. -/
  tU_compactlyGenerated : tU.le 0 = Coprod (shiftTail GU 0)
  /-- The degree-zero aisle on `D` is the glued aisle. -/
  tD_glued : tD.le 0 = gluedLe R.iStar R.jStar tZ tU 0
  /-- The weak approximation data on `D_Z` has the displayed t-structure. -/
  approxZ_t : approxZ.t = tZ
  /-- The weak approximation data on `D_U` has the displayed t-structure. -/
  approxU_t : approxU.t = tU
  /-- The generator of the data on `D_Z` is `i^*G`. -/
  approxZ_G : approxZ.G = R.iStar.obj (G'⟦m⟧ ⊞ R.jShriek.obj GU)
  /-- The generator of the data on `D_U` is `GU`. -/
  approxU_G : approxU.G = GU
  /-- The common strictly positive bound. -/
  A : ℤ
  /-- Positivity of the common bound. -/
  A_pos : 0 < A
  /-- The data on `D_Z` uses the common bound. -/
  approxZ_A : approxZ.A = A
  /-- The data on `D_U` uses the common bound. -/
  approxU_A : approxU.A = A
  /-- The remaining Hom-vanishing condition of Setup 4.4. -/
  G_hom_vanishing : ∀ {Y : D}, tD.le (-A) Y →
    ∀ f : (G'⟦m⟧ ⊞ R.jShriek.obj GU) ⟶ Y, f = 0

end SetupDeclaration

namespace Setup44

variable {DZ D DU}
  [Category.{vZ} DZ] [Category.{vD} D] [Category.{vU} DU]
  [Preadditive DZ] [Preadditive D] [Preadditive DU]
  [HasZeroObject DZ] [HasZeroObject D] [HasZeroObject DU]
  [HasShift DZ ℤ] [HasShift D ℤ] [HasShift DU ℤ]
  [∀ (n : ℤ), (shiftFunctor DZ n).Additive]
  [∀ (n : ℤ), (shiftFunctor D n).Additive]
  [∀ (n : ℤ), (shiftFunctor DU n).Additive]
  [Pretriangulated DZ] [Pretriangulated D] [Pretriangulated DU]
  [CategoryTheory.IsTriangulated DZ] [CategoryTheory.IsTriangulated D]
  [CategoryTheory.IsTriangulated DU]

variable (S : Setup44 DZ D DU)

/-- The normalized compact generator `G = G'⟦m⟧ ⊞ j_!GU`. -/
noncomputable def G : D := S.G'⟦S.m⟧ ⊞ S.R.jShriek.obj S.GU

/-- The cutoff `K = A + 1`. -/
def K : ℤ := S.A + 1

/-- The envelope bound `B = 3A`. -/
def B : ℤ := 3 * S.A

/-- The class `P = ⟨G⟩^[-B,B] ∩ D^{≤K}`. -/
def P : ObjectProperty D := envelope S.G (-S.B) S.B ⊓ S.tD.le S.K

/-- `GU` is coproduct-compact, transported from the supplied data on `D_U`. -/
theorem GU_compact : IsCompactAb S.GU := by
  rw [← S.approxU_G]
  exact S.approxU.G_compact

/-- `GU` generates, transported from the supplied data on `D_U`. -/
theorem GU_generates : IsGenerator S.GU := by
  rw [← S.approxU_G]
  exact S.approxU.G_generates

/-- `i^*G` is coproduct-compact, transported from the supplied data on `D_Z`. -/
theorem iStar_G_compact : IsCompactAb (S.R.iStar.obj S.G) := by
  dsimp only [G]
  rw [← S.approxZ_G]
  exact S.approxZ.G_compact

/-- `i^*G` generates, transported from the supplied data on `D_Z`. -/
theorem iStar_G_generates : IsGenerator (S.R.iStar.obj S.G) := by
  dsimp only [G]
  rw [← S.approxZ_G]
  exact S.approxZ.G_generates

/-- Compact generation of the degree-zero aisle on `D`, with `G` unfolded only
up to its definition. -/
theorem tD_le_zero_eq_coprod : S.tD.le 0 = Coprod (shiftTail S.G 0) :=
  S.tD_compactlyGenerated

/-- Compact generation of the degree-zero aisle on `D_Z`. -/
theorem tZ_le_zero_eq_coprod :
    S.tZ.le 0 = Coprod (shiftTail (S.R.iStar.obj S.G) 0) :=
  S.tZ_compactlyGenerated

/-- The normalized generator lies in its own degree-zero compactly generated
aisle. -/
theorem G_mem_le_zero : S.tD.le 0 S.G := by
  rw [S.tD_le_zero_eq_coprod]
  apply Coprod.of_mem
  exact ⟨0, le_rfl, ⟨(shiftFunctorZero D ℤ).symm.app S.G⟩⟩

/-- The normalized generator belongs to `⟨G⟩^[0,0]`. -/
theorem G_mem_envelope_zero : envelope S.G 0 0 S.G :=
  lemma_3_1_1_contains S.G 0 0 S.G (shiftInterval_self S.G le_rfl le_rfl)

/-- The summand `j_!GU` belongs to `⟨G⟩^[0,0]`, as asserted at the end of
Setup 4.4. -/
theorem jShriek_GU_mem_envelope_zero : envelope S.G 0 0 (S.R.jShriek.obj S.GU) := by
  letI : (envelope S.G 0 0).IsStableUnderRetracts :=
    lemma_3_1_1_summands S.G 0 0
  exact ObjectProperty.IsStableUnderRetracts.of_biprod_right
    (envelope S.G 0 0) S.G_mem_envelope_zero

/-- Membership in `P` has the two expected components. -/
theorem mem_P_iff {X : D} : S.P X ↔ envelope S.G (-S.B) S.B X ∧ S.tD.le S.K X :=
  Iff.rfl

end Setup44

section AisleClosure

variable {C : Type uD} [Category.{vD} C] [Preadditive C] [HasZeroObject C]
  [HasShift C ℤ] [∀ (n : ℤ), (shiftFunctor C n).Additive] [Pretriangulated C]

/-- Every existent colimit of objects in an aisle again lies in that aisle.
This is the orthogonality argument behind coproduct closure of aisles. -/
theorem TStructure.le_isClosedUnderColimitsOfShape (t : TStructure C) (n : ℤ)
    (J : Type uU) [Category.{vU} J] : (t.le n).IsClosedUnderColimitsOfShape J where
  colimitsOfShape_le := by
    rintro X ⟨p⟩
    apply (t.le_iff_isLE X n).2
    rw [t.isLE_iff_orthogonal n (n + 1) rfl]
    intro Y f hY
    apply p.isColimit.hom_ext
    intro j
    simpa using (t.isLE_iff_orthogonal n (n + 1) rfl _).1
      ⟨p.prop_diag_obj j⟩ Y (p.ι.app j ≫ f) hY

/-- A fixed degree of a t-structure is closed under extensions. -/
theorem TStructure.le_isTriangulatedClosed₂ (t : TStructure C) (n : ℤ) :
    (t.le n).IsTriangulatedClosed₂ :=
  .mk' fun T hT h₁ h₃ => (t.isLE₂ T hT n ⟨h₁⟩ ⟨h₃⟩).le

end AisleClosure

namespace Setup44

variable {DZ D DU}
  [Category.{vZ} DZ] [Category.{vD} D] [Category.{vU} DU]
  [Preadditive DZ] [Preadditive D] [Preadditive DU]
  [HasZeroObject DZ] [HasZeroObject D] [HasZeroObject DU]
  [HasShift DZ ℤ] [HasShift D ℤ] [HasShift DU ℤ]
  [∀ (n : ℤ), (shiftFunctor DZ n).Additive]
  [∀ (n : ℤ), (shiftFunctor D n).Additive]
  [∀ (n : ℤ), (shiftFunctor DU n).Additive]
  [Pretriangulated DZ] [Pretriangulated D] [Pretriangulated DU]
  [CategoryTheory.IsTriangulated DZ] [CategoryTheory.IsTriangulated D]
  [CategoryTheory.IsTriangulated DU]

variable (S : Setup44 DZ D DU)

/-- `P` is strictly full. -/
theorem P_isClosedUnderIsomorphisms : S.P.IsClosedUnderIsomorphisms := by
  letI : (envelope S.G (-S.B) S.B).IsClosedUnderIsomorphisms :=
    lemma_3_1_1_strictlyFull S.G (-S.B) S.B
  dsimp only [P]
  infer_instance

/-- `P` is closed under `Type vD`-small coproducts.  As in Lemma 3.1(1), the
proof of closure for the retract-closed envelope assumes that these coproducts
exist in `D`. -/
theorem P_coproducts [HasCoproducts.{vD} D] (J : Type vD) :
    S.P.IsClosedUnderColimitsOfShape (Discrete J) := by
  letI : (envelope S.G (-S.B) S.B).IsClosedUnderColimitsOfShape (Discrete J) :=
    lemma_3_1_1_coproducts S.G (-S.B) S.B J
  letI : (S.tD.le S.K).IsClosedUnderColimitsOfShape (Discrete J) :=
    TStructure.le_isClosedUnderColimitsOfShape S.tD S.K (Discrete J)
  refine ⟨?_⟩
  rintro X ⟨p⟩
  exact ⟨(envelope S.G (-S.B) S.B).prop_of_isColimit p.isColimit
      (fun j => (p.prop_diag_obj j).1),
    (S.tD.le S.K).prop_of_isColimit p.isColimit
      (fun j => (p.prop_diag_obj j).2)⟩

/-- `P` is closed under extensions along distinguished triangles. -/
theorem P_extensions : S.P.IsTriangulatedClosed₂ := by
  letI : S.P.IsClosedUnderIsomorphisms := S.P_isClosedUnderIsomorphisms
  letI : (envelope S.G (-S.B) S.B).IsTriangulatedClosed₂ :=
    lemma_3_1_1_extensions S.G (-S.B) S.B
  apply ObjectProperty.IsTriangulatedClosed₂.mk'
  intro T hT h₁ h₃
  exact ⟨(envelope S.G (-S.B) S.B).ext_of_isTriangulatedClosed₂ T hT h₁.1 h₃.1,
    (S.tD.isLE₂ T hT S.K ⟨h₁.2⟩ ⟨h₃.2⟩).le⟩

end Setup44
end RelativeWeakApprox
