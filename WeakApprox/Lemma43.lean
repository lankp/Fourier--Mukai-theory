/-!
# Lemma 4.3(1) and (4): normalization and eventual Hom-vanishing

Found by a member of the Ultramath run `smwunmkmj` (direction D5).

The eventual Hom-vanishing observation is proved on the whole finite thick
(triangulated) envelope of the generator. `IsGenerator` in `WeakApprox/Basic`
is only a separation condition, so the standard theorem that the compact objects
are classically generated by a compact generator is supplied explicitly as
`IsClassicalGeneratorOnCompacts`; no separation-to-classical-generation theorem
is asserted here.

For part (1), boundedness above is detected directly using separation and the
orthogonality of a `t`-structure. Consequently no preferred-equivalence-class
hypothesis is needed. Compactness of `j_!GU` uses Neeman's adjoint argument and
the second adjunction `j^* ⊣ j_*`. The recollement applications use one common
hom universe for the three categories; this is required by the coproduct-based
definition of compactness, not an additional categorical hypothesis.
-/

@[expose] public section

namespace RelativeWeakApprox

open CategoryTheory CategoryTheory.Limits
open CategoryTheory.Pretriangulated CategoryTheory.Triangulated
open ZeroObject

universe v u

variable {C : Type u} [Category.{v} C] [HasZeroObject C] [HasShift C ℤ]
  [Preadditive C] [∀ (n : ℤ), (shiftFunctor C n).Additive] [Pretriangulated C]

/-- `Hom(X,Y[n])` vanishes for all sufficiently large `n`, formulated
morphismwise. -/
def EventuallyHomZero (X Y : C) : Prop :=
  ∃ N : ℤ, ∀ n : ℤ, N ≤ n → ∀ f : X ⟶ Y⟦n⟧, f = 0

/-- Sources whose positive-shift Homs into `Y` eventually vanish. -/
def eventuallyHomZeroSource (Y : C) : ObjectProperty C :=
  fun X => EventuallyHomZero X Y

/-- Targets whose positive-shift Homs from `X` eventually vanish. -/
def eventuallyHomZeroTarget (X : C) : ObjectProperty C :=
  fun Y => EventuallyHomZero X Y

lemma eventuallyHomZero_zero_source (Y : C) : EventuallyHomZero (0 : C) Y :=
  ⟨0, fun _ _ f => (isZero_zero C).eq_of_src f 0⟩

lemma eventuallyHomZero_zero_target (X : C) : EventuallyHomZero X (0 : C) :=
  ⟨0, fun n _ f => ((shiftFunctor C n).map_isZero (isZero_zero C)).eq_of_tgt f 0⟩

instance (Y : C) : (eventuallyHomZeroSource Y).IsClosedUnderIsomorphisms where
  of_iso {X Z} e := by
    rintro ⟨N, hN⟩
    refine ⟨N, fun n hn f => ?_⟩
    rw [← cancel_epi e.hom, comp_zero]
    exact hN n hn (e.hom ≫ f)

instance (X : C) : (eventuallyHomZeroTarget X).IsClosedUnderIsomorphisms where
  of_iso {Y Z} e := by
    rintro ⟨N, hN⟩
    refine ⟨N, fun n hn f => ?_⟩
    rw [← cancel_mono ((shiftFunctor C n).mapIso e).inv, zero_comp]
    exact hN n hn (f ≫ ((shiftFunctor C n).mapIso e).inv)

lemma eventuallyHomZero_source_shift {X Y : C} (s : ℤ)
    (h : EventuallyHomZero X Y) : EventuallyHomZero (X⟦s⟧) Y := by
  obtain ⟨N, hN⟩ := h
  refine ⟨N + s, fun n hn f => ?_⟩
  let e := (shiftFunctorAdd' C n (-s) (n - s) (by omega)).app Y
  have hg : ((shiftShiftNeg X s).inv ≫ f⟦-s⟧') ≫ e.inv = 0 :=
    hN (n - s) (by omega) _
  have hg₀ : (shiftShiftNeg X s).inv ≫ f⟦-s⟧' = 0 := by
    rw [← cancel_mono e.inv, zero_comp]
    exact hg
  have hf : f⟦-s⟧' = 0 := by
    rw [← cancel_epi (shiftShiftNeg X s).inv, comp_zero]
    exact hg₀
  apply (shiftFunctor C (-s)).map_injective
  simpa using hf

lemma eventuallyHomZero_target_shift {X Y : C} (s : ℤ)
    (h : EventuallyHomZero X Y) : EventuallyHomZero X (Y⟦s⟧) := by
  obtain ⟨N, hN⟩ := h
  refine ⟨N - s, fun n hn f => ?_⟩
  let e := (shiftFunctorAdd' C s n (s + n) rfl).app Y
  rw [← cancel_mono e.inv, zero_comp]
  exact hN (s + n) (by omega) (f ≫ e.inv)

instance (Y : C) : (eventuallyHomZeroSource Y).IsStableUnderShift ℤ where
  isStableUnderShiftBy s := ⟨fun _ => eventuallyHomZero_source_shift s⟩

instance (X : C) : (eventuallyHomZeroTarget X).IsStableUnderShift ℤ where
  isStableUnderShiftBy s := ⟨fun _ => eventuallyHomZero_target_shift s⟩

instance (Y : C) : (eventuallyHomZeroSource Y).IsStableUnderRetracts where
  of_retract {X Z} r := by
    rintro ⟨N, hN⟩
    refine ⟨N, fun n hn f => ?_⟩
    rw [← cancel_epi r.r, comp_zero]
    exact hN n hn (r.r ≫ f)

instance (X : C) : (eventuallyHomZeroTarget X).IsStableUnderRetracts where
  of_retract {Y Z} r := by
    rintro ⟨N, hN⟩
    refine ⟨N, fun n hn f => ?_⟩
    have hf : f ≫ (r.i⟦n⟧') = 0 := hN n hn _
    rw [← cancel_mono (r.i⟦n⟧'), zero_comp]
    exact hf

instance (Y : C) : (eventuallyHomZeroSource Y).IsTriangulatedClosed₂ :=
  ObjectProperty.IsTriangulatedClosed₂.mk' (fun T hT h₁ h₃ => by
    obtain ⟨N₁, hN₁⟩ := h₁
    obtain ⟨N₃, hN₃⟩ := h₃
    refine ⟨max N₁ N₃, fun n hn f => ?_⟩
    obtain ⟨g, rfl⟩ := Triangle.yoneda_exact₂ T hT f
      (hN₁ n (le_trans (le_max_left _ _) hn) _)
    rw [hN₃ n (le_trans (le_max_right _ _) hn) g, comp_zero])

instance (X : C) : (eventuallyHomZeroTarget X).IsTriangulatedClosed₂ :=
  ObjectProperty.IsTriangulatedClosed₂.mk' (fun T hT h₁ h₃ => by
    obtain ⟨N₁, hN₁⟩ := h₁
    obtain ⟨N₃, hN₃⟩ := h₃
    refine ⟨max N₁ N₃, fun n hn f => ?_⟩
    obtain ⟨g, rfl⟩ := Triangle.coyoneda_exact₂
      ((CategoryTheory.shiftFunctor (Triangle C) n).obj T)
      (T.shift_distinguished hT n) f (hN₃ n (le_trans (le_max_right _ _) hn) _)
    have hg : g = (0 : X ⟶ ((CategoryTheory.shiftFunctor (Triangle C) n).obj T).obj₁) :=
      hN₁ n (le_trans (le_max_left _ _) hn) g
    rw [hg]
    exact zero_comp)

/-- Eventual vanishing in all sources of the finite thick envelope, with the
generator itself as target. -/
theorem eventuallyHomZero_source_of_mem_triangEnvelope {G X : C}
    (hG : EventuallyHomZero G G)
    (hX : (ObjectProperty.singleton G).triangEnvelope X) :
    EventuallyHomZero X G := by
  letI : (eventuallyHomZeroSource G).ContainsZero :=
    ⟨⟨0, isZero_zero C, eventuallyHomZero_zero_source G⟩⟩
  letI : (eventuallyHomZeroSource G).IsTriangulated := {}
  have hle : (ObjectProperty.singleton G).triangEnvelope ≤ eventuallyHomZeroSource G :=
    (ObjectProperty.triangEnvelope_le_iff (ObjectProperty.singleton G)).2 (by
      intro Z hZ
      obtain rfl : G = Z := (ObjectProperty.singleton_iff _ _).1 hZ
      exact hG)
  exact hle X hX

/-- Eventual vanishing for every pair of objects in the finite thick envelope
of `G`. This is the thick-subcategory argument in Lemma 4.3. -/
theorem eventuallyHomZero_of_mem_triangEnvelope {G X Y : C}
    (hG : EventuallyHomZero G G)
    (hX : (ObjectProperty.singleton G).triangEnvelope X)
    (hY : (ObjectProperty.singleton G).triangEnvelope Y) :
    EventuallyHomZero X Y := by
  have hXG : EventuallyHomZero X G :=
    eventuallyHomZero_source_of_mem_triangEnvelope hG hX
  letI : (eventuallyHomZeroTarget X).ContainsZero :=
    ⟨⟨0, isZero_zero C, eventuallyHomZero_zero_target X⟩⟩
  letI : (eventuallyHomZeroTarget X).IsTriangulated := {}
  have hle : (ObjectProperty.singleton G).triangEnvelope ≤ eventuallyHomZeroTarget X :=
    (ObjectProperty.triangEnvelope_le_iff (ObjectProperty.singleton G)).2 (by
      intro Z hZ
      obtain rfl : G = Z := (ObjectProperty.singleton_iff _ _).1 hZ
      exact hXG)
  exact hle Y hY

/-- The relative form of classical generation needed in Lemma 4.3: every
coproduct-compact object belongs to the finite thick envelope of `G`.

This is stronger than the project's `IsGenerator G` separation predicate, and is
therefore kept as an explicit hypothesis in the two applications below. -/
def IsClassicalGeneratorOnCompacts (G : C) : Prop :=
  ∀ X : C, IsCompactAb X → (ObjectProperty.singleton G).triangEnvelope X

theorem eventuallyHomZero_of_compact {G X Y : C} (hG : EventuallyHomZero G G)
    (hgen : IsClassicalGeneratorOnCompacts G)
    (hX : IsCompactAb X) (hY : IsCompactAb Y) :
    EventuallyHomZero X Y :=
  eventuallyHomZero_of_mem_triangEnvelope hG (hgen X hX) (hgen Y hY)

/-- A compact generator detects boundedness above: if maps from sufficiently
large negative shifts of `G` to `Y` vanish, then `Y` is bounded above by the
same cutoff. The proof separates a general map `Y ⟶ Z` using `IsGenerator`.
For a shifted generator `G[k]`, the case `-N ≤ k` uses orthogonality and the
other case uses the hypothesis. -/
theorem le_of_hom_zero_neg_shifts (t : TStructure C) (G : C)
    (hG : IsGenerator G) (hG0 : t.le 0 G) {Y : C} (N : ℤ)
    (h : ∀ n : ℤ, N ≤ n → ∀ f : G⟦-n⟧ ⟶ Y, f = 0) : t.le N Y := by
  letI : t.IsLE G 0 := ⟨hG0⟩
  apply (t.le_iff_isLE Y N).2
  apply (t.isLE_iff_orthogonal N (N + 1) rfl Y).2
  intro Z f hZ
  apply hG f 0
  intro A hA a
  obtain ⟨B, k, e, hB⟩ := hA
  obtain rfl : G = B := (ObjectProperty.singleton_iff _ _).1 hB
  rw [comp_zero]
  have hb : (e.inv ≫ a) ≫ f = 0 := by
    by_cases hk : -N ≤ k
    · exact t.zero_of_isLE_of_isGE ((e.inv ≫ a) ≫ f) (-k) (N + 1) (by omega)
        (t.isLE_shift G 0 k (-k) (by omega)) hZ
    · have hkvan := h (-k) (by omega)
      rw [neg_neg k] at hkvan
      rw [hkvan (e.inv ≫ a), zero_comp]
  rw [← cancel_epi e.inv, comp_zero]
  simpa only [Category.assoc, Iso.inv_hom_id_assoc] using hb

/-- Existence of a nonnegative bound from eventual vanishing of maps from
negative shifts. -/
theorem exists_nonneg_le_of_hom_zero_neg_shifts (t : TStructure C) (G : C)
    (hG : IsGenerator G) (hG0 : t.le 0 G) {Y : C}
    (h : ∃ N : ℤ, ∀ n : ℤ, N ≤ n → ∀ f : G⟦-n⟧ ⟶ Y, f = 0) :
    ∃ m : ℤ, 0 ≤ m ∧ t.le m Y := by
  obtain ⟨N, hN⟩ := h
  exact ⟨max N 0, le_max_right _ _, t.le_monotone (le_max_left _ _) Y
    (le_of_hom_zero_neg_shifts t G hG hG0 N hN)⟩

universe uD

variable {D : Type uD} [Category.{v} D] [HasZeroObject D] [HasShift D ℤ]
  [Preadditive D] [∀ (n : ℤ), (shiftFunctor D n).Additive] [Pretriangulated D]

/-- A left adjoint transports the positive-shift vanishing bound to maps from
negative shifts through its right adjoint. Only the left adjoint's `CommShift`
structure is used; no shift-compatibility of the adjunction is assumed. -/
lemma hom_zero_of_adjunction_of_eventuallyHomZero
    (F : C ⥤ D) (H : D ⥤ C) [F.CommShift ℤ] [F.Additive] (adj : F ⊣ H) {X : C} {Y : D}
    {N n : ℤ} (h : ∀ k : ℤ, N ≤ k → ∀ f : F.obj X ⟶ Y⟦k⟧, f = 0) (hn : N ≤ n)
    (g : X⟦-n⟧ ⟶ H.obj Y) : g = 0 := by
  let g' : F.obj (X⟦-n⟧) ⟶ Y := (adj.homEquiv _ _).symm g
  let e := (F.commShiftIso (-n)).app X
  have ha : (shiftNegShift (F.obj X) n).inv ≫ ((e.inv ≫ g')⟦n⟧') = 0 := h n hn _
  have hs : (e.inv ≫ g')⟦n⟧' = 0 := by
    rw [← cancel_epi (shiftNegShift (F.obj X) n).inv, comp_zero]
    exact ha
  have he : e.inv ≫ g' = 0 := by
    apply (shiftFunctor D n).map_injective
    simpa using hs
  have hg' : g' = 0 := by
    rw [← cancel_epi e.inv, comp_zero]
    exact he
  exact (adj.homEquiv _ _).symm.injective (by
    simpa only [g', Adjunction.homEquiv_counit, F.map_zero, zero_comp] using hg')

/-- The project's `IsCoproductCompact` is the `PreservesColimit` packaging of
`RelativeFM.IsCompact` at the common hom universe. -/
lemma isCoproductCompact_iff_relativeFM (X : C) :
    IsCoproductCompact X ↔ RelativeFM.IsCompact.{v} X := by
  constructor
  · intro h J K
    letI : IsCoproductCompact X := h
    infer_instance
  · intro h
    exact ⟨fun J => ⟨fun {_} => h J _⟩⟩

/-- Exact statement of compactness transport used for `j_!`: a left adjoint
whose right adjoint preserves small coproducts preserves compact objects. -/
lemma isCoproductCompact_leftAdjoint_obj {F : C ⥤ D} {H : D ⥤ C} (adj : F ⊣ H)
    {X : C} (hX : IsCoproductCompact X)
    [∀ (J : Type v) (K : Discrete J ⥤ D), PreservesColimit K H] :
    IsCoproductCompact (F.obj X) := by
  letI : IsCoproductCompact X := hX
  refine ⟨fun J => ⟨fun {K} => ?_⟩⟩
  letI : PreservesColimit (K ⋙ H) (coyoneda.obj (.op X)) := inferInstance
  letI : PreservesColimit K (H ⋙ coyoneda.obj (.op X)) := inferInstance
  let e : coyoneda.obj (.op (F.obj X)) ≅ H ⋙ coyoneda.obj (.op X) :=
    (CategoryTheory.Adjunction.compCoyonedaIso adj).app (.op X)
  exact preservesColimit_of_natIso K e.symm

/-- Membership of a binary biproduct in a strictly full triangulated property. -/
lemma prop_biprod_of_isTriangulated (P : ObjectProperty C) [P.IsTriangulated]
    [P.IsClosedUnderIsomorphisms] {X Y : C} [HasBinaryBiproduct X Y]
    (hX : P X) (hY : P Y) : P (X ⊞ Y) :=
  P.prop_of_iso (biprod.isoProd X Y).symm (P.prop_prod X Y hX hY)

/-- Membership of a biproduct in a finite thick envelope. -/
lemma triangEnvelope_biprod [CategoryTheory.IsTriangulated C] (G X Y : C)
    [HasBinaryBiproduct X Y]
    (hX : (ObjectProperty.singleton G).triangEnvelope X)
    (hY : (ObjectProperty.singleton G).triangEnvelope Y) :
    (ObjectProperty.singleton G).triangEnvelope (X ⊞ Y) :=
  prop_biprod_of_isTriangulated _ hX hY

section RecollementApplications

universe uZ uU

variable {DZ : Type uZ} {DD : Type uD} {DU : Type uU}
  [Category.{v} DZ] [Category.{v} DD] [Category.{v} DU]
  [Preadditive DZ] [Preadditive DD] [Preadditive DU]
  [HasZeroObject DZ] [HasZeroObject DD] [HasZeroObject DU]
  [HasShift DZ ℤ] [HasShift DD ℤ] [HasShift DU ℤ]
  [∀ (n : ℤ), (shiftFunctor DZ n).Additive]
  [∀ (n : ℤ), (shiftFunctor DD n).Additive]
  [∀ (n : ℤ), (shiftFunctor DU n).Additive]
  [Pretriangulated DZ] [Pretriangulated DD] [Pretriangulated DU]
  [CategoryTheory.IsTriangulated DZ] [CategoryTheory.IsTriangulated DD]
  [CategoryTheory.IsTriangulated DU]

/-- `j_!` preserves compact objects. Its right adjoint `j^*` preserves small
coproducts because it is itself a left adjoint (`j^* ⊣ j_*`). -/
lemma Recollement.isCompactAb_jShriek_obj (R : Recollement DZ DD DU)
    {X : DU} (hX : IsCompactAb X) :
    IsCompactAb (R.jShriek.obj X) :=
  isCompactAb_leftAdjoint_obj' R.jShriekAdj hX
    (fun _ => R.jStarAdj.leftAdjoint_preservesColimits.preservesColimitsOfShape)

/-- **Lemma 4.3(1).** Under the relative classical-generation hypothesis
`hgen`, there is a nonnegative `m` with `j^*G' ∈ tU^{≤m}`.

The paper's compact-generator hypothesis is rendered here by
`IsClassicalGeneratorOnCompacts G'`: this explicitly supplies the standard
finite-thick-generation theorem on compact objects, which is not a consequence
formalized from `WeakApprox.IsGenerator`. The compactly generated aisle is used
only through `hGU0 : GU ∈ tU.le 0`; separation supplies the boundedness
criterion directly. No preferred-equivalence-class hypothesis is needed. -/
theorem lemma_4_3_1 (R : Recollement DZ DD DU) (tU : TStructure DU)
    (G' : DD) (GU : DU) (hG' : EventuallyHomZero G' G')
    (hgen : IsClassicalGeneratorOnCompacts G')
    (hGUcompact : IsCompactAb GU) (hGUgen : IsGenerator GU)
    (hGU0 : tU.le 0 GU) :
    ∃ m : ℤ, 0 ≤ m ∧ tU.le m (R.jStar.obj G') := by
  have hjCompact : IsCompactAb (R.jShriek.obj GU) :=
    R.isCompactAb_jShriek_obj hGUcompact
  have hG'mem : (ObjectProperty.singleton G').triangEnvelope G' :=
    ObjectProperty.le_triangEnvelope _ _ ((ObjectProperty.singleton_iff _ _).2 rfl)
  have he : EventuallyHomZero (R.jShriek.obj GU) G' :=
    eventuallyHomZero_of_mem_triangEnvelope hG' (hgen _ hjCompact) hG'mem
  obtain ⟨N, hN⟩ := he
  apply exists_nonneg_le_of_hom_zero_neg_shifts tU GU hGUgen hGU0
  refine ⟨N, fun n hn g => ?_⟩
  exact hom_zero_of_adjunction_of_eventuallyHomZero
    R.jShriek R.jStar R.jShriekAdj hN hn g

/-- **Lemma 4.3(4).** If `GU` is compact and compact objects are classically
generated by `G'` in the relative sense `hgen`, then
`G = G'[m] ⊞ j_!GU` has eventually vanishing positive self-shift Homs.

No separate compactness or generation hypothesis on `G` is needed: its two
summands belong to the finite thick envelope of `G'`, and that envelope is
closed under shifts and binary biproducts. -/
theorem lemma_4_3_4 (R : Recollement DZ DD DU) (G' : DD) (GU : DU) (m : ℤ)
    [HasBinaryBiproduct (G'⟦m⟧) (R.jShriek.obj GU)]
    (hG' : EventuallyHomZero G' G')
    (hgen : IsClassicalGeneratorOnCompacts G')
    (hGUcompact : IsCompactAb GU) :
    EventuallyHomZero (G'⟦m⟧ ⊞ R.jShriek.obj GU) (G'⟦m⟧ ⊞ R.jShriek.obj GU) := by
  have hjCompact : IsCompactAb (R.jShriek.obj GU) :=
    R.isCompactAb_jShriek_obj hGUcompact
  have hG'mem : (ObjectProperty.singleton G').triangEnvelope G' :=
    ObjectProperty.le_triangEnvelope _ _ ((ObjectProperty.singleton_iff _ _).2 rfl)
  have hShift : (ObjectProperty.singleton G').triangEnvelope (G'⟦m⟧) :=
    (ObjectProperty.singleton G').triangEnvelope.le_shift m _ hG'mem
  have hmem : (ObjectProperty.singleton G').triangEnvelope
      (G'⟦m⟧ ⊞ R.jShriek.obj GU) :=
    triangEnvelope_biprod G' _ _ hShift (hgen _ hjCompact)
  exact eventuallyHomZero_of_mem_triangEnvelope hG' hmem hmem

end RecollementApplications

end RelativeWeakApprox
