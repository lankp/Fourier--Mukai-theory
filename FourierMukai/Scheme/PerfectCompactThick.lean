import WeakApprox.CompactThick
import FourierMukai.Scheme.PerfectRingStacks

/-!
# Compactness of thick envelopes generated by the structure sheaf

This file proves the abstract part of the perfect-to-compact implication.
It does not prove compactness of the regular module, the affine perfectness
comparison, or the qcqs pushforward/global-sections coproduct theorem used in
Stacks 09M1 and 09M8.
-/

@[expose] public section

namespace RelativeFM

open RelativeWeakApprox
open CategoryTheory CategoryTheory.Limits
open CategoryTheory.Pretriangulated CategoryTheory.Triangulated
open AlgebraicGeometry
open AffinePerfect

universe u w

attribute [local instance] HasDerivedCategory.standard

/-- If the regular module is coproduct-compact, every object of `Perf A` is
coproduct-compact.  The only remaining ring-level input is compactness of the
regular module itself. -/
theorem perf_le_isCompactAb (A : Type u) [CommRing A]
    (hA : IsCompactAb (ringObject A)) : Perf A ≤ compactObjectProperty _ := by
  exact triangEnvelope_singleton_le_compact hA

/-- Objectwise form of `perf_le_isCompactAb`. -/
theorem isCompactAb_of_perf (A : Type u) [CommRing A]
    (hA : IsCompactAb (ringObject A)) {X : DerivedCategory (ModuleCat A)}
    (hX : Perf A X) : IsCompactAb X :=
  perf_le_isCompactAb A hA X hX

/-- The existing separate easy-direction interface is furnished by
compactness of the regular module alone. -/
theorem perfectToCompactInput_of_ringObject (A : Type u) [CommRing A]
    (hA : IsCompactAb (ringObject A)) : PerfectToCompactInput A where
  compact_of_perfect _X hX := isCompactAb_of_perf A hA hX

/-- The regular generator in the quasicoherent affine derived category is
compact if the ordinary regular module is. -/
theorem isCompactAb_qcRingObject (A : CommRingCat.{u})
    (hA : IsCompactAb (ringObject A)) : IsCompactAb (qcRingObject A) := by
  have h : IsCompactAb ((affineDerivedEquivalence A).functor.obj (ringObject A)) :=
    isCompactAb_leftAdjoint_obj' (affineDerivedEquivalence A).toAdjunction hA
      (fun _ => inferInstance)
  exact isCompactAb_of_iso (affineDerivedRingObjectIso A) h

/-- Compactness of the whole thick envelope in the quasicoherent affine model,
again assuming only compactness of the ordinary regular module. -/
theorem qcThickGenerated_le_isCompactAb (A : CommRingCat.{u})
    (hA : IsCompactAb (ringObject A)) : qcThickGenerated A ≤ compactObjectProperty _ :=
  triangEnvelope_singleton_le_compact (isCompactAb_qcRingObject A hA)

/-- The affine thick envelope of the structure sheaf is compact as soon as the
structure sheaf in degree zero is compact in the ambient derived category. -/
theorem affineThickGenerated_le_isCompactAb (A : CommRingCat.{u})
    (hUnit : IsCompactAb (affineUnitDerived A)) :
    affineThickGenerated A ≤ compactObjectProperty _ := by
  rw [affineThickGenerated_eq]
  exact triangEnvelope_singleton_le_compact hUnit

/-- Affine perfect objects are ambiently coproduct-compact, modulo exactly the
existing affine perfectness comparison and compactness of the structure sheaf.
This is not yet the qcqs theorem 09M8, whose compactness is taken in `D_QCoh`. -/
theorem isCompactAb_of_isPerfect_affine (A : CommRingCat.{u})
    (hPerfect : AffinePerfectCharacterization A)
    (hUnit : IsCompactAb (affineUnitDerived A))
    {E : Derived (Spec A)} (hE : IsPerfect E) : IsCompactAb E := by
  apply affineThickGenerated_le_isCompactAb A hUnit E
  rw [← hPerfect]
  exact hE

#print axioms perf_le_isCompactAb
#print axioms isCompactAb_of_perf
#print axioms perfectToCompactInput_of_ringObject
#print axioms isCompactAb_qcRingObject
#print axioms qcThickGenerated_le_isCompactAb
#print axioms affineThickGenerated_le_isCompactAb
#print axioms isCompactAb_of_isPerfect_affine

end RelativeFM
