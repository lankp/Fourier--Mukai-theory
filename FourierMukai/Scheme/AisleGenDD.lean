import FourierMukai.Scheme.AisleGenRingGeneration

/-! # Downstream check of the dD ring-aisle theorem -/

namespace RelativeFM.AisleGeneration.DD

open RelativeWeakApprox
open RelativeFM

universe u

attribute [local instance] HasDerivedCategory.standard

/-- Exported form of `(dD)`: the standard derived aisle is generated by the
nonnegative shifts of the regular module. -/
theorem ring_aisle_eq_coprod (A : Type u) [CommRing A] :
    (AffineD.standardTStructure A).le 0 = Coprod (shiftTail (ringObject A) 0) :=
  Ring.standard_le_zero_eq_coprod A

end RelativeFM.AisleGeneration.DD

#print axioms RelativeFM.AisleGeneration.DD.ring_aisle_eq_coprod
