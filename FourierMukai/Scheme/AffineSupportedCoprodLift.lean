import FourierMukai.Scheme.AffineSupportedAisle

@[expose] public section

namespace RelativeFM.SupportedAisleM6

open RelativeWeakApprox
open CategoryTheory CategoryTheory.Limits
open CategoryTheory.Pretriangulated CategoryTheory.Triangulated
open ZeroObject

universe u v

noncomputable section

attribute [local instance] HasDerivedCategory.standard

/-- Ambient coproduct-and-extension closure of the shifts of a supported object
stays in the supported subcategory. -/
lemma affineIsSupported_of_ambient_coprod (A : Type u) [CommRing A] (f : A)
    [HasCoproducts.{u + 1} (AffineD A)] (GU : AffineDZ A f) {X : AffineD A}
    (hX : Coprod (shiftTail GU.obj 0) X) : AffineIsSupported A f X := by
  let P := AffineIsSupported A f
  letI (J : Type (u + 1)) : P.IsClosedUnderColimitsOfShape (Discrete J) :=
    affineIsSupported_isClosedUnderColimitsOfShape A f (Discrete J)
  letI : P.IsClosedUnderIsomorphisms := by
    dsimp [P]
    unfold AffineIsSupported
    infer_instance
  refine Coprod.le (Q := P) ?_ X hX
  rintro Y ⟨n, hn, ⟨e⟩⟩
  exact P.prop_of_iso e.symm (P.le_shift n GU.obj GU.property)

/-- If an ambient `Coprod` construction is generated by the underlying shifts
of a supported object, then it lifts to the supported `Coprod` construction.
The hypothesis supplies the large coproducts used to realize the coreflective
supported colimits. -/
lemma supported_coprod_of_ambient (A : Type u) [CommRing A] (f : A)
    [HasCoproducts.{u + 1} (AffineD A)] (GU : AffineDZ A f) {X : AffineDZ A f}
    (hX : Coprod (shiftTail GU.obj 0) X.obj) : Coprod (shiftTail GU 0) X := by
  let P := AffineIsSupported A f
  have hP : ∀ {Y : AffineD A}, Coprod (shiftTail GU.obj 0) Y → P Y :=
    fun {Y} hY => affineIsSupported_of_ambient_coprod A f GU hY
  let rep : ∀ {Y : AffineD A}, Coprod (shiftTail GU.obj 0) Y → AffineDZ A f :=
    fun {Y} hY => ⟨Y, hP hY⟩
  have main : ∀ {Y : AffineD A} (hY : Coprod (shiftTail GU.obj 0) Y),
      Coprod (shiftTail GU 0) (rep hY) := by
    intro Y hY
    induction hY with
    | of_mem Y hY =>
        obtain ⟨n, hn, ⟨e⟩⟩ := hY
        let e' : rep (Coprod.of_mem Y ⟨n, hn, ⟨e⟩⟩) ≅ GU⟦n⟧ :=
          P.fullyFaithfulι.preimageIso
            (e ≪≫ ((affineDZι A f).commShiftIso n).symm.app GU)
        exact Coprod.of_isoClosure e'.symm (Coprod.of_mem _ ⟨n, hn, ⟨Iso.refl _⟩⟩)
    | of_isoClosure e hY ih =>
        let e' : rep hY ≅ rep (Coprod.of_isoClosure e hY) :=
          P.fullyFaithfulι.preimageIso e
        exact Coprod.of_isoClosure e' ih
    | @of_colimitPresentation Y J pres hmem ih =>
        let D : Discrete J ⥤ AffineDZ A f :=
          P.lift pres.diag (fun j => hP (hmem j))
        letI : HasColimit D := hasColimit_of_coreflective D (affineDZι A f)
        let e : colimit D ≅ rep (Coprod.of_colimitPresentation pres hmem) :=
          P.fullyFaithfulι.preimageIso
            ((isColimitOfPreserves (affineDZι A f)
              (colimit.isColimit D)).coconePointUniqueUpToIso pres.isColimit)
        apply Coprod.of_isoClosure e
        apply Coprod.of_colimitPresentation (ColimitPresentation.colimit D)
        intro j
        exact ih j
    | of_extension T hT h₁ h₃ ih₁ ih₃ =>
        let f₁ : rep h₁ ⟶ rep (Coprod.of_extension T hT h₁ h₃) :=
          P.fullyFaithfulι.preimage T.mor₁
        let f₂ : rep (Coprod.of_extension T hT h₁ h₃) ⟶ rep h₃ :=
          P.fullyFaithfulι.preimage T.mor₂
        let f₃ : rep h₃ ⟶ (rep h₁)⟦(1 : ℤ)⟧ :=
          P.fullyFaithfulι.preimage
            (T.mor₃ ≫ ((affineDZι A f).commShiftIso (1 : ℤ)).inv.app (rep h₁))
        let T' : Triangle (AffineDZ A f) := Triangle.mk f₁ f₂ f₃
        have hT' : T' ∈ distTriang (AffineDZ A f) := by
          change (affineDZι A f).mapTriangle.obj T' ∈ distTriang (AffineD A)
          dsimp [T', f₁, f₂, f₃, Functor.mapTriangle]
          with_unfolding_all
            change Triangle.mk T.mor₁ T.mor₂
              ((T.mor₃ ≫ ((affineDZι A f).commShiftIso (1 : ℤ)).inv.app (rep h₁)) ≫
                ((affineDZι A f).commShiftIso (1 : ℤ)).hom.app (rep h₁)) ∈
              distTriang (AffineD A)
          rw [Category.assoc, Iso.inv_hom_id_app]
          convert hT using 1
          cases T
          rename_i X₁ X₂ X₃ m₁ m₂ m₃
          change Triangle.mk m₁ m₂ (m₃ ≫ 𝟙 ((shiftFunctor (AffineD A) (1 : ℤ)).obj X₁)) = _
          rw [Category.comp_id]
          rfl
        exact Coprod.of_extension T' hT' ih₁ ih₃
  let e : rep hX ≅ X := P.fullyFaithfulι.preimageIso (Iso.refl X.obj)
  exact Coprod.of_isoClosure e (main hX)

/-- Supported and ambient `Coprod` constructions on a supported generator
agree exactly on supported objects. -/
lemma supported_coprod_iff_ambient (A : Type u) [CommRing A] (f : A)
    [HasCoproducts.{u + 1} (AffineD A)] (GU : AffineDZ A f) (X : AffineDZ A f) :
    Coprod (shiftTail GU 0) X ↔ Coprod (shiftTail GU.obj 0) X.obj :=
  ⟨map_supported_coprod GU, supported_coprod_of_ambient A f GU⟩

/-- The underlying object of the proposed supported generator is the explicit
local-cohomology complex of the regular module, shifted by one. -/
noncomputable def supportedAisleGeneratorObjIso (A : Type u) [CommRing A] (f : A) :
    (supportedAisleGenerator A f).obj ≅
      ((AffineLocalCohomology.derivedFunctor A f).obj (ringObject A))⟦(1 : ℤ)⟧ :=
  ((affineDZι A f).commShiftIso (1 : ℤ)).app
      ((AffineLocalCohomology.jStar A f).obj (ringObject A)) ≪≫
    (shiftFunctor (AffineD A) (1 : ℤ)).mapIso
      ((AffineLocalCohomology.jStarFactors A f).app (ringObject A))

/-- `Coprod (shiftTail _ 0)` is invariant under isomorphism of its generator. -/
lemma coprod_shiftTail_congr {C : Type u} [Category.{v} C] [Preadditive C]
    [HasZeroObject C] [HasShift C ℤ] [∀ n : ℤ, (shiftFunctor C n).Additive]
    [Pretriangulated C] {G H : C} (e : G ≅ H) :
    Coprod (shiftTail G 0) ≤ Coprod (shiftTail H 0) := by
  apply Coprod.monotone
  rintro X ⟨n, hn, ⟨eX⟩⟩
  exact ⟨n, hn, ⟨eX ≪≫ (shiftFunctor C n).mapIso e⟩⟩

/-- Exact ambient reduction of the supported compact-generation field.
The right-hand side quantifies only over supported objects; it is not an
assumption of the supported aisle equality itself. -/
lemma supported_standard_aisle_eq_coprod_iff (A : Type u) [CommRing A] (f : A)
    [HasCoproducts.{u + 1} (AffineD A)] (GU : AffineDZ A f)
    (hGU : (Recollement.AssemblyM6.affineDZStandardTStructure A f).le 0 GU) :
    (Recollement.AssemblyM6.affineDZStandardTStructure A f).le 0 =
        Coprod (shiftTail GU 0) ↔
      ∀ X : AffineDZ A f, (AffineD.standardTStructure A).le 0 X.obj →
        Coprod (shiftTail GU.obj 0) X.obj := by
  constructor
  · intro h X hX
    apply map_supported_coprod GU
    rw [← h]
    exact hX
  · intro h
    apply le_antisymm
    · intro X hX
      exact supported_coprod_of_ambient A f GU (h X hX)
    · exact coprod_shiftTail_le _ _ hGU

/-- The supported aisle generated by `RΓ_Z(A)[1]` is determined by the
corresponding ambient generation statement on supported objects. -/
lemma supportedAisleGenerator_aisle_eq_coprod_iff (A : Type u) [CommRing A] (f : A)
    [HasCoproducts.{u + 1} (AffineD A)] :
    (Recollement.AssemblyM6.affineDZStandardTStructure A f).le 0 =
        Coprod (shiftTail (supportedAisleGenerator A f) 0) ↔
      ∀ X : AffineDZ A f, (AffineD.standardTStructure A).le 0 X.obj →
        Coprod (shiftTail
          (((AffineLocalCohomology.derivedFunctor A f).obj (ringObject A))⟦(1 : ℤ)⟧) 0)
          X.obj := by
  rw [supported_standard_aisle_eq_coprod_iff A f (supportedAisleGenerator A f)
    (supportedAisleGenerator_mem_le_zero A f)]
  constructor
  · intro h X hX
    exact coprod_shiftTail_congr (supportedAisleGeneratorObjIso A f) _ (h X hX)
  · intro h X hX
    exact coprod_shiftTail_congr (supportedAisleGeneratorObjIso A f).symm _ (h X hX)

end
end RelativeFM.SupportedAisleM6

