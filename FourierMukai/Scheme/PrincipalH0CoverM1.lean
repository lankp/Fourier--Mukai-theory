attribute [local instance] HasDerivedCategory.standard

/-- The `i`th basis inclusion into a free module. -/
def freeBasisMap (A : Type u) [CommRing A] {ι : Type u} (i : ι) :
    ModuleCat.of A A ⟶ (ModuleCat.free A).obj ι :=
  ModuleCat.ofHom (Finsupp.lsingle i)

@[simp] lemma freeBasisMap_apply (A : Type u) [CommRing A] {ι : Type u}
    (i : ι) (a : A) : freeBasisMap A i a = Finsupp.single i a := rfl

/-- The canonical quotient of a free module onto the module generated by its
basis-indexing set. -/
def freeLinearCombination (A : Type u) [CommRing A] (M : ModuleCat.{u} A) :
    (ModuleCat.free A).obj M ⟶ M :=
  ModuleCat.ofHom (Finsupp.linearCombination A _root_.id)

lemma freeLinearCombination_surjective (A : Type u) [CommRing A]
    (M : ModuleCat.{u} A) : Function.Surjective (freeLinearCombination A M) := by
  intro x
  refine ⟨Finsupp.single x (1 : A), ?_⟩
  change (Finsupp.linearCombination A _root_.id) (Finsupp.single x (1 : A)) = x
  rw [Finsupp.linearCombination_single]
  simp

instance freeLinearCombination_epi (A : Type u) [CommRing A] (M : ModuleCat.{u} A) :
    Epi (freeLinearCombination A M) :=
  (ModuleCat.epi_iff_surjective _).mpr (freeLinearCombination_surjective A M)

/-- A derived-coproduct presentation of a free module, together with its
basis-injection formula. -/
structure DerivedFreeCoproductData (A : Type u) [CommRing A] (ι : Type u) where
  iso : (RelativeFM.DerivedCoproducts.derivedCoproductCofan
      (fun _ : ι => (HomologicalComplex.single (ModuleCat.{u} A) (ComplexShape.up ℤ) 0).obj
        (ModuleCat.of A A))).pt ≅
    DerivedCategory.Q.obj ((HomologicalComplex.single (ModuleCat.{u} A) (ComplexShape.up ℤ) 0).obj
      ((ModuleCat.free A).obj ι))
  injection : ∀ i : ι,
    (RelativeFM.DerivedCoproducts.derivedCoproductCofan
      (fun _ : ι => (HomologicalComplex.single (ModuleCat.{u} A) (ComplexShape.up ℤ) 0).obj
        (ModuleCat.of A A))).inj i ≫ iso.hom =
      DerivedCategory.Q.map ((HomologicalComplex.single (ModuleCat.{u} A) (ComplexShape.up ℤ) 0).map
        (freeBasisMap A i))

/-- Construct the explicit derived-coproduct presentation of a free module. -/
noncomputable def derivedFreeCoproductData
    (A : Type u) [CommRing A] (ι : Type u) : DerivedFreeCoproductData A ι := by
  let R : ι → ModuleCat.{u} A := fun _ => ModuleCat.of A A
  let K : ι → CochainComplex (ModuleCat.{u} A) ℤ := fun j =>
    (HomologicalComplex.single (ModuleCat.{u} A) (ComplexShape.up ℤ) 0).obj (R j)
  let cc := colimit.cocone (Discrete.functor R)
  have hcc : IsColimit cc := colimit.isColimit _
  let hcSingle : IsColimit
      ((HomologicalComplex.single (ModuleCat.{u} A) (ComplexShape.up ℤ) 0).mapCocone cc) :=
    isColimitOfPreserves (HomologicalComplex.single (ModuleCat.{u} A) (ComplexShape.up ℤ) 0) hcc
  let eD : (Discrete.functor R ⋙ HomologicalComplex.single (ModuleCat.{u} A)
      (ComplexShape.up ℤ) 0) ≅ Discrete.functor K := Discrete.natIsoFunctor
  let presSingle : ColimitPresentation (Discrete ι)
      ((HomologicalComplex.single (ModuleCat.{u} A) (ComplexShape.up ℤ) 0).obj cc.pt) :=
    { diag := Discrete.functor R ⋙ HomologicalComplex.single (ModuleCat.{u} A)
        (ComplexShape.up ℤ) 0
      ι := ((HomologicalComplex.single (ModuleCat.{u} A) (ComplexShape.up ℤ) 0).mapCocone cc).ι
      isColimit := hcSingle }
  let presK := presSingle.changeDiag eD.symm
  let e₁ : (RelativeFM.DerivedCoproducts.coproductComplexCocone K).pt ≅
      (HomologicalComplex.single (ModuleCat.{u} A) (ComplexShape.up ℤ) 0).obj cc.pt :=
    IsColimit.coconePointUniqueUpToIso
      (RelativeFM.DerivedCoproducts.coproductComplexCoconeIsColimit K) presK.isColimit
  let e₂ : cc.pt ≅ (ModuleCat.free A).obj ι :=
    IsColimit.coconePointUniqueUpToIso hcc (ModuleCat.finsuppCoconeIsColimit A A ι)
  refine
    { iso := DerivedCategory.Q.mapIso (e₁ ≪≫
        (HomologicalComplex.single (ModuleCat.{u} A) (ComplexShape.up ℤ) 0).mapIso e₂)
      injection := ?_ }
  intro i
  have h₁ := IsColimit.comp_coconePointUniqueUpToIso_hom
    (RelativeFM.DerivedCoproducts.coproductComplexCoconeIsColimit K) presK.isColimit
      (⟨i⟩ : Discrete ι)
  have h₂ := IsColimit.comp_coconePointUniqueUpToIso_hom hcc
    (ModuleCat.finsuppCoconeIsColimit A A ι) (⟨i⟩ : Discrete ι)
  change (RelativeFM.DerivedCoproducts.derivedCoproductCofan K).inj i ≫
      DerivedCategory.Q.map (e₁.hom ≫ (HomologicalComplex.single (ModuleCat.{u} A)
        (ComplexShape.up ℤ) 0).map e₂.hom) =
    DerivedCategory.Q.map ((HomologicalComplex.single (ModuleCat.{u} A) (ComplexShape.up ℤ) 0).map
      (freeBasisMap A i))
  dsimp [K, R]
  rw [← DerivedCategory.Q.map_comp]
  congr 1
  change (RelativeFM.DerivedCoproducts.coproductComplexCocone K).ι.app ⟨i⟩ ≫
      e₁.hom ≫ (HomologicalComplex.single (ModuleCat.{u} A)
        (ComplexShape.up ℤ) 0).map e₂.hom =
    (HomologicalComplex.single (ModuleCat.{u} A) (ComplexShape.up ℤ) 0).map (freeBasisMap A i)
  rw [← Category.assoc, h₁]
  dsimp [presK, presSingle, eD]
  dsimp [K, R]
  simp only [Iso.symm_hom, Discrete.natIsoFunctor_hom_app, NatTrans.id_app,
    Category.id_comp]
  rw [← Functor.map_comp]
  dsimp [R] at h₂
  change cc.ι.app ⟨i⟩ ≫ e₂.hom = freeBasisMap A i at h₂
  exact congrArg (HomologicalComplex.single (ModuleCat.{u} A) (ComplexShape.up ℤ) 0).map h₂

/-- The underlying free-coproduct comparison isomorphism. -/
noncomputable def derivedCoproductSingleFreeIso
    (A : Type u) [CommRing A] (ι : Type u) :=
  (derivedFreeCoproductData A ι).iso

/-- The coproduct injections are exactly the derived basis inclusions. -/
lemma derivedCoproductSingleFreeIso_injection (A : Type u) [CommRing A]
    (ι : Type u) (i : ι) :
    (RelativeFM.DerivedCoproducts.derivedCoproductCofan
      (fun _ : ι => (HomologicalComplex.single (ModuleCat.{u} A) (ComplexShape.up ℤ) 0).obj
        (ModuleCat.of A A))).inj i ≫
      (derivedCoproductSingleFreeIso A ι).hom =
        DerivedCategory.Q.map ((HomologicalComplex.single (ModuleCat.{u} A) (ComplexShape.up ℤ) 0).map
          (freeBasisMap A i)) :=
  (derivedFreeCoproductData A ι).injection i


section Bounds

/-- Every positive Koszul power is in the unshifted coproduct-and-extension
closure of the first Koszul cone. -/
theorem coneData_pow_mem_coprod_interval (A : Type u) [CommRing A] (a : A)
    (n : ℕ) (hn : 0 < n) :
    Coprod (shiftInterval (coneData A a).obj 0 0) (coneData A (a ^ n)).obj := by
  let P := Coprod (shiftInterval (coneData A a).obj 0 0)
  have hbase : P (coneData A a).obj :=
    Coprod.of_mem _ (shiftInterval_self _ le_rfl le_rfl)
  induction n with
  | zero => omega
  | succ n ih =>
      by_cases h : n = 0
      · subst n
        change P (coneData A (a ^ 1)).obj
        rw [pow_one]
        exact hbase
      · have hprev : P (coneData A (a ^ n)).obj := ih (Nat.pos_of_ne_zero h)
        have hcomm : derivedMultiplication A (a ^ n) ≫ derivedMultiplication A a =
            derivedMultiplication A (a ^ (n + 1)) := by
          rw [AffineSupportedBaseM1.derivedMultiplication_comp, pow_succ]
        let o := Triangulated.someOctahedron hcomm
          (coneData A (a ^ n)).distinguished
          (coneData A a).distinguished
          (coneData A (a ^ (n + 1))).distinguished
        exact Coprod.of_extension o.triangle o.mem hprev hbase

/-- The power Koszul cone, viewed with support on the original element. -/
noncomputable def supportedPowerGenerator (A : Type u) [CommRing A] (a : A) (n : ℕ) :
    AffineDZ A a :=
  ⟨(coneData A (a ^ n)).obj, by
    intro k
    apply powerTorsion_iff.mpr
    intro x
    obtain ⟨m, hm⟩ := powerTorsion_iff.mp ((coneData_obj_isSupported A (a ^ n)) k) x
    exact ⟨n * m, by simpa only [pow_mul] using hm⟩⟩

/-- The same unshifted bound inside the supported category. -/
theorem supportedGenerator_pow_mem_coprod_interval
    (A : Type u) [CommRing A] (a : A) (n : ℕ) (hn : 0 < n) :
    Coprod (shiftInterval (supportedGenerator A a) 0 0)
      (supportedPowerGenerator A a n) := by
  rw [← SupportedCoproductM1.shiftInterval_inverseImage A a (supportedGenerator A a) 0 0]
  apply SupportedCoproductM1.supported_coprod_preimage_of_ambient A a _ _
    (coneData_pow_mem_coprod_interval A a n hn)
  intro Y hY
  exact SupportedCoproductM1.affineIsSupported_of_ambient_coprod_interval
    A a (supportedGenerator A a) 0 0 hY


end Bounds


/-- Neeman's free-cover construction for a principal closed support. -/
theorem principalSupportedH0Cover (A : Type u) [CommRing A] (f : A) :
    ClosedSupportNeemanM4.PrincipalSupportedH0Cover A f (supportedGenerator A f) 2 := by
  intro F hF
  let H0 := DerivedCategory.homologyFunctor (ModuleCat.{u} A) 0
  let M : Type u := H0.obj F.obj
  letI : F.obj.IsLE 0 := (DerivedCategory.TStructure.t.le_iff_isLE F.obj 0).mp hF
  obtain ⟨K, hK, ⟨eFK⟩⟩ := DerivedCategory.exists_iso_Q_obj_of_isLE F.obj 0
  letI : K.IsStrictlyLE 0 := hK
  let ρ : (ModuleCat.free A).obj M ⟶ H0.obj F.obj :=
    freeLinearCombination A (H0.obj F.obj)
  letI : Epi ρ := by
    dsimp [ρ]
    infer_instance
  letI : Projective ((ModuleCat.free A).obj M) := inferInstance
  obtain ⟨ψ, hψ⟩ := FreeDerivedCoverM1.exists_derived_from_single_projective K eFK.symm ρ
  have hψepi : Epi (H0.map ψ) := by
    rw [← hψ]
    infer_instance
  let basis : ∀ i : M, ringObject A ⟶
      DerivedCategory.Q.obj ((HomologicalComplex.single (ModuleCat.{u} A)
        (ComplexShape.up ℤ) 0).obj ((ModuleCat.free A).obj M)) := fun i =>
    DerivedCategory.Q.map ((HomologicalComplex.single (ModuleCat.{u} A)
      (ComplexShape.up ℤ) 0).map (freeBasisMap A i))
  choose n hn β hβ using fun i : M =>
    NeemanFiniteSupportM4.exists_principal_koszul_factorization A f F.property (basis i ≫ ψ)
  let S := Spaltenstein.affineSpaltensteinInput A
  let R := fun i : M => S.resolution (coneData A (f ^ n i)).obj
  let K' : M → CochainComplex (ModuleCat.{u} A) ℤ := fun i => (R i).complex
  letI : ∀ i : M, (K' i).IsKProjective := fun i => (R i).isKProjective
  let t : Cofan (fun i : M => DerivedCategory.Q.obj (K' i)) :=
    Cofan.mk F.obj (fun i => (R i).iso.hom ≫ β i)
  let α : (RelativeFM.DerivedCoproducts.derivedCoproductCofan K').pt ⟶ F.obj :=
    RelativeFM.DerivedCoproducts.derivedCoproductDesc K' t
  let Kreg : M → CochainComplex (ModuleCat.{u} A) ℤ := fun _ =>
    (HomologicalComplex.single (ModuleCat.{u} A) (ComplexShape.up ℤ) 0).obj
      (ModuleCat.of A A)
  have hKreg : ∀ i : M, (Kreg i).IsKProjective := by
    intro i
    dsimp [Kreg]
    exact CochainComplex.isKProjective_of_projective _ 0
  letI := hKreg
  let tq : Cofan (fun i : M => DerivedCategory.Q.obj (Kreg i)) :=
    Cofan.mk (RelativeFM.DerivedCoproducts.derivedCoproductCofan K').pt (fun i =>
      (coneData A (f ^ n i)).second ≫ (R i).iso.inv ≫
        (RelativeFM.DerivedCoproducts.derivedCoproductCofan K').inj i)
  let q0 := @RelativeFM.DerivedCoproducts.derivedCoproductDesc
    (ModuleCat.{u} A) _ _ M Kreg _ _ hKreg tq
  let eL := derivedCoproductSingleFreeIso A M
  let qfree : DerivedCategory.Q.obj ((HomologicalComplex.single (ModuleCat.{u} A)
      (ComplexShape.up ℤ) 0).obj ((ModuleCat.free A).obj M)) ⟶
      (RelativeFM.DerivedCoproducts.derivedCoproductCofan K').pt := eL.inv ≫ q0
  have hfactor : ψ = qfree ≫ α := by
    apply (cancel_epi eL.hom).mp
    apply (@RelativeFM.DerivedCoproducts.derivedCoproductCofanIsColimit
      (ModuleCat.{u} A) _ _ M Kreg _ _ hKreg).hom_ext
    rintro ⟨i⟩
    calc
      (RelativeFM.DerivedCoproducts.derivedCoproductCofan Kreg).inj i ≫ eL.hom ≫ ψ =
          basis i ≫ ψ := by
        rw [← Category.assoc, derivedCoproductSingleFreeIso_injection]
      _ = (coneData A (f ^ n i)).second ≫ β i := (hβ i).symm
      _ = (RelativeFM.DerivedCoproducts.derivedCoproductCofan Kreg).inj i ≫
          eL.hom ≫ eL.inv ≫ q0 ≫ α := by
        rw [Iso.hom_inv_id_assoc]
        rw [← Category.assoc, RelativeFM.DerivedCoproducts.derivedCoproductDesc_fac]
        dsimp [tq, α, Kreg]
        rw [show DerivedCategory.Q.map
            ((RelativeFM.DerivedCoproducts.coproductComplexCocone K').ι.app { as := i }) =
          (RelativeFM.DerivedCoproducts.derivedCoproductCofan K').inj i from rfl]
        rw [Category.assoc, Category.assoc,
          RelativeFM.DerivedCoproducts.derivedCoproductDesc_fac]
        simp [t, Category.assoc]
    simp [qfree]
  let P₀ : ObjectProperty (AffineD A) := shiftInterval (supportedGenerator A f).obj 0 0
  have hmem (i : M) : Coprod P₀ (DerivedCategory.Q.obj (K' i)) := by
    apply Coprod.of_isoClosure (R i).iso.symm
    exact coneData_pow_mem_coprod_interval A f (n i) (hn i)
  have hEamb : Coprod P₀ (RelativeFM.DerivedCoproducts.derivedCoproductCofan K').pt := by
    exact RelativeFM.AisleGeneration.DerivedCoproduct.coprod_Q_coproductComplex P₀ K' hmem
  have hsupp : AffineIsSupported A f
      (RelativeFM.DerivedCoproducts.derivedCoproductCofan K').pt :=
    SupportedCoproductM1.affineIsSupported_of_ambient_coprod_interval
      A f (supportedGenerator A f) 0 0 hEamb
  let E : AffineDZ A f :=
    ⟨(RelativeFM.DerivedCoproducts.derivedCoproductCofan K').pt, hsupp⟩
  have hEpre : Coprod (P₀.inverseImage (affineDZι A f)) E := by
    apply SupportedCoproductM1.supported_coprod_preimage_of_ambient A f P₀ _ hEamb
    intro Y hY
    exact SupportedCoproductM1.affineIsSupported_of_ambient_coprod_interval
      A f (supportedGenerator A f) 0 0 hY
  have hEcop : Coprod (shiftInterval (supportedGenerator A f) 0 0) E := by
    rw [← SupportedCoproductM1.shiftInterval_inverseImage
      A f (supportedGenerator A f) 0 0]
    exact hEpre
  have hEnv : envelope (supportedGenerator A f) (-2) 2 E := by
    apply lemma31_2_mono (supportedGenerator A f) (a := 0) (b := 0)
      (a' := -2) (b' := 2) (by omega) (by omega)
    exact ObjectProperty.le_retractClosure _ E hEcop
  have hEb : (Recollement.AssemblyM6.affineDZStandardTStructure A f).le 0 E := by
    let t₀ := Recollement.AssemblyM6.affineDZStandardTStructure A f
    letI (J : Type (u + 1)) : (t₀.le 0).IsClosedUnderColimitsOfShape (Discrete J) :=
      TStructure.le_isClosedUnderColimitsOfShape t₀ 0 (Discrete J)
    letI : (t₀.le 0).IsTriangulatedClosed₂ := TStructure.le_isTriangulatedClosed₂ t₀ 0
    refine Coprod.le (Q := t₀.le 0) ?_ E hEcop
    rintro Y ⟨k, hk₀, hk₁, ⟨e⟩⟩
    have hk : k = 0 := by omega
    subst k
    apply (t₀.le 0).prop_of_iso e.symm
    exact (t₀.le 0).prop_of_iso ((shiftFunctorZero (AffineDZ A f) ℤ).symm.app _)
      (supportedGenerator_mem_le_zero A f)
  let qfree' : E ⟶ F := (affineDZι A f).preimage α
  refine ⟨E, qfree', hEnv, hEb, ?_⟩
  have hαepi : Epi (H0.map α) := by
    letI : Epi (H0.map ψ) := hψepi
    exact epi_of_epi_fac (f := H0.map qfree) (g := H0.map α) (h := H0.map ψ)
      (by rw [← Functor.map_comp, ← hfactor])
  change Epi (H0.map ((affineDZι A f).map qfree'))
  have hq : (affineDZι A f).map qfree' = α := by
    simpa [qfree'] using (affineDZι A f).map_preimage (X := E) (Y := F) α
  rw [hq]
  exact hαepi

end

