/-
Specific generators for the two affine standard-aisle identities.

The affine orientation is the one of the (deleted) `AffineSetupInventory`: the `DZ` slot is
`D(A[1/f])`, the middle category is `D(A)`, and the `DU` slot is the supported
category.  Throughout this file `G' = ringObject A` and `m = 0`.
-/
import FourierMukai.Scheme.AffineLocalCohomologyRingObject
import FourierMukai.Scheme.AisleGenRingGeneration
import FourierMukai.Scheme.AffineSupportedCoprodLift
import FourierMukai.Scheme.AffineKoszulGenerator
import FourierMukai.Scheme.AffineUniverse
import FourierMukai.Scheme.AffineSpaltenstein
import WeakApprox.CoprodRetract

@[expose] public section

namespace RelativeFM.AisleGeneration.SpecificM3

open RelativeWeakApprox
open CategoryTheory CategoryTheory.Limits
open CategoryTheory.Pretriangulated CategoryTheory.Triangulated
open ZeroObject

universe u

noncomputable section

attribute [local instance] HasDerivedCategory.standard

variable (A : Type u) [CommRing A] (f : A)

/-- The proposed unnormalised middle generator. -/
abbrev GPrime (A : Type u) [CommRing A] : AffineD A := ringObject A

/-- The proposed normalising shift. -/
abbrev normalization : ℤ := 0

/-- The open-localization image of the normalized generator, for any
recollement whose `iStar` has the usual value on the regular module. -/
noncomputable def normalizedOpenGeneratorIso
    (R : AffineRecollement A f)
    (GU : AffineDZ A f)
    (e : R.iStar.obj (ringObject A) ≅ ringObject (Away A f)) :
    R.iStar.obj ((ringObject A)⟦(0 : ℤ)⟧ ⊞ R.jShriek.obj GU) ≅
      ringObject (Away A f) := by
  let e₀ : R.iStar.obj ((ringObject A)⟦(0 : ℤ)⟧) ≅ ringObject (Away A f) :=
    (R.iStar.commShiftIso (0 : ℤ)).app (ringObject A) ≪≫
      (shiftFunctorZero (AffineD (Away A f)) ℤ).app (R.iStar.obj (ringObject A)) ≪≫ e
  letI : PreservesBiproductsOfShape WalkingPair R.iStar := inferInstance
  letI : PreservesBinaryBiproducts R.iStar :=
    preservesBinaryBiproducts_of_preservesBiproducts R.iStar
  exact R.iStar.mapBiprod _ _ ≪≫
    biprod.mapIso e₀ (IsZero.iso (R.iStar_jShriek_isZero GU) (isZero_zero _)) ≪≫
      (isoBiprodZero (isZero_zero _)).symm

/-- The open-localization standard aisle is generated by the image of the
normalized generator.  The only choice of `GU` used here is that it lives in
the supported category, so `iStar` kills its `jShriek`-image. -/
theorem open_standard_le_zero_eq_coprod
    (R : AffineRecollement A f)
    (GU : AffineDZ A f)
    (e : R.iStar.obj (ringObject A) ≅ ringObject (Away A f)) :
    (AffineD.standardTStructure (Away A f)).le 0 =
      Coprod (shiftTail
        (R.iStar.obj ((ringObject A)⟦(0 : ℤ)⟧ ⊞ R.jShriek.obj GU)) 0) := by
  rw [Ring.standard_le_zero_eq_coprod]
  exact le_antisymm
    (SupportedAisleM6.coprod_shiftTail_congr (normalizedOpenGeneratorIso A f R GU e).symm)
    (SupportedAisleM6.coprod_shiftTail_congr (normalizedOpenGeneratorIso A f R GU e))

/-- In the concrete recollement assembled from `AffineRecollementInput`, the
comparison on the regular module is the already constructed derived
extension-of-scalars isomorphism. -/
noncomputable def concrete_normalizedOpenGeneratorIso
    (I : AffineRecollementInput A f) (GU : AffineDZ A f) :
    I.toRecollement.iStar.obj
        ((ringObject A)⟦(0 : ℤ)⟧ ⊞ I.toRecollement.jShriek.obj GU) ≅
      ringObject (Away A f) :=
  normalizedOpenGeneratorIso A f I.toRecollement GU
    (TensorHom.ConcreteC.derivedExtensionScalarsRingIso A f)

/-- The `tZ_compactlyGenerated` field for the concrete affine recollement,
with `G' = ringObject A` and `m = 0`. -/
theorem concrete_tZ_compactlyGenerated
    (I : AffineRecollementInput A f) (GU : AffineDZ A f) :
    (AffineD.standardTStructure (Away A f)).le 0 =
      Coprod (shiftTail (I.toRecollement.iStar.obj
        ((ringObject A)⟦(0 : ℤ)⟧ ⊞ I.toRecollement.jShriek.obj GU)) 0) :=
  open_standard_le_zero_eq_coprod A f I.toRecollement GU
    (TensorHom.ConcreteC.derivedExtensionScalarsRingIso A f)


/-- Countable copowers in the standard affine derived category, indexed in
its Hom universe.  No `Type (u+1)`-sized coproduct package is assumed: the
proved Spaltenstein coproduct construction is used only at universe zero and
transported along `ULift ℕ ≃ ℕ`. -/
theorem affineHasCoproduct_uliftNat (A : Type u) [CommRing A]
    (Z : AffineD A) : HasCoproduct (fun _ : ULift.{u + 1} ℕ => Z) := by
  let _ : HasCoproducts.{0} (AffineD A) :=
    affineHasCoproductsOfUnivLE A (Spaltenstein.affineSpaltensteinInput A)
  exact hasCoproduct_of_equiv_of_iso (fun _ : ℕ => Z) _ Equiv.ulift
    (fun _ => Iso.refl _)

/-- The middle standard aisle is generated by the normalized biproduct whenever
its supported summand lies in that aisle. -/
theorem middle_standard_le_zero_eq_coprod
    (R : AffineRecollement A f) (GU : AffineDZ A f)
    (hcop : ∀ Z : AffineD A, HasCoproduct (fun _ : ULift.{u + 1} ℕ => Z))
    (hGU : (AffineD.standardTStructure A).le 0 (R.jShriek.obj GU)) :
    (AffineD.standardTStructure A).le 0 =
      Coprod (shiftTail ((ringObject A)⟦(0 : ℤ)⟧ ⊞ R.jShriek.obj GU) 0) := by
  let e₀ : (ringObject A)⟦(0 : ℤ)⟧ ≅ ringObject A :=
    (shiftFunctorZero (AffineD A) ℤ).app (ringObject A)
  have hGU' : Coprod (shiftTail (ringObject A) 0) (R.jShriek.obj GU) := by
    rw [← Ring.standard_le_zero_eq_coprod]
    exact hGU
  have hGU₀ : Coprod (shiftTail ((ringObject A)⟦(0 : ℤ)⟧) 0)
      (R.jShriek.obj GU) :=
    SupportedAisleM6.coprod_shiftTail_congr e₀.symm _ hGU'
  calc
    (AffineD.standardTStructure A).le 0 =
        Coprod (shiftTail (ringObject A) 0) := Ring.standard_le_zero_eq_coprod A
    _ = Coprod (shiftTail ((ringObject A)⟦(0 : ℤ)⟧) 0) := le_antisymm
      (SupportedAisleM6.coprod_shiftTail_congr e₀.symm)
      (SupportedAisleM6.coprod_shiftTail_congr e₀)
    _ = Coprod (shiftTail ((ringObject A)⟦(0 : ℤ)⟧ ⊞ R.jShriek.obj GU) 0) :=
      (CoprodRetractM3.coprod_shiftTail_biprod_eq_of_mem hcop hGU₀).symm

/-- The intended supported generator: the explicit perfect Koszul cone of
multiplication by `f`, not unshifted local cohomology. -/
noncomputable abbrev supportedGenerator (A : Type u) [CommRing A] (f : A) : AffineDZ A f :=
  SupportedAisleM6.Koszul.supportedGenerator A f

/-- The `tD_compactlyGenerated` field for the concrete affine recollement,
with `G' = ringObject A`, `m = 0`, and the Koszul supported generator. -/
theorem concrete_tD_compactlyGenerated
    (I : AffineRecollementInput A f) :
    (AffineD.standardTStructure A).le 0 =
      Coprod (shiftTail ((ringObject A)⟦(0 : ℤ)⟧ ⊞
        I.toRecollement.jShriek.obj (supportedGenerator A f)) 0) := by
  apply middle_standard_le_zero_eq_coprod A f _ _ (affineHasCoproduct_uliftNat A)
  exact SupportedAisleM6.Koszul.supportedGenerator_mem_le_zero A f

/-- Both requested equalities, with one and the same explicit generator choice:
`R = I.toRecollement`, `G' = ringObject A`, `m = 0`, and
`GU = SupportedAisleM6.Koszul.supportedGenerator A f`. -/
theorem concrete_tD_and_tZ_compactlyGenerated
    (I : AffineRecollementInput A f) :
    ((AffineD.standardTStructure A).le 0 =
      Coprod (shiftTail ((ringObject A)⟦(0 : ℤ)⟧ ⊞
        I.toRecollement.jShriek.obj (supportedGenerator A f)) 0)) ∧
    ((AffineD.standardTStructure (Away A f)).le 0 =
      Coprod (shiftTail (I.toRecollement.iStar.obj
        ((ringObject A)⟦(0 : ℤ)⟧ ⊞
          I.toRecollement.jShriek.obj (supportedGenerator A f))) 0)) :=
  ⟨concrete_tD_compactlyGenerated A f I,
    concrete_tZ_compactlyGenerated A f I (supportedGenerator A f)⟩

end
end RelativeFM.AisleGeneration.SpecificM3

#print axioms RelativeFM.AisleGeneration.SpecificM3.normalizedOpenGeneratorIso
#print axioms RelativeFM.AisleGeneration.SpecificM3.open_standard_le_zero_eq_coprod
#print axioms RelativeFM.AisleGeneration.SpecificM3.concrete_tZ_compactlyGenerated
#print axioms RelativeFM.AisleGeneration.SpecificM3.middle_standard_le_zero_eq_coprod
#print axioms RelativeFM.AisleGeneration.SpecificM3.concrete_tD_compactlyGenerated
#print axioms RelativeFM.AisleGeneration.SpecificM3.concrete_tD_and_tZ_compactlyGenerated
