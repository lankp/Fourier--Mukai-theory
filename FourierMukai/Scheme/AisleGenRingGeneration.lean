/-! # The standard derived aisle is generated by the regular module -/

@[expose] public section

namespace RelativeFM.AisleGeneration.Ring

open RelativeWeakApprox
open CategoryTheory CategoryTheory.Limits
open CategoryTheory.Pretriangulated CategoryTheory.Triangulated
open RelativeFM.AisleGeneration.Brutal
open RelativeFM.AisleGeneration.Unbounded

universe v u

variable {C : Type u} [Category.{v} C] [Preadditive C] [HasZeroObject C]
  [HasShift C ℤ] [∀ (n : ℤ), (shiftFunctor C n).Additive] [Pretriangulated C]

/-- `Coprod (shiftTail G 0)` is closed under nonnegative shifts. -/
lemma coprod_shiftTail_shift (G : C) {n : ℤ} (hn : 0 ≤ n)
    {X : C} (hX : Coprod (shiftTail G 0) X) : Coprod (shiftTail G 0) (X⟦n⟧) := by
  have h := map_shift_Coprod (shiftTail G 0) n hX
  rw [shiftImage_shiftTail] at h
  apply Coprod_mono _ _ h
  rintro Y ⟨m, hm, e⟩
  exact ⟨m, by omega, e⟩

lemma coprod_shiftTail_shift_one (G : C) {X : C} (hX : Coprod (shiftTail G 0) X) :
    Coprod (shiftTail G 0) (X⟦(1 : ℤ)⟧) :=
  coprod_shiftTail_shift G (by omega) hX

noncomputable section

attribute [local instance] HasDerivedCategory.standard

set_option backward.isDefEq.respectTransparency false
set_option backward.defeqAttrib.useBackward true

/-- The regular module in a nonpositive single degree lies in the generating
class itself, up to the standard single/shift isomorphism. -/
lemma single_regular_mem (A : Type u) [CommRing A] (i : ℤ) (hi : i ≤ 0) :
    Coprod (shiftTail (ringObject A) 0) (DerivedCategory.Q.obj
      ((HomologicalComplex.single (ModuleCat.{u} A) (ComplexShape.up ℤ) i).obj
        (ModuleCat.of A A))) := by
  apply Coprod.of_mem
  refine ⟨-i, by omega, ⟨?_⟩⟩
  exact (((DerivedCategory.singleFunctors (ModuleCat.{u} A)).shiftIso
    (-i) i 0 (by omega)).app (ModuleCat.of A A)).symm

/-- A free module in a nonpositive single degree is in the coproduct/extension
closure of the regular module's nonnegative shifts. -/
lemma single_free_mem (A : Type u) [CommRing A] (I : Type u) (i : ℤ) (hi : i ≤ 0) :
    Coprod (shiftTail (ringObject A) 0) (DerivedCategory.Q.obj
      ((HomologicalComplex.single (ModuleCat.{u} A) (ComplexShape.up ℤ) i).obj
        ((ModuleCat.free A).obj I))) := by
  let R : I → ModuleCat.{u} A := fun _ => ModuleCat.of A A
  let K : I → CochainComplex (ModuleCat.{u} A) ℤ := fun j =>
    (HomologicalComplex.single (ModuleCat.{u} A) (ComplexShape.up ℤ) i).obj (R j)
  have hKproj : ∀ j, (K j).IsKProjective := fun j => by
    dsimp [K, R]
    exact CochainComplex.isKProjective_of_projective _ i
  have hK (j : I) : Coprod (shiftTail (ringObject A) 0)
      (DerivedCategory.Q.obj (K j)) := by
    exact single_regular_mem A i hi
  have hcop := @RelativeFM.AisleGeneration.DerivedCoproduct.coprod_Q_coproductComplex
    (ModuleCat.{u} A) _ _ _ I _ _ (shiftTail (ringObject A) 0) K hKproj hK
  let cc := colimit.cocone (Discrete.functor R)
  have hcc : IsColimit cc := colimit.isColimit _
  let hcSingle : IsColimit
      ((HomologicalComplex.single (ModuleCat.{u} A) (ComplexShape.up ℤ) i).mapCocone cc) :=
    isColimitOfPreserves (HomologicalComplex.single (ModuleCat.{u} A) (ComplexShape.up ℤ) i) hcc
  let eD : (Discrete.functor R ⋙
      HomologicalComplex.single (ModuleCat.{u} A) (ComplexShape.up ℤ) i) ≅
      Discrete.functor K := Discrete.natIsoFunctor
  let presSingle : ColimitPresentation (Discrete I)
      ((HomologicalComplex.single (ModuleCat.{u} A) (ComplexShape.up ℤ) i).obj cc.pt) :=
    { diag := Discrete.functor R ⋙
        HomologicalComplex.single (ModuleCat.{u} A) (ComplexShape.up ℤ) i
      ι := ((HomologicalComplex.single (ModuleCat.{u} A) (ComplexShape.up ℤ) i).mapCocone cc).ι
      isColimit := hcSingle }
  let presK := presSingle.changeDiag eD.symm
  let e₁ : (DerivedCoproducts.coproductComplexCocone K).pt ≅
      ((HomologicalComplex.single (ModuleCat.{u} A) (ComplexShape.up ℤ) i).obj
        cc.pt) :=
    IsColimit.coconePointUniqueUpToIso
      (DerivedCoproducts.coproductComplexCoconeIsColimit K) presK.isColimit
  let e₂ : cc.pt ≅ (ModuleCat.free A).obj I :=
    IsColimit.coconePointUniqueUpToIso hcc (ModuleCat.finsuppCoconeIsColimit A A I)
  exact (Coprod (shiftTail (ringObject A) 0)).prop_of_iso
    (DerivedCategory.Q.mapIso (e₁ ≪≫
      (HomologicalComplex.single (ModuleCat.{u} A) (ComplexShape.up ℤ) i).mapIso e₂)) hcop

/-- Any module with a basis has its nonpositive single complexes in the
coproduct/extension closure of the regular module. -/
lemma single_of_basis_mem (A : Type u) [CommRing A] {M : ModuleCat.{u} A}
    {I : Type u} (b : Module.Basis I A M) (i : ℤ) (hi : i ≤ 0) :
    Coprod (shiftTail (ringObject A) 0) (DerivedCategory.Q.obj
      ((HomologicalComplex.single (ModuleCat.{u} A) (ComplexShape.up ℤ) i).obj M)) := by
  exact (Coprod (shiftTail (ringObject A) 0)).prop_of_iso
    (DerivedCategory.Q.mapIso
      ((HomologicalComplex.single (ModuleCat.{u} A) (ComplexShape.up ℤ) i).mapIso
        b.repr.toModuleIso.symm))
    (single_free_mem A I i hi)

/-- The explicit free resolution puts every module in degree zero in the
coproduct/extension closure of the regular module. -/
lemma single_module_zero_mem (A : Type u) [CommRing A] (M : ModuleCat.{u} A) :
    Coprod (shiftTail (ringObject A) 0) (DerivedCategory.Q.obj
      ((HomologicalComplex.single (ModuleCat.{u} A) (ComplexShape.up ℤ) 0).obj M)) := by
  let R := FreeResolution.resolution A M
  have hterm : ∀ i : ℤ, i ≤ 0 → Coprod (shiftTail (ringObject A) 0)
      (DerivedCategory.Q.obj
        ((HomologicalComplex.single (ModuleCat.{u} A) (ComplexShape.up ℤ) i).obj
          (R.cochainComplex.X i))) := by
    intro i hi
    obtain ⟨k, rfl⟩ := Int.exists_eq_neg_ofNat hi
    obtain ⟨I, ⟨eI⟩⟩ := FreeResolution.exists_termFreeIso A M k
    let e := (HomologicalComplex.single (ModuleCat.{u} A)
      (ComplexShape.up ℤ) (-(k : ℤ))).mapIso (R.cochainComplexXIso (-(k : ℤ)) k ≪≫ eI)
    exact (Coprod (shiftTail (ringObject A) 0)).prop_of_iso
      (DerivedCategory.Q.mapIso e).symm (single_free_mem A I (-(k : ℤ)) (by omega))
  have hR := Unbounded.coprod_Q_obj_projective_of_isStrictlyLE_zero
    (shiftTail (ringObject A) 0) R.cochainComplex hterm
    (fun {_} h => coprod_shiftTail_shift_one (ringObject A) h)
  letI : IsIso (DerivedCategory.Q.map R.π') := by
    rw [DerivedCategory.isIso_Q_map_iff_quasiIso]
    infer_instance
  exact (Coprod (shiftTail (ringObject A) 0)).prop_of_iso
    (asIso (DerivedCategory.Q.map R.π')) hR

/-- Every module in every nonpositive single degree belongs to the
coproduct/extension closure of the regular module. -/
lemma single_module_mem (A : Type u) [CommRing A] (M : ModuleCat.{u} A)
    (i : ℤ) (hi : i ≤ 0) : Coprod (shiftTail (ringObject A) 0)
      (DerivedCategory.Q.obj
        ((HomologicalComplex.single (ModuleCat.{u} A) (ComplexShape.up ℤ) i).obj M)) := by
  have hs := coprod_shiftTail_shift (ringObject A) (n := -i) (by omega)
    (single_module_zero_mem A M)
  exact (Coprod (shiftTail (ringObject A) 0)).prop_of_iso
    (((DerivedCategory.singleFunctors (ModuleCat.{u} A)).shiftIso
      (-i) i 0 (by omega)).app M) hs

/-- Every strictly bounded-above complex of modules belongs to the
coproduct/extension closure of the regular module's nonnegative shifts. -/
lemma coprod_Q_obj_of_strictlyLE_zero (A : Type u) [CommRing A]
    (K : CochainComplex (ModuleCat.{u} A) ℤ) [K.IsStrictlyLE 0] :
    Coprod (shiftTail (ringObject A) 0) (DerivedCategory.Q.obj K) := by
  obtain ⟨P, π, hπ, hP, hproj⟩ :=
    KProjectiveResolution.exists_projective_resolution_of_isStrictlyLE K 0
  letI : QuasiIso π := hπ
  letI : P.IsStrictlyLE 0 := hP
  letI (i : ℤ) : Projective (P.X i) := hproj i
  have hmem := Unbounded.coprod_Q_obj_projective_of_isStrictlyLE_zero
    (shiftTail (ringObject A) 0) P
    (fun i hi => single_module_mem A (P.X i) i hi)
    (fun {_} h => coprod_shiftTail_shift_one (ringObject A) h)
  letI : IsIso (DerivedCategory.Q.map π) := by
    rw [DerivedCategory.isIso_Q_map_iff_quasiIso]
    infer_instance
  exact (Coprod (shiftTail (ringObject A) 0)).prop_of_iso
    (asIso (DerivedCategory.Q.map π)) hmem

/-- **The standard aisle is generated by the regular module.** -/
theorem standard_le_zero_eq_coprod (A : Type u) [CommRing A] :
    (AffineD.standardTStructure A).le 0 = Coprod (shiftTail (ringObject A) 0) := by
  apply le_antisymm
  · intro X hX
    change DerivedCategory.TStructure.t.le 0 X at hX
    let _ : X.IsLE 0 := (DerivedCategory.TStructure.t.le_iff_isLE X 0).mp hX
    obtain ⟨K, hK, ⟨e⟩⟩ := DerivedCategory.exists_iso_Q_obj_of_isLE X 0
    exact (Coprod (shiftTail (ringObject A) 0)).prop_of_iso e.symm
      (coprod_Q_obj_of_strictlyLE_zero A K)
  · exact standard_coprod_le A

end

