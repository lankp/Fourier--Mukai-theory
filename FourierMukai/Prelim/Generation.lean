import Mathlib.CategoryTheory.Triangulated.Generators
import Mathlib.CategoryTheory.Triangulated.Subcategory

/-!
# Generation in triangulated categories (paper, Section 2.1)

This file records how the generation apparatus of Section 2.1 of

  E. Guisado Villalgordo, P. Lank, *Relative Fourier--Mukai theory for algebraic spaces*

is realised by Mathlib's `ObjectProperty` API
(`Mathlib.CategoryTheory.Triangulated.Generators`).

Mathlib's `ObjectProperty.triangEnvelope P` is the smallest triangulated object
property closed under retracts and containing `P`; it plays the role of the
paper's `⟨S⟩`.  Mathlib's `triangEnvelopeIter P n` is the paper's `⟨S⟩_n`
(the inductive construction with `⟨S⟩_1 = add(S)`).

There are two small differences, recorded here so that they are not forgotten:

* Mathlib builds the envelope using *binary products* (which, in a pretriangulated
  category, coincide with binary coproducts), while the paper writes `add(S)` for
  the closure under finite coproducts;
* the paper's definition of `⟨S⟩_n` uses morphisms from `⟨S⟩_{n-1}` to `⟨S⟩_1`;
  Mathlib uses the standard inductive step (extensions of objects in `⟨S⟩_n`).
  The resulting closures agree (both are the thick closure of `S`), but the
  `⟨S⟩_n` filtrations are not obviously the same; see `results/REPORT.md`.

## Main definitions

* `RelativeFM.FinitelyBuiltBy`, `RelativeFM.IsClassicalGenerator`.

## Main results

* `RelativeFM.isClassicalGenerator_iff`.
-/

@[expose] public section

namespace RelativeFM

open CategoryTheory Limits

variable {C : Type*} [Category* C] [HasZeroObject C] [HasShift C ℤ] [Preadditive C]
  [∀ (n : ℤ), (shiftFunctor C n).Additive] [Pretriangulated C]

/-- The paper's `⟨S⟩`: the thick subcategory of `T` generated by `S`. -/
noncomputable abbrev thickClosure (P : ObjectProperty C) : ObjectProperty C := P.triangEnvelope

/-- `E` is finitely built by `S` (paper, Section 2.1): `E ∈ ⟨S⟩`. -/
def FinitelyBuiltBy (P : ObjectProperty C) (E : C) : Prop := P.triangEnvelope E

theorem finitelyBuiltBy_iff (P : ObjectProperty C) (E : C) :
    FinitelyBuiltBy P E ↔ P.triangEnvelope E := Iff.rfl

theorem FinitelyBuiltBy.mono {P Q : ObjectProperty C} (h : P ≤ Q) {E : C}
    (hE : FinitelyBuiltBy P E) : FinitelyBuiltBy Q E :=
  (P.monotone_triangEnvelope h) E hE

/-- `P` finitely builds every object, i.e. `⟨P⟩ = ⊤`. -/
def IsClassicalGenerator (P : ObjectProperty C) : Prop := P.IsClassicalTriangulatedGenerator

theorem isClassicalGenerator_iff (P : ObjectProperty C) :
    IsClassicalGenerator P ↔ P.triangEnvelope = ⊤ := Iff.rfl

end RelativeFM
